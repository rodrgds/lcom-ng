{
  "version": 1,
  "name": "Ninjix",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [],
      "joystick": false,
      "dpad": false,
      "look": false,
      "pointer": "move",
      "touch": "tap",
      "layout": "panel",
      "toolbar": "auto",
      "actions": [
        {
          "label": "Normal",
          "key": "1",
          "position": "bottom-left"
        },
        {
          "label": "Sniper",
          "key": "2",
          "position": "bottom-left"
        },
        {
          "label": "Smoke",
          "key": "3",
          "position": "bottom-left"
        },
        {
          "label": "Poison",
          "key": "4",
          "position": "bottom-left"
        },
        {
          "label": "Start",
          "key": "ENTER",
          "position": "top-right"
        },
        {
          "label": "Pause",
          "key": "ESC",
          "position": "top-right"
        },
        {
          "label": "Cancel",
          "mouseButton": "right",
          "position": "bottom-right"
        }
      ]
    },
    "theme": {
      "accent": "#f8cb59",
      "font": "sans"
    }
  },
  "icon": "../../collections/arcade/icons/ninjix.png",
  "preview": "preview.png",
  "description": "Place ninja defenders, upgrade their skills and protect the shrine from enemy waves.",
  "build": {
    "assets": []
  }
}
