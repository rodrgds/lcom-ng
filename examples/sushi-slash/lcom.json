{
  "version": 1,
  "name": "Sushi Slash",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "quickKeys": [],
      "joystick": false,
      "pointer": "direct",
      "layout": "overlay",
      "cursor": {
        "x": 400,
        "y": 300,
        "maxX": 800,
        "maxY": 600
      },
      "toolbar": "top-left",
      "actions": []
    },
    "theme": {
      "accent": "#ff977c",
      "font": "sans"
    }
  },
  "build": {
    "assetRoot": "..",
    "assets": [
      "proj/assets"
    ]
  }
}
