{
  "version": 1,
  "name": "Snake: Garden Trail",
  "description": "Eat fruit and guide your snake around the garden.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER",
        "P"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "overlay",
      "pointer": "off",
      "toolbar": "top-right",
      "pads": [
        {
          "side": "left",
          "mode": "arrows",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Start",
          "key": "ENTER",
          "position": "bottom-right"
        },
        {
          "label": "Pause",
          "key": "P",
          "position": "bottom-right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "archetype": "Snake",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Choose Play and press Enter to start. Eat fruit to grow while avoiding the walls and your own tail."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move up",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "W"
                ]
              }
            ]
          },
          {
            "action": "Move down",
            "bindings": [
              {
                "keys": [
                  "Down"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              }
            ]
          },
          {
            "action": "Move left",
            "bindings": [
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              }
            ]
          },
          {
            "action": "Move right",
            "bindings": [
              {
                "keys": [
                  "Right"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Start",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Pause or resume",
            "bindings": [
              {
                "keys": [
                  "P"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "label": "Direction pad"
              }
            ]
          },
          {
            "action": "Start",
            "bindings": [
              {
                "label": "Start button"
              }
            ]
          },
          {
            "action": "Pause or resume",
            "bindings": [
              {
                "label": "Pause button"
              }
            ]
          }
        ]
      },
      {
        "title": "Menus",
        "controls": [
          {
            "action": "Return to menu",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          },
          {
            "action": "Continue after game over",
            "bindings": [
              {
                "keys": [
                  "Q"
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
