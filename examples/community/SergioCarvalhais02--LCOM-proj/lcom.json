{
  "version": 1,
  "name": "Whack-a-Mole: Classic Board",
  "description": "Hit the original timed mole targets.",
  "mobile": {
    "orientation": "auto",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER",
        "0",
        "1",
        "2",
        "3"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "move",
      "toolbar": "top-right",
      "pads": [],
      "actions": [
        {
          "label": "Select / white",
          "mouseButton": "left",
          "position": "bottom-left"
        },
        {
          "label": "Yellow",
          "key": "W",
          "position": "bottom-right"
        },
        {
          "label": "Red",
          "key": "A",
          "position": "bottom-right"
        },
        {
          "label": "Green",
          "key": "S",
          "position": "bottom-right"
        },
        {
          "label": "Blue",
          "key": "D",
          "position": "bottom-right"
        }
      ],
      "repeatReleaseKeys": [
        "W",
        "A",
        "S",
        "D"
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "archetype": "Whack-a-Mole",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions": {
    "sections": [
      {
        "title": "Get started",
        "text": "Press 1, 2 or 3 to choose a display mode, then click Play. Hit the moles before the 30-second timer runs out; colored moles need their matching key."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Hit yellow mole",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              }
            ]
          },
          {
            "action": "Hit red mole",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              }
            ]
          },
          {
            "action": "Hit green mole",
            "bindings": [
              {
                "keys": [
                  "S"
                ]
              }
            ]
          },
          {
            "action": "Hit blue mole",
            "bindings": [
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Hit white mole",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ],
            "note": "A click also hits white moles."
          },
          {
            "action": "Return to menu",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Move cursor",
            "bindings": [
              {
                "label": "Move mouse"
              },
              {
                "label": "Drag"
              }
            ]
          },
          {
            "action": "Hit white or black mole, or choose menu",
            "bindings": [
              {
                "label": "Left click"
              },
              {
                "label": "Select button"
              }
            ],
            "note": "Colored moles ignore clicks; use their matching key."
          }
        ]
      },
      {
        "title": "Menus",
        "controls": [
          {
            "action": "Choose display mode",
            "bindings": [
              {
                "keys": [
                  "1"
                ]
              },
              {
                "keys": [
                  "2"
                ]
              },
              {
                "keys": [
                  "3"
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
