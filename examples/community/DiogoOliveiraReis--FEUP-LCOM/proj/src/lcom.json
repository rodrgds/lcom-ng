{
  "version": 1,
  "name": "Space Invaders: Reis",
  "description": "Slide your ship, dodge the aliens and shoot through their formation.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "layout": "overlay",
      "pointer": "off",
      "toolbar": "top-right",
      "actions": [
        {
          "label": "Play",
          "key": "P",
          "position": "top-right"
        },
        {
          "label": "Fire",
          "key": "SPACE",
          "position": "bottom-right"
        }
      ],
      "pads": [
        {
          "mode": "arrows",
          "side": "left",
          "style": "dpad",
          "axes": "horizontal"
        }
      ],
      "repeatKeys": [
        "SPACE"
      ]
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [
      "proj/src/db"
    ]
  },
  "archetype": "Space Invaders",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions": {
    "sections": [
      {
        "title": "Get started",
        "text": "Press P to launch a game. Slide your ship left and right, shoot the alien formation, and dodge their lasers."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Play",
            "bindings": [
              {
                "keys": [
                  "P"
                ]
              }
            ]
          },
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Fire",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ],
            "note": "One laser can be in flight at a time."
          },
          {
            "action": "End run or quit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "During a run, Esc ends the run; on the game-over screen it quits."
          }
        ]
      }
    ]
  }
}
