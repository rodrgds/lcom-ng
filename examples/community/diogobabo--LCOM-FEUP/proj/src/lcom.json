{
  "version": 1,
  "name": "Snake: Green Circuit",
  "description": "Steer the snake around the board and collect food.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER",
        "SPACE",
        "UP",
        "DOWN"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "move",
      "tapDuration": 80,
      "toolbar": "top-right",
      "pads": [
        {
          "side": "left",
          "mode": "arrows",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": [
      "leaderboard.txt"
    ],
    "pathAliases": {
      "/home/lcom/labs/g04/proj/src": "."
    }
  },
  "archetype": "Snake",
  "icon": "icon.png",
  "preview": "preview.png"
}
