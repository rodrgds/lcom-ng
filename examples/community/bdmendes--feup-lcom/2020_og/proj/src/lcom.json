{
  "version": 1,
  "name": "Lerbirinto",
  "description": "Explore the maze, read clues and defuse bombs to find the exit.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "layout": "overlay",
      "pointer": "direct",
      "toolbar": "top-right",
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ],
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad"
        }
      ],
      "touch": "tap",
      "tapDuration": 60,
      "cursor": {
        "x": 500,
        "y": 500,
        "maxX": 1151,
        "maxY": 863,
        "bounds": "reject"
      }
    }
  },
  "build": {
    "assetRoot": "../../..",
    "assets": []
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Start Game and explore the maze before the five-minute timer runs out. Defuse bombs and read clues to find the exit."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move up",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "W"
                ]
              }
            ]
          },
          {
            "action": "Move down",
            "bindings": [
              {
                "keys": [
                  "Down"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              }
            ]
          },
          {
            "action": "Move left",
            "bindings": [
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              }
            ]
          },
          {
            "action": "Move right",
            "bindings": [
              {
                "keys": [
                  "Right"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Return to menu",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Select or interact",
            "bindings": [
              {
                "label": "Left click"
              },
              {
                "label": "Tap"
              }
            ],
            "note": "Clicks menu buttons; in the maze, defuses bombs, opens clues, or walks to a tile."
          }
        ]
      }
    ]
  }
}
