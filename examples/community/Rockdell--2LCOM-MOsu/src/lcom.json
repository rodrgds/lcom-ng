{
  "version": 1,
  "name": "MOsu",
  "description": "Aim at shrinking circles and tap the matching letter in the original rhythm challenge.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "layout": "overlay",
      "pointer": "move",
      "toolbar": "top-right",
      "pads": [],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "top-right"
        },
        {
          "label": "Q",
          "key": "Q",
          "position": "bottom-left"
        },
        {
          "label": "W",
          "key": "W",
          "position": "bottom-left"
        },
        {
          "label": "E",
          "key": "E",
          "position": "bottom-right"
        },
        {
          "label": "R",
          "key": "R",
          "position": "bottom-right"
        }
      ],
      "joystick": false
    }
  },
  "build": {
    "assetRoot": "..",
    "assets": [
      "src/highscores.txt"
    ]
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions": {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play, then choose Easy or Hard. Move the pointer over a shrinking circle and press a key while it is inside the ring; waiting until the outer ring is small scores more."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Hit circle",
            "bindings": [
              {
                "keys": [
                  "Q"
                ]
              },
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "E"
                ]
              },
              {
                "keys": [
                  "R"
                ]
              }
            ],
            "note": "Hard mode: press the letter shown. In Easy any key works while the pointer is inside."
          },
          {
            "action": "Leave the menu or end the round",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Esc does not exit the game; use the Exit button to leave."
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Aim",
            "bindings": [
              {
                "label": "Move mouse"
              },
              {
                "label": "Swipe"
              }
            ]
          },
          {
            "action": "Select menu item",
            "bindings": [
              {
                "label": "Left click"
              },
              {
                "label": "Tap Select"
              }
            ]
          }
        ]
      }
    ]
  }
}
