{
  "version": 1,
  "name": "MinixOP",
  "description": "Explore textured first-person mazes, fight enemies and reach the exit portal.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "pointer": "move",
      "layout": "overlay",
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad"
        }
      ],
      "look": {
        "side": "right",
        "sensitivity": 1
      },
      "actions": [
        {
          "label": "Select / Fire",
          "mouseButton": "left",
          "position": "top-right"
        },
        {
          "label": "Weapons",
          "key": "Q",
          "position": "bottom-right"
        },
        {
          "label": "Sprint",
          "key": "LSHIFT",
          "position": "bottom-left"
        },
        {
          "label": "Pistol",
          "key": "2",
          "position": "bottom-right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [
      "proj/data/maps"
    ],
    "pathAliases": {
      "/home/lcom/labs/minixop": "proj"
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Singleplayer, then move through the maze and reach the exit portal. Move with WASD, look with the mouse and fire with the left button."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move and strafe",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Sprint",
            "bindings": [
              {
                "keys": [
                  "Shift"
                ]
              }
            ],
            "note": "Hold."
          },
          {
            "action": "Crouch",
            "bindings": [
              {
                "keys": [
                  "Ctrl"
                ]
              }
            ],
            "note": "Hold."
          },
          {
            "action": "Weapons",
            "bindings": [
              {
                "keys": [
                  "Q"
                ]
              }
            ],
            "note": "Hold to show the inventory."
          },
          {
            "action": "Select weapon",
            "bindings": [
              {
                "keys": [
                  "1"
                ]
              },
              {
                "keys": [
                  "2"
                ]
              },
              {
                "keys": [
                  "3"
                ]
              }
            ],
            "note": "1 Minigun, 2 Service Pistol, 3 BLMG 5100."
          },
          {
            "action": "Quit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Look",
            "bindings": [
              {
                "label": "Move mouse"
              },
              {
                "label": "Drag right side"
              }
            ]
          },
          {
            "action": "Fire",
            "bindings": [
              {
                "label": "Left click"
              },
              {
                "label": "Tap Select / Fire"
              }
            ],
            "note": "Hold for automatic fire."
          }
        ]
      },
      {
        "title": "Touch",
        "controls": [
          {
            "action": "Move and strafe",
            "bindings": [
              {
                "label": "Left pad"
              }
            ]
          },
          {
            "action": "Weapons",
            "bindings": [
              {
                "label": "Hold Weapons"
              }
            ]
          },
          {
            "action": "Sprint",
            "bindings": [
              {
                "label": "Hold Sprint"
              }
            ]
          },
          {
            "action": "Select pistol",
            "bindings": [
              {
                "label": "Tap Pistol"
              }
            ]
          }
        ]
      }
    ]
  }
}
