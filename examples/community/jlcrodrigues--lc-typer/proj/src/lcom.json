{
  "version": 1,
  "name": "LC Typer",
  "description": "Type the original practice phrases and improve your typing speed.",
  "build": {
    "assetRoot": ".",
    "assets": [
      "assets"
    ],
    "pathAliases": {
      "/home/lcom/labs/proj/src": "."
    }
  },
  "mobile": {
    "orientation": "auto",
    "fullscreen": false,
    "controls": {
      "layout": "panel",
      "keyboard": true,
      "mouseButtons": false,
      "joystick": false,
      "dpad": false,
      "look": false,
      "pointer": "move",
      "quickKeys": [
        "ESC",
        "ENTER",
        "TAB",
        "BACKSPACE"
      ],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "side": "right"
        }
      ]
    }
  },
  "archetype": "Typing",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Start and type the phrase shown on screen. Finish it to see your speed and accuracy."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Fix a typo",
            "bindings": [
              {
                "keys": [
                  "Backspace"
                ]
              }
            ]
          },
          {
            "action": "Restart phrase",
            "bindings": [
              {
                "keys": [
                  "Tab"
                ]
              }
            ]
          },
          {
            "action": "New phrase",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Back to menu",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Choose menu item",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          },
          {
            "action": "Leave game",
            "bindings": [
              {
                "label": "Click x"
              }
            ],
            "note": "Top-right button."
          },
          {
            "action": "Next phrase",
            "bindings": [
              {
                "label": "Click n"
              }
            ],
            "note": "Top-right button."
          }
        ]
      }
    ]
  }
}
