{
  "version": 1,
  "name": "Knight Quest",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [],
      "joystick": false,
      "dpad": {
        "side": "left",
        "keys": "wasd",
        "axes": "horizontal"
      },
      "layout": "overlay",
      "pointer": "direct",
      "cursor": {
        "x": 400,
        "y": 300,
        "minX": 1,
        "minY": 1,
        "maxX": 799,
        "maxY": 599,
        "bounds": "reject"
      },
      "touch": "tap",
      "actions": [
        {
          "position": "bottom-right",
          "label": "Jump",
          "key": "SPACE"
        },
        {
          "position": "bottom-right",
          "label": "Slash",
          "mouseButton": "left"
        },
        {
          "position": "bottom-right",
          "label": "Blast",
          "mouseButton": "right"
        },
        {
          "position": "top-right",
          "label": "Menu up",
          "key": "W"
        },
        {
          "position": "top-right",
          "label": "Menu down",
          "key": "S"
        },
        {
          "position": "top-right",
          "label": "Select",
          "key": "ENTER"
        },
        {
          "position": "top-right",
          "label": "Esc",
          "key": "ESC"
        }
      ],
      "toolbar": "top-left",
      "touchClick": false
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": []
  },
  "description": "Jump through dark caverns and fight your way forward with sword and magic.",
  "preview": "../../../../../collections/arcade/previews/antoniocrego-lcom-t01-g3-c70a27f473d7.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Press Enter to start from the menu. Move with A and D, jump with Space, and attack toward the cursor."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Jump",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ],
            "note": "Press again in mid-air after picking up double jump."
          },
          {
            "action": "Pause or resume",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Menus",
        "controls": [
          {
            "action": "Choose a menu item",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              }
            ],
            "note": "W and S switch between the two menu options, and move through the pause menu."
          },
          {
            "action": "Confirm",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Slash",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          },
          {
            "action": "Blast",
            "bindings": [
              {
                "label": "Right click"
              }
            ],
            "note": "Requires the soul blast power-up."
          }
        ]
      }
    ]
  }
}
