{
  "version": 1,
  "name": "Snake: Dodge the Fruit",
  "description": "Guide your snake through a field of falling fruit.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "layout": "overlay",
      "pointer": "direct",
      "toolbar": "top-right",
      "actions": [],
      "pads": [
        {
          "mode": "arrows",
          "side": "left",
          "style": "dpad"
        }
      ],
      "touch": "tap",
      "tapDuration": 60,
      "cursor": {
        "x": 625,
        "y": 550,
        "maxX": 1228,
        "maxY": 945
      }
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [
      "proj/src/leaderboard_scores.txt"
    ],
    "environment": {
      "LCOM_COMPAT_MOUSE_REPORTING": "1"
    }
  },
  "archetype": "Snake",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play, then press an arrow key to start moving. Steer through the fruit and avoid the walls and your own tail."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Turn",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              },
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ],
            "note": "You cannot reverse direction."
          },
          {
            "action": "Type name",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              }
            ],
            "note": "Use letter keys after a game over; Backspace deletes."
          },
          {
            "action": "Save score",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Back to menu",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Choose menu item",
            "bindings": [
              {
                "label": "Left click or tap"
              }
            ]
          }
        ]
      }
    ]
  }
}
