{
  "version": 1,
  "name": "Getaway Car",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [],
      "joystick": false,
      "pointer": "move",
      "layout": "overlay",
      "dpad": {
        "keys": "arrows",
        "side": "right",
        "axes": "horizontal"
      },
      "touch": "move",
      "actions": [
        {
          "position": "bottom-left",
          "label": "P1 Left",
          "key": "A"
        },
        {
          "position": "bottom-left",
          "label": "P1 Right",
          "key": "D"
        },
        {
          "position": "bottom-right",
          "label": "P2 Left",
          "mouseButton": "left"
        },
        {
          "position": "bottom-right",
          "label": "P2 Right",
          "mouseButton": "right"
        },
        {
          "position": "top-right",
          "label": "Menu up",
          "key": "UP"
        },
        {
          "position": "top-right",
          "label": "Menu down",
          "key": "DOWN"
        },
        {
          "position": "top-right",
          "label": "Select",
          "key": "ENTER"
        },
        {
          "position": "top-right",
          "label": "Esc",
          "key": "ESC"
        }
      ],
      "toolbar": "top-left"
    }
  },
  "build": {
    "assetRoot": "..",
    "assets": []
  },
  "description": "Steer through traffic and dodge obstacles. Share the road with a second player.",
  "preview": "../../../../collections/arcade/previews/dab1d-getawaycar-a7df638127d0.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Choose Start, pick both cars, a track and a race mode. Dodge traffic and reach the finish ahead of your rival."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Steer player 1",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              },
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "Move in menus",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Confirm",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Pause or back",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Steer player 2 left",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          },
          {
            "action": "Steer player 2 right",
            "bindings": [
              {
                "label": "Right click"
              }
            ]
          },
          {
            "action": "Choose a menu option",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
