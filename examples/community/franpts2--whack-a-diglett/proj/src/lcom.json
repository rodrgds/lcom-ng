{
  "version": 1,
  "name": "Whack\u2019a Diglett",
  "description": "React quickly and whack the emerging Diglett before they hide.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER",
        "UP",
        "DOWN",
        "P",
        "Q",
        "R",
        "T",
        "Y",
        "F",
        "G",
        "H",
        "V",
        "B",
        "N"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "overlay",
      "pointer": "move",
      "toolbar": "top-right",
      "pads": [],
      "actions": [
        {
          "label": "Start / Select",
          "key": "ENTER",
          "position": "bottom-right"
        }
      ],
      "tapDuration": 80
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "archetype": "Whack-a-Mole",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Press Enter to start. Whack each Diglett with the key shown on it before it hides."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Choose menu option",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Start / confirm",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Hit top-row Diglett",
            "bindings": [
              {
                "keys": [
                  "R"
                ]
              },
              {
                "keys": [
                  "T"
                ]
              },
              {
                "keys": [
                  "Y"
                ]
              }
            ]
          },
          {
            "action": "Hit middle-row Diglett",
            "bindings": [
              {
                "keys": [
                  "F"
                ]
              },
              {
                "keys": [
                  "G"
                ]
              },
              {
                "keys": [
                  "H"
                ]
              }
            ]
          },
          {
            "action": "Hit bottom-row Diglett",
            "bindings": [
              {
                "keys": [
                  "V"
                ]
              },
              {
                "keys": [
                  "B"
                ]
              },
              {
                "keys": [
                  "N"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Pause & exit",
        "controls": [
          {
            "action": "Pause / resume",
            "bindings": [
              {
                "keys": [
                  "P"
                ]
              }
            ]
          },
          {
            "action": "Quit to menu",
            "bindings": [
              {
                "keys": [
                  "Q"
                ]
              }
            ]
          },
          {
            "action": "Exit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Choose menu option",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
