{
  "version": 1,
  "name": "Memory Match",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "dpad": false,
      "layout": "overlay",
      "pointer": "drag",
      "touch": "tap",
      "toolbar": "top-right",
      "actions": [
        {
          "label": "Play",
          "position": "top-left",
          "key": "P"
        },
        {
          "label": "Instructions",
          "position": "top-left",
          "key": "I"
        },
        {
          "label": "Exit",
          "position": "top-left",
          "key": "E"
        },
        {
          "label": "Flip",
          "position": "bottom-right",
          "mouseButton": "left"
        }
      ],
      "tapDuration": 60,
      "touchClick": false,
      "cursor": {
        "x": 0,
        "y": 0,
        "maxX": 799,
        "maxY": 599,
        "desktopScale": 0.5
      }
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [],
    "pathAliases": {
      "/home/lcom/labs/g02": "."
    }
  },
  "description": "Turn over the cards and remember what you saw. Find each matching pair.",
  "preview": "../../../../../collections/arcade/previews/iamaccosta-feup-lcom-8eb08d543062.png",
  "archetype": "Memory"
}
