{
  "version": 1,
  "name": "Tennis for Two",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER",
        "UP",
        "DOWN"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "overlay",
      "pointer": "move",
      "toolbar": "top-right",
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Hit / Serve",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "description": "Serve and rally against a computer opponent on a pixel-art tennis court.",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "On the start menu, press Down to highlight Play and Enter to open the court. First player to 10 points wins."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              },
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "Pause",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "During a match."
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Serve or hit",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          },
          {
            "action": "Choose menu item",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      },
      {
        "title": "Menus",
        "controls": [
          {
            "action": "Highlight option",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Confirm",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
