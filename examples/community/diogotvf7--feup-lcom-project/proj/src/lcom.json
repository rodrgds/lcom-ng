{
  "version": 1,
  "name": "Sketch and Guess",
  "description": "Draw the original prompts and play a guessing round.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "quickKeys": [
        "0",
        "1",
        "2",
        "4",
        "ENTER",
        "BACKSPACE"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "move",
      "tapDuration": 80,
      "toolbar": "top-right",
      "pads": [],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": [
      "model/test.txt"
    ],
    "pathAliases": {
      "/home/lcom/labs/g1/proj/src": "."
    }
  },
  "icon": "icon.png",
  "preview": "preview.png"
}
