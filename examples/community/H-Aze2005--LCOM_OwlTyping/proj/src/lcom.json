{
  "version": 1,
  "name": "Owl Type",
  "description": "Type a passage against the clock.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "BACKSPACE"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "overlay",
      "pointer": "move",
      "toolbar": "top-right",
      "pads": [],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ],
      "tapDuration": 65
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "archetype": "Typing",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Choose a 30, 60, or 120 second limit, then press Enter or click Start. Type the passage exactly, using Space for each underscore."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Choose time limit",
            "bindings": [
              {
                "keys": [
                  "1"
                ]
              },
              {
                "keys": [
                  "2"
                ]
              },
              {
                "keys": [
                  "3"
                ]
              }
            ]
          },
          {
            "action": "Start or resume",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Type a word separator",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ],
            "note": "Each Space enters the underscore shown between words."
          },
          {
            "action": "Pause",
            "bindings": [
              {
                "keys": [
                  "."
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Select buttons",
            "bindings": [
              {
                "label": "Left click"
              },
              {
                "label": "Select button"
              }
            ],
            "note": "The top-right button pauses during a test."
          }
        ]
      },
      {
        "title": "Menus",
        "controls": [
          {
            "action": "Back to the title screen",
            "bindings": [
              {
                "keys": [
                  "Backspace"
                ]
              }
            ]
          },
          {
            "action": "Exit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
