{
  "version": 1,
  "name": "Pixel Wings",
  "description": "Fly a pixel dragon, breathe fire and weave through columns of bats.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "layout": "overlay",
      "keyboard": true,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "pointer": "move",
      "touch": "tap",
      "pads": [
        {
          "side": "left",
          "mode": "mouse",
          "style": "stick",
          "axes": "vertical",
          "sensitivity": 1
        }
      ],
      "actions": [
        {
          "label": "Select / Fire",
          "mouseButton": "left",
          "position": "bottom-right"
        },
        {
          "label": "Power",
          "key": "SPACE",
          "position": "top-right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [
      "proj/bitmaps",
      "proj/src/scores.txt"
    ],
    "pathAliases": {
      "/home/lcom/proj": "proj"
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions": {
    "sections": [
      {
        "title": "Get started",
        "text": "Wait for the intro, then click Play on the menu. Fly through the columns of bats and breathe fire to clear them."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Pause",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Choose Resume in the pause menu."
          },
          {
            "action": "Power shot",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ],
            "note": "Hold Space while left-clicking."
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Fly up or down",
            "bindings": [
              {
                "label": "Move mouse or drag vertically"
              }
            ]
          },
          {
            "action": "Fire",
            "bindings": [
              {
                "label": "Left click or hold"
              }
            ]
          },
          {
            "action": "Choose menu item",
            "bindings": [
              {
                "label": "Left click or tap"
              }
            ]
          }
        ]
      }
    ]
  }
}
