{
  "version": 1,
  "name": "Space Shooter",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [],
      "joystick": false,
      "layout": "overlay",
      "pointer": "drag",
      "dpad": {
        "keys": "wasd",
        "side": "left",
        "axes": "horizontal"
      },
      "toolbar": "top-left",
      "repeatKeys": [
        "A",
        "D"
      ],
      "actions": [
        {
          "position": "top-right",
          "label": "Esc",
          "key": "ESC"
        }
      ],
      "cursor": {
        "x": 0,
        "y": 0,
        "maxX": 1132,
        "maxY": 844,
        "desktopScale": 1
      }
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [],
    "environment": {
      "LCOM_COMPAT_MOUSE_REPORTING": "1"
    }
  },
  "description": "Weave through space and keep your ship clear of enemy fire.",
  "preview": "../../../../../collections/arcade/previews/samblack569-feup-lcom-2425-c1eb853acae2.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play to launch. Your ship fires automatically, so focus on dodging asteroids."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move left",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              }
            ]
          },
          {
            "action": "Move right",
            "bindings": [
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Return to menu",
            "bindings": [
              {
                "keys": [
                  "M"
                ]
              }
            ],
            "note": "Works on the help and game over screens."
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Choose menu option",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
