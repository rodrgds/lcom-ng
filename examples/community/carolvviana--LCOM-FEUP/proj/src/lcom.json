{
  "version": 1,
  "name": "Neon Pong",
  "description": "Keep the neon ball in play and beat your opponent.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER",
        "UP",
        "DOWN"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "overlay",
      "pointer": "move",
      "toolbar": "top-right",
      "pads": [
        {
          "side": "left",
          "mode": "arrows",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Select",
          "key": "ENTER",
          "position": "bottom-right"
        }
      ],
      "repeatKeys": [
        "UP",
        "DOWN",
        "LEFT",
        "RIGHT"
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "archetype": "Pong",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Choose Singleplayer with Up and Down, then press Enter. Keep the ball in play and beat your opponent."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move / choose menu option",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              },
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ],
            "note": "Up and Down also move the menu selection."
          },
          {
            "action": "Start",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Back to menu",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Choose menu option",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          },
          {
            "action": "Speed boost",
            "bindings": [
              {
                "label": "Left click"
              }
            ],
            "note": "In a match. Has a long cooldown."
          },
          {
            "action": "Grow paddle",
            "bindings": [
              {
                "label": "Right click"
              }
            ],
            "note": "In a match. Has a long cooldown."
          }
        ]
      }
    ]
  }
}
