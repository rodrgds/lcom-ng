{
  "version": 1,
  "name": "HawkType",
  "description": "Practice typing in English, Portuguese and Spanish.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "BACKSPACE",
        "1",
        "2",
        "3",
        "4",
        "5",
        "6"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "off",
      "tapDuration": 80,
      "toolbar": "top-right",
      "pads": [],
      "actions": [
        {
          "label": "Submit / Start",
          "key": "SPACE",
          "position": "bottom-right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "archetype": "Typing",
  "icon": "icon.png",
  "preview": "preview.png"
}
