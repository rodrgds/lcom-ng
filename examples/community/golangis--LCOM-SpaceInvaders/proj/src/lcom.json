{
  "version": 1,
  "name": "Space Invaders: Galactic Defense",
  "description": "Defend Earth from descending alien formations.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "overlay",
      "pointer": "move",
      "toolbar": "top-right",
      "pads": [
        {
          "side": "left",
          "mode": "arrows",
          "style": "dpad",
          "axes": "horizontal"
        }
      ],
      "actions": [
        {
          "label": "Fire",
          "key": "SPACE",
          "position": "bottom-right"
        },
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "top-right"
        }
      ],
      "repeatKeys": [],
      "repeatReleaseKeys": [
        "LEFT",
        "RIGHT",
        "SPACE"
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": [
      "highscores.csv"
    ],
    "pathAliases": {
      "/home/lcom/labs/proj/src": ".",
      "/home/lcom/labs/g3/proj/src": "."
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "archetype": "Space Invaders",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play or press Space to start. Move with Left and Right and fire with Space or Up; stop each formation before it lands."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Start or fire",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              },
              {
                "keys": [
                  "Up"
                ]
              }
            ],
            "note": "Up only fires; Space also starts a round from the menu."
          },
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "Return to menu",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Move ship",
            "bindings": [
              {
                "label": "Move mouse left or right"
              }
            ]
          },
          {
            "action": "Choose a menu button",
            "bindings": [
              {
                "label": "Left click"
              }
            ],
            "note": "Covers Play, Rankings, Replay and Menu."
          }
        ]
      }
    ]
  }
}
