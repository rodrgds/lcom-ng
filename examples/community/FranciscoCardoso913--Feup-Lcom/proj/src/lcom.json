{
  "version": 1,
  "name": "Fireboy and Watergirl: Falling Blocks",
  "description": "Guide both characters through the original platform course.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER",
        "SPACE",
        "UP",
        "DOWN"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "move",
      "tapDuration": 80,
      "toolbar": "top-right",
      "pads": [
        {
          "side": "left",
          "mode": "wasd",
          "style": "dpad"
        },
        {
          "side": "right",
          "mode": "arrows",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": [
      "maps/map1.txt",
      "maps/map2.txt",
      "maps/map3.txt"
    ],
    "arguments": [
      "1"
    ],
    "pathAliases": {
      "/home/lcom/labs/shared/proj/src": "."
    }
  },
  "icon": "icon.png",
  "preview": "preview.png"
}
