{
  "version": 1,
  "name": "Fireboy and Watergirl: Falling Blocks",
  "description": "Guide both characters through the original platform course.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER",
        "SPACE",
        "UP",
        "DOWN"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "move",
      "tapDuration": 80,
      "toolbar": "top-right",
      "pads": [
        {
          "side": "left",
          "mode": "wasd",
          "style": "dpad"
        },
        {
          "side": "right",
          "mode": "arrows",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": [
      "maps/map1.txt",
      "maps/map2.txt",
      "maps/map3.txt"
    ],
    "arguments": [
      "1"
    ],
    "pathAliases": {
      "/home/lcom/labs/shared/proj/src": "."
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions": {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Single Player, then guide both characters to the exit. Fireboy moves with A and D and jumps with W; Watergirl uses the arrow keys."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move Fireboy",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Jump Fireboy",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              }
            ]
          },
          {
            "action": "Move Watergirl",
            "bindings": [
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "Jump Watergirl",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              }
            ]
          },
          {
            "action": "Pause",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Esc also backs out of menus."
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Choose menu item",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          },
          {
            "action": "Cut rope",
            "bindings": [
              {
                "label": "Left click"
              }
            ],
            "note": "Click a rope in the level."
          }
        ]
      }
    ]
  }
}
