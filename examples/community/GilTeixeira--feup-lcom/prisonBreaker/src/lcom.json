{
  "version": 1,
  "name": "Prison Breaker",
  "description": "React to the direction on screen and escape its changing instructions before time runs out.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "layout": "overlay",
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "pointer": "off",
      "joystick": false,
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Play / Retry",
          "key": "ENTER",
          "position": "bottom-right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [
      "prisonBreaker/res"
    ],
    "pathAliases": {
      "/home/lcom/lcom1718-t6g08/prisonBreaker": "prisonBreaker"
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions": {
    "sections": [
      {
        "title": "Get started",
        "text": "Press Enter to start the run. Answer the direction shown on screen before the timer empties; one wrong answer ends the round."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Answer direction",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Start or retry",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Exit or back",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "From the main menu it exits; on the lose screen it returns to the menu."
          }
        ]
      }
    ]
  }
}
