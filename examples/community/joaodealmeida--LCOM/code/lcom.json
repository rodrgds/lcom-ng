{
  "version": 1,
  "name": "Shark Patrol",
  "description": "Steer the boat, aim the crosshair and shoot approaching sharks.",
  "build": {
    "cStandard": "gnu89"
  },
  "mobile": {
    "orientation": "auto",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "move",
      "touchClick": false,
      "quickKeys": [
        "ESC"
      ],
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "stick"
        },
        {
          "mode": "mouse",
          "side": "right",
          "style": "stick",
          "sensitivity": 1
        }
      ],
      "actions": [
        {
          "label": "Shoot / Select",
          "mouseButton": "left",
          "position": "top-right"
        }
      ],
      "tapDuration": 250
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions": {
    "sections": [
      {
        "title": "Get started",
        "text": "Steer the boat with A, D, W and S. Aim with the mouse and left-click to fire at approaching sharks."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move boat",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Quit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Aim",
            "bindings": [
              {
                "label": "Move mouse"
              }
            ]
          },
          {
            "action": "Fire",
            "bindings": [
              {
                "label": "Left click"
              }
            ],
            "note": "Press to fire."
          },
          {
            "action": "Restart or quit",
            "bindings": [
              {
                "label": "Left click"
              }
            ],
            "note": "Click a button on the game-over screen."
          }
        ]
      }
    ]
  }
}
