{
  "name": "Pong: Mouse and Arrows",
  "build": {
    "sources": [
      "draw.c",
      "entity.c",
      "game_state.c",
      "graphic.c",
      "interrupt_manager.c",
      "kbd.c",
      "kbd_event_handler.c",
      "main.c",
      "mouse.c",
      "mouse_event_handler.c",
      "timer.c",
      "timer_event_handler.c",
      "ui.c",
      "utils.c"
    ],
    "include": [
      "xpm"
    ],
    "assets": []
  },
  "mobile": {
    "fullscreen": false,
    "controls": {
      "layout": "panel",
      "keyboard": false,
      "pointer": "move",
      "mouseButtons": false,
      "joystick": false,
      "dpad": false,
      "look": false,
      "pads": [
        {
          "side": "left",
          "mode": "arrows",
          "style": "dpad",
          "axes": "vertical"
        }
      ],
      "repeatKeys": [
        "UP",
        "DOWN"
      ],
      "quickKeys": [
        "ESC"
      ],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ]
    },
    "orientation": "auto"
  },
  "description": "Move one paddle with the arrows and the other with the mouse in this two-player Pong.",
  "archetype": "Pong",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play to start. The left paddle uses the arrow keys and the right paddle follows vertical mouse or touch movement."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move left paddle",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Exit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Returns from the instructions screen; during play it exits."
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Move right paddle",
            "bindings": [
              {
                "label": "Move the mouse or drag vertically"
              }
            ]
          },
          {
            "action": "Choose menu item",
            "bindings": [
              {
                "label": "Left click or tap"
              }
            ],
            "note": "Point at Play, Instructions or Quit first."
          }
        ]
      }
    ]
  }
}
