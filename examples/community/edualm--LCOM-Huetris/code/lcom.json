{
  "version": 1,
  "name": "HUEtris",
  "archetype": "Tetris",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "1",
        "2"
      ],
      "joystick": false,
      "look": false,
      "dpad": false,
      "layout": "panel",
      "pointer": "off",
      "toolbar": "top-right",
      "pads": [
        {
          "mode": "arrows",
          "side": "left",
          "style": "dpad"
        },
        {
          "mode": "mouse",
          "side": "right",
          "style": "stick"
        }
      ],
      "actions": [
        {
          "label": "Drop",
          "key": "SPACE",
          "position": "bottom-left"
        },
        {
          "label": "P2 Left",
          "mouseButton": "left",
          "position": "top-left"
        },
        {
          "label": "P2 Right",
          "mouseButton": "right",
          "position": "top-right"
        },
        {
          "label": "P2 Rotate",
          "mouseButton": "middle",
          "position": "bottom-right"
        }
      ],
      "repeatKeys": [
        "LEFT",
        "RIGHT",
        "DOWN"
      ]
    }
  },
  "build": {
    "assets": [],
    "environment": {
      "LCOM_VBE_PHYSICAL_BASE": "0xF0000000"
    }
  },
  "description": "Drop colorful pieces, clear lines and race a friend on a second board.",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Press 1 for a solo game or 2 for a two-player game. Clear complete lines before the stack reaches the top."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "Rotate",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              }
            ]
          },
          {
            "action": "Soft drop",
            "bindings": [
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Hard drop",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ]
          },
          {
            "action": "Quit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Ends the game immediately."
          }
        ]
      },
      {
        "title": "Player 2 mouse",
        "text": "In a two-player game, player two uses the mouse.",
        "controls": [
          {
            "action": "Move left",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          },
          {
            "action": "Move right",
            "bindings": [
              {
                "label": "Right click"
              }
            ]
          },
          {
            "action": "Rotate",
            "bindings": [
              {
                "label": "Middle click"
              }
            ]
          },
          {
            "action": "Hard drop",
            "bindings": [
              {
                "label": "Move the mouse down"
              }
            ]
          }
        ]
      }
    ]
  }
}
