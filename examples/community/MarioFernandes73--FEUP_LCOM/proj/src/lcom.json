{
  "version": 1,
  "name": "Simon Says",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "overlay",
      "pointer": "direct",
      "toolbar": "top-right",
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad"
        }
      ],
      "actions": [],
      "touch": "tap",
      "cursor": {
        "x": 20,
        "y": 20,
        "maxX": 786,
        "maxY": 578
      }
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [
      "proj/src/images"
    ],
    "pathAliases": {
      "/home/lcom/lcom1617-t4g03": "."
    },
    "arguments": [
      "simonsays"
    ]
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "description": "Build and repeat a growing sequence of shapes with a friend.",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click START. Player 1 builds a sequence, then Player 2 repeats it from memory."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Enter a key move",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ],
            "note": "Adds that key to the sequence."
          },
          {
            "action": "Quit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Choose START or EXIT",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          },
          {
            "action": "Choose a shape",
            "bindings": [
              {
                "label": "Left click"
              }
            ],
            "note": "Click the square, triangle, circle or star during a turn."
          },
          {
            "action": "Enter a slope",
            "bindings": [
              {
                "label": "Hold right click + drag up or down"
              }
            ],
            "note": "Drag far enough to enter an ascending or descending slope."
          }
        ]
      }
    ]
  }
}
