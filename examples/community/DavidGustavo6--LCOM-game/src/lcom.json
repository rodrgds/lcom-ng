{
  "version": 1,
  "name": "Minix Tower Defense",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "P",
        "O",
        "L",
        "Q"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "direct",
      "toolbar": "top-right",
      "pads": [],
      "actions": [
        {
          "label": "Upgrade",
          "key": "U",
          "position": "bottom-right"
        },
        {
          "label": "Archer",
          "key": "A",
          "position": "bottom-right"
        },
        {
          "label": "Cannon",
          "key": "C",
          "position": "bottom-right"
        }
      ],
      "touch": "tap",
      "tapDuration": 60,
      "cursor": {
        "x": 5,
        "y": 5,
        "maxX": 800,
        "maxY": 600
      }
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": [],
    "environment": {
      "LCOM_COMPAT_MOUSE_REPORTING": "1"
    }
  },
  "description": "Build and upgrade towers to stop waves of skeletons, orcs and golems.",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Press P or click Play, then hover a tower slot and buy a tower before the enemies arrive. Stop every wave of skeletons, orcs and golems."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Select tower slot",
            "bindings": [
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "Build archer tower",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              }
            ],
            "note": "Costs 50 coins."
          },
          {
            "action": "Build mage tower",
            "bindings": [
              {
                "keys": [
                  "M"
                ]
              }
            ],
            "note": "Costs 150 coins."
          },
          {
            "action": "Build cannon tower",
            "bindings": [
              {
                "keys": [
                  "C"
                ]
              }
            ],
            "note": "Costs 100 coins."
          },
          {
            "action": "Upgrade selected tower",
            "bindings": [
              {
                "keys": [
                  "U"
                ]
              }
            ],
            "note": "Costs 300 coins."
          },
          {
            "action": "Back to menu",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Select tower slot",
            "bindings": [
              {
                "label": "Hover a tower position"
              }
            ]
          },
          {
            "action": "Choose menu item",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      },
      {
        "title": "Menus",
        "controls": [
          {
            "action": "Leaderboard",
            "bindings": [
              {
                "keys": [
                  "L"
                ]
              }
            ],
            "note": "From the main menu."
          },
          {
            "action": "Options",
            "bindings": [
              {
                "keys": [
                  "O"
                ]
              }
            ],
            "note": "From the main menu."
          },
          {
            "action": "Quit",
            "bindings": [
              {
                "keys": [
                  "Q"
                ]
              }
            ],
            "note": "From the main menu or leaderboard."
          }
        ]
      }
    ]
  }
}
