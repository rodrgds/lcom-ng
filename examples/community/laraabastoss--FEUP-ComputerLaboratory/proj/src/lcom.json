{
  "version": 1,
  "name": "Fireboy & Watergirl",
  "description": "Guide both heroes through three original platform puzzle levels.",
  "build": {
    "assetRoot": ".",
    "assets": [
      "levels"
    ],
    "pathAliases": {
      "/home/lcom/labs/proj/src": "."
    }
  },
  "mobile": {
    "orientation": "auto",
    "fullscreen": false,
    "controls": {
      "layout": "panel",
      "keyboard": false,
      "mouseButtons": false,
      "joystick": false,
      "dpad": false,
      "look": false,
      "pointer": "move",
      "quickKeys": [
        "ESC"
      ],
      "pads": [
        {
          "side": "left",
          "mode": "wasd",
          "style": "dpad"
        },
        {
          "side": "right",
          "mode": "arrows",
          "style": "dpad"
        }
      ],
      "repeatKeys": [
        "A",
        "D",
        "LEFT",
        "RIGHT"
      ],
      "actions": [
        {
          "label": "Select / Lever",
          "mouseButton": "left",
          "side": "right"
        }
      ]
    }
  },
  "archetype": "Fireboy and Watergirl",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Single Player to begin. Guide Fireboy and Watergirl to the exits; each hero moves and jumps separately."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move Fireboy",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Jump Fireboy",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              }
            ]
          },
          {
            "action": "Move Watergirl",
            "bindings": [
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "Jump Watergirl",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              }
            ]
          },
          {
            "action": "Exit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Select or push lever",
            "bindings": [
              {
                "label": "Left click"
              }
            ],
            "note": "Chooses the start option or moves a lever while the cursor crosses it."
          }
        ]
      }
    ]
  }
}
