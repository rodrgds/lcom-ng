{
  "version": 1,
  "name": "Space Invaders: Alien Waves",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [],
      "joystick": false,
      "pointer": "move",
      "layout": "overlay",
      "touch": "tap",
      "actions": [
        {
          "position": "bottom-right",
          "label": "Fire",
          "key": "SPACE"
        },
        {
          "position": "bottom-right",
          "label": "Select",
          "mouseButton": "left"
        },
        {
          "position": "top-right",
          "label": "Esc",
          "key": "ESC"
        }
      ],
      "toolbar": "top-left",
      "dpad": {
        "side": "left",
        "keys": "wasd",
        "axes": "horizontal"
      }
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": []
  },
  "description": "Dodge the falling shots and shoot your way through the alien waves.",
  "preview": "../../../../../collections/arcade/previews/hugo-mgs-lcom-space-invaders-5c534d6f57b3.png",
  "archetype": "Space Invaders",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play in the menu to start. Clear every alien wave and dodge the shots falling toward your ship."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move / choose menu option",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ],
            "note": "A and D also switch between Play and Quit after a game ends."
          },
          {
            "action": "Fire / confirm",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ],
            "note": "Confirms the selected option on the game-over screen."
          },
          {
            "action": "Exit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Choose a menu item",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
