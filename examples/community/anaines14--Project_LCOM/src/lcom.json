{
  "version": 1,
  "name": "Desktop Defender",
  "description": "Protect the original virtual desktop from advancing bugs with pointer-fired missiles.",
  "mobile": {
    "orientation": "auto",
    "fullscreen": true,
    "controls": {
      "layout": "panel",
      "keyboard": false,
      "pointer": "move",
      "touchClick": false,
      "mouseButtons": false,
      "joystick": false,
      "quickKeys": [
        "ESC"
      ],
      "pads": [
        {
          "mode": "mouse",
          "side": "right",
          "style": "stick"
        }
      ],
      "actions": [
        {
          "label": "Login",
          "key": "ENTER",
          "position": "top-left"
        },
        {
          "label": "Fire",
          "mouseButton": "left",
          "position": "bottom-left"
        },
        {
          "label": "Nuke",
          "key": "Z",
          "position": "top-right"
        },
        {
          "label": "Antivirus",
          "key": "X",
          "position": "bottom-right"
        }
      ]
    }
  },
  "build": {
    "assets": []
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Press Enter to log in. Aim with the mouse and click bugs to fire missiles while collecting coins for abilities."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Log in",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Nuke",
            "bindings": [
              {
                "keys": [
                  "Z"
                ]
              }
            ],
            "note": "Requires enough coins."
          },
          {
            "action": "Antivirus",
            "bindings": [
              {
                "keys": [
                  "X"
                ]
              }
            ],
            "note": "Requires enough coins."
          },
          {
            "action": "Exit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Aim",
            "bindings": [
              {
                "label": "Move mouse"
              }
            ]
          },
          {
            "action": "Fire or select",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
