{
  "version": 1,
  "name": "LabWars",
  "description": "Fight through top-down campaign stages or survive approaching zombies.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "layout": "overlay",
      "pointer": "move",
      "touch": "move",
      "actions": [
        {
          "label": "Fire / Select",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ],
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad"
        }
      ]
    }
  },
  "build": {
    "assets": [
      "media/font/Consolas/xpm2",
      "data/scoreboard.txt",
      "maps/xpm2"
    ],
    "pathAliases": {
      "/home/lcom/labs/proj/src": "."
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Single player, then choose Campaign or Zombies. Move with WASD, aim with the mouse and press the left button to fire."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Back",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Leaves the current game and returns to the mode menu."
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Aim",
            "bindings": [
              {
                "label": "Move the mouse or drag"
              }
            ]
          },
          {
            "action": "Fire or select",
            "bindings": [
              {
                "label": "Left click or tap"
              }
            ],
            "note": "Fires during play and chooses menu options."
          }
        ]
      }
    ]
  }
}
