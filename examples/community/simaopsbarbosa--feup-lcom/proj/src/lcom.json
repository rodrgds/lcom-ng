{
  "version": 1,
  "name": "Quick Reflex",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ENTER",
        "ESC"
      ],
      "joystick": false,
      "dpad": false,
      "layout": "overlay",
      "pointer": "drag",
      "touch": "move",
      "actions": [
        {
          "label": "P1 React",
          "key": "SPACE",
          "position": "bottom-left"
        },
        {
          "label": "P2 React",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ],
      "toolbar": "top-right",
      "cursor": {
        "x": 40,
        "y": 40,
        "maxX": 784,
        "maxY": 573,
        "desktopScale": 1
      }
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": []
  },
  "description": "Watch for the signal and react. Challenge your timing alone or with a second player.",
  "preview": "../../../../../collections/arcade/previews/simaopsbarbosa-feup-lcom-e3fa6454545b.png"
}
