{
  "version": 1,
  "name": "Portal 2D",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [],
      "joystick": false,
      "dpad": {
        "side": "left",
        "keys": "wasd",
        "axes": "horizontal"
      },
      "look": {
        "side": "right",
        "sensitivity": 1
      },
      "layout": "overlay",
      "pointer": "move",
      "toolbar": "top-left",
      "actions": [
        {
          "label": "Jump",
          "key": "SPACE",
          "position": "bottom-right"
        },
        {
          "label": "Purple",
          "mouseButton": "left",
          "position": "bottom-right"
        },
        {
          "label": "Green",
          "mouseButton": "right",
          "position": "bottom-right"
        },
        {
          "label": "Back",
          "key": "ESC",
          "position": "top-right"
        }
      ],
      "touch": "move"
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [
      "proj/Src/Resources"
    ],
    "arguments": [
      "Resources"
    ]
  },
  "description": "Solve platform puzzles by linking two portals, moving and jumping past obstacles.",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play to start. Left-click places the purple portal and right-click places the green one; the character travels between them."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ],
            "note": "Hold to run."
          },
          {
            "action": "Jump",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "Space"
                ]
              }
            ]
          },
          {
            "action": "Back to menu",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Aim",
            "bindings": [
              {
                "label": "Move mouse"
              },
              {
                "label": "Drag"
              }
            ]
          },
          {
            "action": "Place purple portal",
            "bindings": [
              {
                "label": "Left click"
              }
            ],
            "note": "Left click also chooses menu buttons."
          },
          {
            "action": "Place green portal",
            "bindings": [
              {
                "label": "Right click"
              }
            ]
          }
        ]
      }
    ]
  }
}
