{
  "version": 1,
  "name": "Air Hockey: Practice Rink",
  "description": "Practice paddle strikes and rebounds against a stationary opponent.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "W",
        "S"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "overlay",
      "pointer": "drag",
      "toolbar": "top-right",
      "pads": [],
      "actions": [
        {
          "label": "Play / Select",
          "key": "SPACE",
          "position": "bottom-right"
        }
      ],
      "tapDuration": 80
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "archetype": "Air Hockey",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Press Space on Play. Hold the left mouse button and drag to move your paddle, then strike the ball past the red paddle."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Choose menu item",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              }
            ],
            "note": "Play, Rules and Exit."
          },
          {
            "action": "Select",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ]
          },
          {
            "action": "Return to menu",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "During a match."
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Move paddle",
            "bindings": [
              {
                "label": "Hold left click and drag"
              },
              {
                "label": "Touch and drag"
              }
            ]
          }
        ]
      },
      {
        "title": "Touch",
        "controls": [
          {
            "action": "Start a match",
            "bindings": [
              {
                "label": "Tap Play / Select"
              }
            ]
          }
        ]
      }
    ]
  }
}
