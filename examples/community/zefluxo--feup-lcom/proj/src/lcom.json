{
  "version": 1,
  "name": "Minix Tetris",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "quickKeys": [],
      "joystick": false,
      "layout": "overlay",
      "pointer": "drag",
      "dpad": {
        "keys": "arrows",
        "side": "left",
        "axes": "horizontal"
      },
      "toolbar": "top-left",
      "repeatKeys": [
        "LEFT",
        "RIGHT",
        "DOWN"
      ],
      "actions": [
        {
          "position": "bottom-right",
          "label": "Rotate left",
          "key": "Z"
        },
        {
          "position": "bottom-right",
          "label": "Rotate right",
          "key": "X"
        },
        {
          "position": "bottom-right",
          "label": "Soft drop",
          "key": "DOWN"
        },
        {
          "position": "top-right",
          "label": "Select",
          "key": "ENTER"
        },
        {
          "position": "top-right",
          "label": "Esc",
          "key": "ESC"
        }
      ]
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [
      "proj/src/home/lcom/labs/proj/src/game/scores.txt"
    ]
  }
}
