{
  "version": 1,
  "name": "Minix Tetris",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "quickKeys": [],
      "joystick": false,
      "layout": "overlay",
      "pointer": "drag",
      "dpad": {
        "keys": "arrows",
        "side": "left",
        "axes": "horizontal"
      },
      "toolbar": "top-left",
      "repeatKeys": [
        "LEFT",
        "RIGHT",
        "DOWN"
      ],
      "actions": [
        {
          "position": "bottom-right",
          "label": "Rotate left",
          "key": "Z"
        },
        {
          "position": "bottom-right",
          "label": "Rotate right",
          "key": "X"
        },
        {
          "position": "bottom-right",
          "label": "Soft drop",
          "key": "DOWN"
        },
        {
          "position": "top-right",
          "label": "Select",
          "key": "ENTER"
        },
        {
          "position": "top-right",
          "label": "Esc",
          "key": "ESC"
        }
      ]
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [
      "proj/src/home/lcom/labs/proj/src/game/scores.txt"
    ]
  },
  "description": "Rotate falling blocks and build complete lines before the stack reaches the top.",
  "preview": "../../../../../collections/arcade/previews/zefluxo-feup-lcom-7d2140581772.png",
  "archetype": "Tetris",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play to start. Clear complete rows before the stack reaches the top; at the end, type three letters and press Esc to save your score."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "Soft drop",
            "bindings": [
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Rotate left",
            "bindings": [
              {
                "keys": [
                  "Z"
                ]
              }
            ]
          },
          {
            "action": "Rotate right",
            "bindings": [
              {
                "keys": [
                  "X"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Slide piece",
            "bindings": [
              {
                "label": "Move mouse left or right"
              }
            ]
          },
          {
            "action": "Soft drop",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          },
          {
            "action": "Rotate right",
            "bindings": [
              {
                "label": "Right click"
              }
            ]
          }
        ]
      }
    ]
  }
}
