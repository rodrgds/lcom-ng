{
  "version": 1,
  "name": "Atari Bricket",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "W",
        "S"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "move",
      "toolbar": "auto",
      "pads": [
        {
          "mode": "wasd",
          "axes": "horizontal",
          "style": "dpad",
          "side": "left"
        },
        {
          "mode": "mouse",
          "style": "stick",
          "side": "right",
          "sensitivity": 5
        }
      ],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "side": "right"
        }
      ],
      "touchClick": false
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": [
      "highscores.txt"
    ],
    "pathAliases": {
      "home/lcom/lcom1617-t1g13/brickbreaker/src": ".",
      "/tmp": "."
    }
  },
  "description": "Break colorful bricks, collect falling power-ups and keep the ball in play with A and D.",
  "archetype": "Breakout",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions": {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play to start. Keep the ball in play with the paddle and catch the falling power-ups."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move paddle",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Back to menu",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Returns to the menu during a round; exits from the menu."
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Choose menu item",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          },
          {
            "action": "Move paddle",
            "bindings": [
              {
                "label": "Hold left button"
              },
              {
                "label": "Hold right button"
              }
            ]
          },
          {
            "action": "Submit high score",
            "bindings": [
              {
                "label": "Left click"
              }
            ],
            "note": "Click Submit on the high-score screen."
          }
        ]
      },
      {
        "title": "High score entry",
        "controls": [
          {
            "action": "Choose letter slot",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Change letter",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
