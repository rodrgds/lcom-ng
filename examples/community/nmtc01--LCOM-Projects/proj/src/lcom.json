{
  "version": 1,
  "name": "Nether Dragon",
  "description": "Shoot enemies while flying through the scrolling sky.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "layout": "overlay",
      "pointer": "off",
      "toolbar": "top-right",
      "pads": [
        {
          "mode": "arrows",
          "side": "left",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Play / Resume",
          "key": "ENTER",
          "position": "bottom-right"
        },
        {
          "label": "Fire",
          "key": "SPACE",
          "position": "bottom-right"
        }
      ],
      "joystick": false
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": []
  },
  "icon": "icon.png",
  "preview": "preview.png"
}
