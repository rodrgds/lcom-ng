{
  "version": 1,
  "name": "Galactic War",
  "description": "Steer the original spaceship left and right to dodge falling asteroids.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER"
      ],
      "pointer": "off",
      "layout": "panel",
      "pads": [
        {
          "mode": "arrows",
          "style": "dpad",
          "side": "left",
          "axes": "horizontal"
        }
      ],
      "actions": [
        {
          "label": "Start",
          "key": "ENTER",
          "side": "right"
        }
      ],
      "repeatKeys": [],
      "repeatReleaseKeys": [
        "LEFT",
        "RIGHT"
      ]
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Press Enter on the menu to launch a round. Steer the ship left and right to dodge the falling asteroids."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "End game",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Menus",
        "controls": [
          {
            "action": "Choose option",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Confirm",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ],
            "note": "Also restarts or exits from the game-over screen."
          }
        ]
      }
    ]
  }
}
