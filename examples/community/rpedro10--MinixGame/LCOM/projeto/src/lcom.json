{
  "version": 1,
  "name": "Super Minix",
  "description": "Run and jump past the original scrolling pipes and save your score.",
  "build": {
    "assetRoot": ".",
    "assets": [
      "images"
    ],
    "pathAliases": {
      "/home/images": "images",
      "/home/lcom": "."
    }
  },
  "mobile": {
    "orientation": "auto",
    "fullscreen": false,
    "controls": {
      "layout": "panel",
      "keyboard": true,
      "mouseButtons": false,
      "joystick": false,
      "dpad": false,
      "look": false,
      "pointer": "move",
      "quickKeys": [
        "ESC",
        "ENTER"
      ],
      "pads": [
        {
          "side": "left",
          "mode": "arrows",
          "style": "dpad",
          "axes": "horizontal"
        }
      ],
      "repeatKeys": [
        "LEFT",
        "RIGHT"
      ],
      "actions": [
        {
          "label": "Jump",
          "key": "SPACE",
          "side": "right"
        },
        {
          "label": "Select",
          "mouseButton": "left",
          "side": "right"
        }
      ]
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Start Game, then run and jump past the pipes to build your score. Esc returns to the menu."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "Jump",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ]
          },
          {
            "action": "Back to menu",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Quits from the main menu."
          }
        ]
      },
      {
        "title": "Game over",
        "controls": [
          {
            "action": "Change letter",
            "bindings": [
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "Confirm letter",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              },
              {
                "keys": [
                  "Space"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Choose menu item",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
