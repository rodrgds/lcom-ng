{
  "version": 1,
  "name": "Set",
  "description": "Find three cards whose four features are each all alike or all different.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "pointer": "move",
      "touch": "tap",
      "layout": "overlay",
      "pads": [],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "top-right"
        },
        {
          "label": "Start / No sets",
          "key": "ENTER",
          "position": "bottom-right"
        },
        {
          "label": "Hint",
          "key": "H",
          "position": "top-left"
        },
        {
          "label": "Check Set",
          "key": "SPACE",
          "position": "bottom-left"
        },
        {
          "label": "Pause",
          "key": "P",
          "position": "bottom-right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": "..",
    "assets": [
      "files"
    ],
    "pathAliases": {
      "/home/lcom/proj": "."
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click New, then Singleplayer, and enter player initials on the on-screen keyboard. Press Enter to start, then find three cards whose four features are all alike or all different."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Check a set",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ]
          },
          {
            "action": "Claim no sets",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Hint",
            "bindings": [
              {
                "keys": [
                  "H"
                ]
              }
            ],
            "note": "Selects a valid trio."
          },
          {
            "action": "Pause or resume",
            "bindings": [
              {
                "keys": [
                  "P"
                ]
              }
            ]
          },
          {
            "action": "Return to menu",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Move the pointer",
            "bindings": [
              {
                "label": "Move mouse"
              }
            ]
          },
          {
            "action": "Select a card or menu option",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
