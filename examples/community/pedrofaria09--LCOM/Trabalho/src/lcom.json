{
  "version": 1,
  "name": "Penguin Obstacle Dash",
  "build": {
    "cStandard": "gnu89",
    "arguments": [
      "start",
      ".",
      "PLAYER"
    ],
    "assets": [
      "userinfo.txt"
    ]
  },
  "mobile": {
    "orientation": "auto",
    "controls": {
      "layout": "panel",
      "pointer": "move",
      "keyboard": false,
      "mouseButtons": false,
      "joystick": false,
      "quickKeys": [
        "ESC"
      ],
      "pads": [
        {
          "side": "left",
          "style": "dpad",
          "mode": "wasd",
          "axes": "vertical"
        }
      ],
      "repeatKeys": [
        "W",
        "S"
      ],
      "touchClick": false,
      "actions": [
        {
          "position": "top-right",
          "label": "Pause",
          "key": "P"
        }
      ]
    }
  },
  "description": "Guide the original pixel penguin through moving green gates. Hold the up/down controls or slide vertically, and pause any time.",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Guide the penguin through the gaps in the green gates. Hold W or S to move up and down, or slide the mouse vertically."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move up",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              }
            ]
          },
          {
            "action": "Move down",
            "bindings": [
              {
                "keys": [
                  "S"
                ]
              }
            ]
          },
          {
            "action": "Pause",
            "bindings": [
              {
                "keys": [
                  "P"
                ]
              }
            ],
            "note": "Press P again to resume."
          },
          {
            "action": "Exit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Move vertically",
            "bindings": [
              {
                "label": "Move the mouse or drag vertically"
              }
            ],
            "note": "Slide up or down to change height."
          }
        ]
      }
    ]
  }
}
