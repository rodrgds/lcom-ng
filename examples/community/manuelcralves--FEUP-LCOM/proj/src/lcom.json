{
  "name": "Candy Maze: Ghost Trail",
  "mobile": {
    "fullscreen": false,
    "orientation": "auto",
    "controls": {
      "layout": "panel",
      "keyboard": false,
      "pointer": "move",
      "mouseButtons": false,
      "joystick": false,
      "dpad": false,
      "look": false,
      "quickKeys": [
        "ESC"
      ],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ],
      "pads": [
        {
          "mode": "arrows",
          "style": "dpad",
          "side": "left"
        }
      ]
    }
  },
  "description": "Guide the ghost through three original mazes, collect every sweet and reach each exit.",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play to enter the first maze. Collect every sweet, then reach the exit."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              },
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ],
            "note": "Hold a direction to keep moving."
          },
          {
            "action": "Pause",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Opens Continue and Exit."
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Select menu option",
            "bindings": [
              {
                "label": "Left click or tap"
              }
            ],
            "note": "Works on the main and pause menus."
          }
        ]
      }
    ]
  }
}
