{
  "version": 1,
  "name": "Connect Four: Adriano",
  "description": "Take turns dropping red and yellow chips to connect four.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "layout": "overlay",
      "pointer": "move",
      "toolbar": "top-right",
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "top-right"
        },
        {
          "label": "Red drop",
          "key": "ENTER",
          "position": "bottom-right"
        },
        {
          "label": "Yellow drop",
          "key": "SPACE",
          "position": "bottom-left"
        }
      ],
      "pads": [
        {
          "mode": "arrows",
          "side": "left",
          "style": "dpad",
          "axes": "horizontal"
        }
      ],
      "tapDuration": 100
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": []
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "archetype": "Connect Four",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Local game to start a two-player match. Take turns choosing a column and dropping a chip; connect four in a row to win."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Choose column",
            "bindings": [
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ],
            "note": "Player one."
          },
          {
            "action": "Drop red chip",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Drop yellow chip",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ],
            "note": "Player two."
          },
          {
            "action": "Back to menu",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Move yellow column left",
            "bindings": [
              {
                "label": "Left click"
              }
            ],
            "note": "Player two selects the column with left and right clicks."
          },
          {
            "action": "Move yellow column right",
            "bindings": [
              {
                "label": "Right click"
              }
            ]
          },
          {
            "action": "Drop yellow chip",
            "bindings": [
              {
                "label": "Middle click"
              }
            ]
          }
        ]
      }
    ]
  }
}
