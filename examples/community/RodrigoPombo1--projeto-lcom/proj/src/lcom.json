{
  "version": 1,
  "name": "Leiria",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [],
      "joystick": false,
      "dpad": {
        "side": "left",
        "keys": "wasd"
      },
      "look": false,
      "layout": "overlay",
      "pointer": "direct",
      "toolbar": "top-left",
      "actions": [
        {
          "label": "Exit",
          "key": "ESC",
          "position": "top-right"
        }
      ],
      "touch": "tap",
      "tapDuration": 60,
      "cursor": {
        "x": 0,
        "y": 0,
        "maxX": 799,
        "maxY": 599
      }
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [
      "proj/src/high_scores.txt"
    ],
    "pathAliases": {
      "/home/lcom/labs/g5": "."
    }
  },
  "description": "Navigate a dungeon and tap adjacent monsters to survive the growing horde.",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play to enter the dungeon. Move with WASD and click monsters on adjacent tiles before the horde grows."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ],
            "note": "Moves one tile at a time."
          },
          {
            "action": "Exit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Attack adjacent monster",
            "bindings": [
              {
                "label": "Left click"
              },
              {
                "label": "Tap"
              }
            ],
            "note": "Menu options and the top-right Exit button also use a click."
          }
        ]
      }
    ]
  }
}
