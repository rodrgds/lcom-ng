{
  "version": 1,
  "name": "Asteroids in the LCOM Galaxy",
  "description": "Steer through asteroids and blast a path to survive.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER",
        "SPACE"
      ],
      "layout": "overlay",
      "pointer": "move",
      "toolbar": "top-right",
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Fire / Select",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": []
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "archetype": "Asteroids"
}
