{
  "version": 1,
  "name": "Connect Four: Disc Match",
  "description": "Take turns with yellow mouse-controlled discs and red arrow-controlled discs.",
  "mobile": {
    "orientation": "auto",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER",
        "LEFT",
        "RIGHT"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "move",
      "toolbar": "top-right",
      "pads": [],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ],
      "repeatKeys": [
        "LEFT",
        "RIGHT"
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": [],
    "pathAliases": {
      "/home/lcom/labs/proj/src": "."
    }
  },
  "archetype": "Connect Four",
  "icon": "icon.png",
  "preview": "preview.png"
}
