{
  "version": 1,
  "name": "Connect Four: Disc Match",
  "description": "Take turns with yellow mouse-controlled discs and red arrow-controlled discs.",
  "mobile": {
    "orientation": "auto",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER",
        "LEFT",
        "RIGHT"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "move",
      "toolbar": "top-right",
      "pads": [],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ],
      "repeatKeys": [
        "LEFT",
        "RIGHT"
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": [],
    "pathAliases": {
      "/home/lcom/labs/proj/src": "."
    }
  },
  "archetype": "Connect Four",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play, then click the game to capture the mouse. Yellow drops mouse-controlled discs; red uses the arrow keys. Connect four discs in a row."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move red disc",
            "bindings": [
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ],
            "note": "Red player only."
          },
          {
            "action": "Drop red disc",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ],
            "note": "Red player only."
          },
          {
            "action": "Return to menu",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Move yellow disc",
            "bindings": [
              {
                "label": "Move mouse"
              },
              {
                "label": "Drag"
              }
            ]
          },
          {
            "action": "Drop yellow disc or choose a menu item",
            "bindings": [
              {
                "label": "Left click"
              },
              {
                "label": "Select button"
              }
            ],
            "note": "Yellow player only; in the menu this selects Play, Instructions or Exit."
          }
        ]
      }
    ]
  }
}
