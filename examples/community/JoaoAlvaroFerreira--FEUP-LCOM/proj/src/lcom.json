{
  "version": 1,
  "name": "LCOM Fever",
  "description": "Match pills to customers\u2019 symptoms in the original pharmacy challenge.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER"
      ],
      "layout": "overlay",
      "pointer": "drag",
      "toolbar": "top-right",
      "pads": [],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "bottom-right"
        },
        {
          "label": "Pill guide",
          "key": "A",
          "position": "bottom-left"
        },
        {
          "label": "Reset / Submit",
          "key": "SPACE",
          "position": "bottom-left"
        }
      ],
      "joystick": false
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [
      "proj/src/highscores/highscores.txt",
      "proj/src/images/door.bmp",
