      "/home/lcom/labs/proj": "proj"
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click the pharmacy door, then Play. Drag pills from the shelf onto the customer whose symptoms match."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Show pill guide",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              }
            ],
            "note": "During play."
          },
          {
            "action": "Reset pills",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ],
            "note": "During play."
          },
          {
            "action": "Change name letter",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              }
            ],
            "note": "On the score name screen."
          },
          {
            "action": "Move name cursor",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ],
            "note": "On the score name screen."
          },
          {
            "action": "Submit name",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ],
            "note": "On the score name screen."
          },
          {
            "action": "Back",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Returns to the main menu."
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Move pointer",
            "bindings": [
              {
                "label": "Move mouse"
              }
            ]
          },
          {
            "action": "Pick up and drag a pill",
            "bindings": [
              {
                "label": "Hold left click"
              }
            ],
            "note": "Keep holding while you move the pill to a customer."
          },
          {
            "action": "Choose menu item",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
