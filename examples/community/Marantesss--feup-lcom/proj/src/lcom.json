{
  "version": 1,
  "name": "Minix Force",
  "description": "Move through the arena, aim the crosshair and shoot approaching zombies.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "pointer": "move",
      "layout": "overlay",
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Play",
          "key": "ENTER",
          "position": "bottom-right"
        },
        {
          "label": "Fire",
          "mouseButton": "left",
          "position": "bottom-right"
        },
        {
          "label": "Pause",
          "key": "SPACE",
          "position": "bottom-right"
        }
      ],
      "repeatKeys": [
        "W",
        "A",
        "S",
        "D"
      ]
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": []
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Press Enter to play. Move with W, A, S and D, aim with the mouse, and left-click to fire."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Pause or resume",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ]
          },
          {
            "action": "End round",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Aim",
            "bindings": [
              {
                "label": "Move the mouse"
              },
              {
                "label": "Swipe"
              }
            ]
          },
          {
            "action": "Fire",
            "bindings": [
              {
                "label": "Left click"
              },
              {
                "label": "Tap Fire"
              }
            ]
          }
        ]
      }
    ]
  }
}
