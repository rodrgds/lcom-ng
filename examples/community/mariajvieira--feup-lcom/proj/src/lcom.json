{
  "version": 1,
  "name": "Snake Garden",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [],
      "joystick": false,
      "dpad": {
        "side": "left",
        "keys": "wasd"
      },
      "layout": "overlay",
      "pointer": "off",
      "toolbar": "top-left",
      "actions": [
        {
          "position": "top-right",
          "label": "Level up",
          "key": "UP"
        },
        {
          "position": "top-right",
          "label": "Level down",
          "key": "DOWN"
        },
        {
          "position": "top-right",
          "label": "Select",
          "key": "ENTER"
        },
        {
          "position": "top-right",
          "label": "Esc",
          "key": "ESC"
        }
      ]
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": []
  },
  "description": "Guide your growing snake around the garden without running into yourself.",
  "preview": "../../../../../collections/arcade/previews/mariajvieira-feup-lcom-d95c409c5aa9.png",
  "archetype": "Snake",
  "instructions": {
    "sections": [
      {
        "title": "Get started",
        "text": "Choose a level with Up and Down, then press Enter. Steer the snake with WASD and avoid its own tail."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ],
            "note": "W, A, S and D set the snake's direction."
          },
          {
            "action": "Choose level",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Start level",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Quit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
