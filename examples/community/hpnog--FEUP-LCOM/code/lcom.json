{
  "version": 1,
  "name": "Connect Four: Cosmic Rivals",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "off",
      "toolbar": "top-right",
      "pads": [
        {
          "mode": "arrows",
          "side": "left",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Continue",
          "key": "SPACE",
          "position": "top-left"
        },
        {
          "label": "Drop / Select",
          "key": "ENTER",
          "position": "bottom-right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": "..",
    "assets": [
      "code/images"
    ],
    "pathAliases": {
      "/home/lcom1415-t6g10-proj": "code"
    }
  },
  "description": "Take turns dropping planets into the original space-themed board and connect four before the timer expires.",
  "archetype": "Connect Four",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Press Space at the welcome screen, then choose Play from the menu with Up and Down and press Enter. On each turn, move the column arrow with Left and Right and press Enter to drop a planet."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Continue",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ],
            "note": "Welcome, credits, and result screens."
          },
          {
            "action": "Choose a menu option",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Confirm",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ],
            "note": "Starts the selected option or drops in the selected column."
          },
          {
            "action": "Move column",
            "bindings": [
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "Leave match",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
