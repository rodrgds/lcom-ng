{
  "version": 1,
  "name": "Labyrinth Quest",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [],
      "joystick": {
        "mode": "wasd",
        "side": "left"
      },
      "pointer": "move",
      "layout": "overlay",
      "look": {
        "side": "right",
        "sensitivity": 1
      },
      "toolbar": "top-left",
      "actions": [
        {
          "position": "bottom-right",
          "label": "Dash",
          "key": "SPACE"
        },
        {
          "position": "bottom-right",
          "label": "Attack",
          "mouseButton": "left"
        },
        {
          "position": "bottom-right",
          "label": "Interact",
          "mouseButton": "right"
        },
        {
          "position": "top-right",
          "label": "Esc",
          "key": "ESC"
        }
      ]
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": []
  },
  "description": "Find your way through the dungeon. Dash past danger and fight the enemies ahead.",
  "preview": "../../../../../collections/arcade/previews/cata-24-minix3-game-952ce67c4b3d.png",
  "instructions": {
    "sections": [
      {
        "title": "Get started",
        "text": "Click New Game to enter the dungeon. Find the key, fight the enemies and reach the door to advance."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Dash",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ],
            "note": "Hold to dash; release to return to normal speed."
          },
          {
            "action": "Pause",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Aim",
            "bindings": [
              {
                "label": "Move mouse"
              }
            ],
            "note": "Your character faces the cursor."
          },
          {
            "action": "Attack",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          },
          {
            "action": "Interact",
            "bindings": [
              {
                "label": "Right click"
              }
            ],
            "note": "Use on doors and rewards."
          }
        ]
      }
    ]
  }
}
