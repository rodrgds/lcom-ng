{
  "version": 1,
  "name": "PixelMind",
  "description": "Memorize a pixel drawing and paint it from memory.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER",
        "BACKSPACE"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "move",
      "toolbar": "top-right",
      "pads": [],
      "actions": [
        {
          "label": "Paint",
          "mouseButton": "left",
          "position": "bottom-right"
        },
        {
          "label": "Erase",
          "mouseButton": "right",
          "position": "bottom-left"
        }
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Press Enter or click Start, study the original drawing, then recreate it before the timer runs out."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Start or confirm",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ],
            "note": "During the paint round, Enter reveals the original once."
          },
          {
            "action": "Back or quit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Move pointer",
            "bindings": [
              {
                "label": "Move mouse"
              }
            ]
          },
          {
            "action": "Paint",
            "bindings": [
              {
                "label": "Left click"
              }
            ],
            "note": "Drag to paint several cells."
          },
          {
            "action": "Erase",
            "bindings": [
              {
                "label": "Right click"
              }
            ],
            "note": "Drag to erase several cells."
          },
          {
            "action": "Select menu item",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      },
      {
        "title": "Menus",
        "controls": [
          {
            "action": "Choose menu item",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
