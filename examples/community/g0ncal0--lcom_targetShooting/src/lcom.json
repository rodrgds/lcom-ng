{
  "version": 1,
  "name": "Target Shooting",
  "description": "Aim at the targets and beat the clock.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER",
        "UP",
        "DOWN"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "overlay",
      "pointer": "move",
      "toolbar": "top-right",
      "pads": [],
      "actions": [
        {
          "label": "Shoot",
          "mouseButton": "left",
          "position": "bottom-right"
        },
        {
          "label": "Slow time",
          "wheel": 2,
          "position": "bottom-right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Choose Singleplayer with Up and Down, then press Enter. Shoot the targets and keep an eye on the clock."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Choose menu option",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Start",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Back to menu",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Aim",
            "bindings": [
              {
                "label": "Move mouse"
              }
            ]
          },
          {
            "action": "Shoot",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          },
          {
            "action": "Slow time",
            "bindings": [
              {
                "label": "Scroll wheel"
              }
            ],
            "note": "Singleplayer only."
          }
        ]
      }
    ]
  }
}
