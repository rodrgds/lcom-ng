{
  "version": 1,
  "name": "Target Shooting",
  "description": "Aim at the targets and beat the clock.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER",
        "UP",
        "DOWN"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "overlay",
      "pointer": "move",
      "toolbar": "top-right",
      "pads": [],
      "actions": [
        {
          "label": "Shoot",
          "mouseButton": "left",
          "position": "bottom-right"
        },
        {
          "label": "Slow time",
          "wheel": 2,
          "position": "bottom-right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "icon": "icon.png",
  "preview": "preview.png"
}
