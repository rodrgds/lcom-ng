{
  "version": 1,
  "name": "Minix Legends",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "dpad": false,
      "layout": "overlay",
      "pointer": "drag",
      "touch": "move",
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad",
          "axes": "both"
        },
        {
          "mode": "arrows",
          "side": "right",
          "style": "dpad",
          "axes": "both"
        }
      ],
      "actions": [
        {
          "label": "P1 Attack",
          "position": "bottom-left",
          "mouseButton": "left"
        },
        {
          "label": "P2 Attack",
          "position": "bottom-right",
          "mouseButton": "right"
        },
        {
          "label": "Start",
          "position": "top-left",
          "key": "W"
        },
        {
          "label": "Shop",
          "position": "top-left",
          "key": "P"
        }
      ],
      "toolbar": "top-right",
      "look": false,
      "cursor": {
        "x": 512,
        "y": 384,
        "maxX": 974,
        "maxY": 716,
        "desktopScale": 1
      }
    }
  },
  "build": {
    "assetRoot": "..",
    "assets": [],
    "environment": {
      "LCOM_COMPAT_MOUSE_REPORTING": "1"
    }
  },
  "description": "Choose your fighters and face a friend in a two-player arena battle.",
  "preview": "../../../../collections/arcade/previews/cast-10-lcomproject-1c6c122eea2f.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play or press W to start. Player 1 uses W/A/S/D, Player 2 uses the arrow keys, and each player attacks with their mouse button."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move Player 1",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Move Player 2",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              },
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "Open or close shop",
            "bindings": [
              {
                "keys": [
                  "P"
                ]
              }
            ],
            "note": "Spend points on upgrades while the shop is open."
          },
          {
            "action": "Quit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Player 1 attack",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          },
          {
            "action": "Player 2 attack",
            "bindings": [
              {
                "label": "Right click"
              }
            ]
          },
          {
            "action": "Buy an upgrade",
            "bindings": [
              {
                "label": "Left click"
              }
            ],
            "note": "Click an upgrade bar while the shop is open."
          }
        ]
      }
    ]
  }
}
