{
  "version": 1,
  "name": "Minix Legends",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "dpad": false,
      "layout": "overlay",
      "pointer": "drag",
      "touch": "move",
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad",
          "axes": "both"
        },
        {
          "mode": "arrows",
          "side": "right",
          "style": "dpad",
          "axes": "both"
        }
      ],
      "actions": [
        {
          "label": "P1 Attack",
          "position": "bottom-left",
          "mouseButton": "left"
        },
        {
          "label": "P2 Attack",
          "position": "bottom-right",
          "mouseButton": "right"
        },
        {
          "label": "Start",
          "position": "top-left",
          "key": "W"
        },
        {
          "label": "Shop",
          "position": "top-left",
          "key": "P"
        }
      ],
      "toolbar": "top-right",
      "look": false,
      "cursor": {
        "x": 512,
        "y": 384,
        "maxX": 974,
        "maxY": 716,
        "desktopScale": 1
      }
    }
  },
  "build": {
    "assetRoot": "..",
    "assets": [],
    "environment": {
      "LCOM_COMPAT_MOUSE_REPORTING": "1"
    }
  },
  "description": "Choose your fighters and face a friend in a two-player arena battle.",
  "preview": "../../../../collections/arcade/previews/cast-10-lcomproject-1c6c122eea2f.png"
}
