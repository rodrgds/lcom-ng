{
  "version": 1,
  "name": "Penaltix",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER",
        "TAB"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "overlay",
      "pointer": "drag",
      "toolbar": "top-right",
      "pads": [
        {
          "mode": "arrows",
          "side": "left",
          "style": "dpad"
        },
        {
          "mode": "mouse",
          "side": "right",
          "sensitivity": 2,
          "style": "stick"
        }
      ],
      "actions": [
        {
          "label": "Aim / Shoot",
          "mouseButton": "right",
          "position": "top-left"
        }
      ]
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [
      "proj/src/images"
    ],
    "pathAliases": {
      "/home/lcom/proj": "proj"
    },
    "arguments": [
      "1"
    ]
  },
  "description": "Hold the right mouse button, drag to aim, then release to shoot. Defend the goal with the arrow keys.",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Press Tab to move through the menu and Enter to choose Play, then Single Player. Hold the right mouse button and drag to aim, then release to shoot."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Choose menu item",
            "bindings": [
              {
                "keys": [
                  "Tab"
                ]
              }
            ]
          },
          {
            "action": "Confirm or skip pause",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ],
            "note": "Confirms menu choices and skips reaction pauses."
          },
          {
            "action": "Defend the goal",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              },
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ],
            "note": "Pick up to two areas when the computer shoots."
          },
          {
            "action": "Exit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Aim and shoot",
            "bindings": [
              {
                "label": "Hold right click and drag, then release"
              }
            ]
          },
          {
            "action": "Choose menu item",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
