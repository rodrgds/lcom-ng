{
  "version": 1,
  "name": "Fall Diet",
  "description": "Catch healthy food and swat away the junk food.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "layout": "overlay",
      "pointer": "move",
      "toolbar": "top-right",
      "actions": [
        {
          "label": "Select / Swat",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ],
      "pads": []
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [
      "proj/src/HighScores.txt"
    ],
    "pathAliases": {
      "/home/lcom/labs/g10/proj/src": "proj/src"
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Singleplayer to start. Catch healthy food with your character and click junk food to swat it away."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move left",
            "bindings": [
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              }
            ]
          },
          {
            "action": "Move right",
            "bindings": [
              {
                "keys": [
                  "Right"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Move cursor",
            "bindings": [
              {
                "label": "Move mouse"
              },
              {
                "label": "Swipe"
              }
            ]
          },
          {
            "action": "Select or swat",
            "bindings": [
              {
                "label": "Left click"
              },
              {
                "label": "Select / Swat button"
              }
            ],
            "note": "Clicks menu buttons and swats junk food under the cursor."
          }
        ]
      }
    ]
  }
}
