{
  "version": 1,
  "name": "BreakPong",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "1",
        "3",
        "4"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "overlay",
      "pointer": "move",
      "toolbar": "top-right",
      "pads": [
        {
          "mode": "mouse",
          "style": "stick",
          "side": "left",
          "axes": "horizontal",
          "sensitivity": 1
        }
      ],
      "actions": [
        {
          "label": "Launch",
          "mouseButton": "right",
          "position": "bottom-right"
        }
      ],
      "touch": "move"
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "description": "Move the paddle and break bricks, collecting bonuses across three levels.",
  "preview": "preview.png",
  "archetype": "Breakout"
}
