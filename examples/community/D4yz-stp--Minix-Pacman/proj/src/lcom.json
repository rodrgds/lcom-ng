{
  "version": 1,
  "name": "MINIX Pac-Man",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [],
      "joystick": false,
      "pointer": "off",
      "layout": "overlay",
      "dpad": {
        "keys": "wasd",
        "side": "left"
      },
      "toolbar": "top-left",
      "actions": [
        {
          "position": "top-right",
          "label": "Select",
          "key": "ENTER"
        },
        {
          "position": "top-right",
          "label": "Esc",
          "key": "ESC"
        }
      ]
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [
      "proj/src/score.txt"
    ]
  },
  "description": "Chase dots through the maze while keeping a safe distance from the ghosts.",
  "preview": "../../../../../collections/arcade/previews/d4yz-stp-minix-pacman-e9e2296201be.png",
  "archetype": "Pac-Man",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Choose Start Game from the menu. Eat the dots while keeping away from the ghosts."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ],
            "note": "W and S also move the menu selection."
          },
          {
            "action": "Choose a menu option",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              }
            ],
            "note": "Or use W and S."
          },
          {
            "action": "Select",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Back or exit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
