{
  "version": 1,
  "name": "Super Tux",
  "description": "Jump across icy platforms, collect coins and avoid enemies.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "layout": "overlay",
      "pointer": "direct",
      "toolbar": "top-right",
      "actions": [
        {
          "label": "Jump",
          "key": "SPACE",
          "position": "bottom-right"
        }
      ],
      "pads": [
        {
          "mode": "arrows",
          "side": "left",
          "style": "dpad",
          "axes": "horizontal"
        }
      ],
      "touch": "tap",
      "tapDuration": 60,
      "cursor": {
        "x": 2,
        "y": 2,
        "minX": 1,
        "minY": 1,
        "maxX": 790,
        "maxY": 590
      }
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [
      "proj/src/highscores.txt"
    ]
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Start Game to begin. Run across the icy platforms, collect coins, and jump over enemies."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move left",
            "bindings": [
              {
                "keys": [
                  "Left"
                ]
              }
            ]
          },
          {
            "action": "Move right",
            "bindings": [
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "Duck",
            "bindings": [
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Jump",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ]
          },
          {
            "action": "Throw fireball",
            "bindings": [
              {
                "keys": [
                  "Alt"
                ]
              }
            ]
          },
          {
            "action": "Pause or resume",
            "bindings": [
              {
                "keys": [
                  "P"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Select menu item",
            "bindings": [
              {
                "label": "Left click"
              },
              {
                "label": "Tap"
              }
            ]
          },
          {
            "action": "Move",
            "bindings": [
              {
                "label": "Direction pad"
              }
            ]
          },
          {
            "action": "Jump",
            "bindings": [
              {
                "label": "Jump button"
              }
            ]
          }
        ]
      }
    ]
  }
}
