{
  "version": 1,
  "name": "Target Practice Shooter",
  "description": "Aim at flying clay disks, shoot and reload before your ammunition runs out.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "layout": "overlay",
      "pointer": "direct",
      "toolbar": "top-right",
      "actions": [
        {
          "label": "Reload",
          "key": "R",
          "position": "bottom-right"
        }
      ],
      "pads": [],
      "touch": "tap",
      "cursor": {
        "x": 576,
        "y": 432,
        "maxX": 1111,
        "maxY": 823
      }
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [
      "proj/res/highscores.txt",
      "proj/images/xpm sources.txt"
    ]
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play to start. Aim at the flying clay disks and shoot before your ammunition runs out."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Reload",
            "bindings": [
              {
                "keys": [
                  "R"
                ]
              }
            ]
          },
          {
            "action": "Pause or resume",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Aim",
            "bindings": [
              {
                "label": "Move mouse"
              }
            ]
          },
          {
            "action": "Shoot",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
