{
  "version": 1,
  "name": "Whack-a-Mole: Burrow Rush",
  "description": "Hit the moles as they pop out of the ground.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER"
      ],
      "joystick": false,
      "layout": "overlay",
      "pointer": "move",
      "toolbar": "top-right",
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "top-right"
        },
        {
          "label": "Top left",
          "key": "A",
          "position": "bottom-left"
        },
        {
          "label": "Top middle",
          "key": "S",
          "position": "bottom-left"
        },
        {
          "label": "Top right",
          "key": "D",
          "position": "bottom-right"
        },
        {
          "label": "Bottom left",
          "key": "J",
          "position": "bottom-left"
        },
        {
          "label": "Bottom middle",
          "key": "K",
          "position": "bottom-right"
        },
        {
          "label": "Bottom right",
          "key": "L",
          "position": "bottom-right"
        }
      ],
      "tapDuration": 100
    }
  },
  "build": {
    "assetRoot": "..",
    "assets": [
      "src/leaderboard.txt"
    ]
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "archetype": "Whack-a-Mole",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Single Player, pick an avatar, and click the name field to type a name. Click Start, then hit each mole as it pops out."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Hit top-left hole",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              }
            ]
          },
          {
            "action": "Hit top-middle hole",
            "bindings": [
              {
                "keys": [
                  "S"
                ]
              }
            ]
          },
          {
            "action": "Hit top-right hole",
            "bindings": [
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Hit bottom-left hole",
            "bindings": [
              {
                "keys": [
                  "J"
                ]
              }
            ]
          },
          {
            "action": "Hit bottom-middle hole",
            "bindings": [
              {
                "keys": [
                  "K"
                ]
              }
            ]
          },
          {
            "action": "Hit bottom-right hole",
            "bindings": [
              {
                "keys": [
                  "L"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Select menus and hit moles",
            "bindings": [
              {
                "label": "Left click"
              },
              {
                "label": "Select button"
              }
            ],
            "note": "Point the hammer at a mole before clicking."
          }
        ]
      },
      {
        "title": "Menus",
        "controls": [
          {
            "action": "Delete a name letter",
            "bindings": [
              {
                "keys": [
                  "Backspace"
                ]
              }
            ]
          },
          {
            "action": "Confirm the name",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ],
            "note": "Click the name field before typing."
          }
        ]
      }
    ]
  }
}
