{
  "version": 1,
  "name": "Suecalandia",
  "description": "Split the deck, select trump and play Sueca against the original three bots.",
  "mobile": {
    "orientation": "auto",
    "fullscreen": false,
    "controls": {
      "layout": "panel",
      "pointer": "move",
      "keyboard": false,
      "mouseButtons": false,
      "joystick": false,
      "dpad": true,
      "quickKeys": [
        "ESC",
        "ENTER"
      ],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ]
    }
  },
  "build": {
    "assets": []
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Choose Start and confirm the deal to play Sueca against three bots. Split the deck, pick trump, then play a card on your turn."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move selection",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              },
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "Confirm",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Pause or back",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Select or confirm",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          },
          {
            "action": "Play a card",
            "bindings": [
              {
                "label": "Drag a card"
              }
            ]
          }
        ]
      }
    ]
  }
}
