{
  "version": 1,
  "name": "MINIX Grand Prix",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "quickKeys": [],
      "joystick": false,
      "layout": "overlay",
      "pointer": "direct",
      "touch": "tap",
      "cursor": {
        "x": 400,
        "y": 300,
        "maxX": 799,
        "maxY": 599
      },
      "actions": [
        {
          "position": "bottom-right",
          "label": "Drift",
          "key": "SPACE"
        },
        {
          "position": "bottom-right",
          "label": "Boost",
          "key": "LSHIFT"
        },
        {
          "position": "top-right",
          "label": "Start race",
          "key": "ENTER"
        },
        {
          "position": "top-right",
          "label": "Pause",
          "key": "ESC"
        },
        {
          "position": "bottom-right",
          "label": "Brake / reverse",
          "key": "S",
          "icon": "brake"
        },
        {
          "position": "bottom-right",
          "label": "Accelerate",
          "key": "W",
          "icon": "accelerator"
        }
      ],
      "toolbar": "top-left",
      "pads": [
        {
          "side": "left",
          "mode": "wasd",
          "style": "wheel",
          "maxAngle": 135,
          "deadZone": 8
        }
      ]
    }
  },
  "build": {
    "assetRoot": "..",
    "assets": [],
    "libraries": [
      "timer=../libs/timer.c",
      "kbc=../libs/kbc.c",
      "rtc=../libs/rtc.c",
      "mouse=../libs/mouse.c",
      "video=../libs/video-card.c",
      "utils=../libs/utils.c"
    ],
    "pathAliases": {
      "/home/lcom/labs/grupo_2leic01_2": "."
    }
  },
  "description": "Take the wheel, race around the track and use your boost on the straights.",
  "preview": "../../../../collections/arcade/previews/m1ke26-minix-grand-prix-d83709a8a95c.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Pick a car and track on the start screen, then click Start Race. Press Enter to begin the countdown."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Accelerate",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              }
            ]
          },
          {
            "action": "Brake or reverse",
            "bindings": [
              {
                "keys": [
                  "S"
                ]
              }
            ]
          },
          {
            "action": "Steer",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Drift",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ],
            "note": "Handbrake for tighter turns."
          },
          {
            "action": "Boost",
            "bindings": [
              {
                "keys": [
                  "Shift"
                ]
              }
            ]
          },
          {
            "action": "Pause or resume",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Select menu option",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
