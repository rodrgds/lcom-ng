{
  "version": 1,
  "name": "Ball vs. Ball",
  "description": "Two-player football with original rolling players and a shared ball.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [],
      "joystick": false,
      "layout": "overlay",
      "pointer": "move",
      "touch": "move",
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad"
        },
        {
          "mode": "arrows",
          "side": "right",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "top-right"
        },
        {
          "label": "Kick P1",
          "key": "SPACE",
          "position": "bottom-left"
        },
        {
          "label": "Kick P2",
          "key": "KP_ENTER",
          "position": "bottom-right"
        },
        {
          "label": "Back",
          "key": "ESC",
          "position": "top-left"
        }
      ]
    }
  },
  "build": {
    "assets": [
      "resources"
    ],
    "pathAliases": {
      "/home/lcom/proj/src/resources": "resources"
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Start to play. Player 1 uses WASD and Space; Player 2 uses the arrow keys and Keypad Enter."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Player 1 move",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Player 1 kick",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ]
          },
          {
            "action": "Player 2 move",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              },
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "Player 2 kick",
            "bindings": [
              {
                "keys": [
                  "Numpad Enter"
                ]
              }
            ]
          },
          {
            "action": "Back to menu",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Select menu item",
            "bindings": [
              {
                "label": "Left click or tap"
              }
            ],
            "note": "Start, Highscores or Exit."
          }
        ]
      }
    ]
  }
}
