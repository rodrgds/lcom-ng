{
  "version": 1,
  "name": "Shoot Monsters",
  "mobile": {
    "orientation": "auto",
    "fullscreen": true,
    "controls": {
      "layout": "panel",
      "keyboard": false,
      "pointer": "move",
      "touchClick": false,
      "mouseButtons": false,
      "joystick": false,
      "quickKeys": [
        "ESC",
        "UP",
        "DOWN"
      ],
      "pads": [
        {
          "mode": "mouse",
          "side": "right",
          "style": "stick"
        }
      ],
      "actions": [
        {
          "key": "ENTER",
          "label": "Select",
          "position": "top-left"
        },
        {
          "mouseButton": "left",
          "label": "Fire / Select",
          "position": "bottom-left"
        },
        {
          "key": "SPACE",
          "label": "Reload",
          "position": "top-right"
        }
      ]
    }
  },
  "build": {
    "pathAliases": {
      "/home/lcom/lcom/proj/src": "."
    },
    "assets": [
      "highscores.txt"
    ]
  },
  "description": "Aim at the original green monsters, fire before they move, and reload to protect five lives and save a high score.",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Choose Play with Up and Down, then press Enter. Aim at the green monsters, fire before they move, and reload to protect five lives."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Choose menu item",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Start or confirm",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Reload",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ],
            "note": "Restores all 10 bullets."
          },
          {
            "action": "Back or exit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Aim",
            "bindings": [
              {
                "label": "Move mouse"
              }
            ]
          },
          {
            "action": "Fire",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
