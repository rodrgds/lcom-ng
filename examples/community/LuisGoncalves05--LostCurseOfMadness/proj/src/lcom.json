{
  "version": 1,
  "name": "Lost Curse of Madness",
  "description": "Explore a maze and escape its lurking dangers.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "overlay",
      "pointer": "move",
      "toolbar": "top-right",
      "pads": [
        {
          "side": "left",
          "mode": "wasd",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Select / Fire",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ],
      "tapDuration": 80
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "icon": "icon.png",
  "preview": "preview.png"
}
