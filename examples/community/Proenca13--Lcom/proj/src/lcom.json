{
  "version": 1,
  "name": "Minesweeper: Hidden Fields",
  "description": "Reveal safe cells and mark hidden mines.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "move",
      "tapDuration": 80,
      "toolbar": "top-right",
      "pads": [
        {
          "side": "left",
          "mode": "arrows",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Reveal",
          "key": "SPACE",
          "position": "bottom-right"
        },
        {
          "label": "Flag",
          "key": "F",
          "position": "bottom-right"
        },
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ],
      "repeatKeys": [
        "LEFT",
        "RIGHT",
        "UP",
        "DOWN"
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "archetype": "Minesweeper",
  "icon": "icon.png",
  "preview": "preview.png"
}
