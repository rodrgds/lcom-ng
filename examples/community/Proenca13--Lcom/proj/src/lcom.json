{
  "version": 1,
  "name": "Minesweeper: Hidden Fields",
  "description": "Reveal safe cells and mark hidden mines.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "move",
      "tapDuration": 80,
      "toolbar": "top-right",
      "pads": [
        {
          "side": "left",
          "mode": "arrows",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Reveal",
          "key": "SPACE",
          "position": "bottom-right"
        },
        {
          "label": "Flag",
          "key": "F",
          "position": "bottom-right"
        },
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ],
      "repeatKeys": [
        "LEFT",
        "RIGHT",
        "UP",
        "DOWN"
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "archetype": "Minesweeper",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Choose Start from the menu, then reveal every safe cell without hitting a mine. Right-click a cell to flag a suspected mine."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move selection",
            "bindings": [
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              },
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Reveal",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ],
            "note": "The first revealed cell places the mines and is always safe."
          },
          {
            "action": "Flag",
            "bindings": [
              {
                "keys": [
                  "F"
                ]
              }
            ]
          },
          {
            "action": "Pause or resume",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Menus",
        "controls": [
          {
            "action": "Choose",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Confirm",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Move pointer",
            "bindings": [
              {
                "label": "Move the mouse or drag"
              }
            ]
          },
          {
            "action": "Reveal",
            "bindings": [
              {
                "label": "Left click or tap"
              }
            ]
          },
          {
            "action": "Flag",
            "bindings": [
              {
                "label": "Right click"
              }
            ]
          }
        ]
      }
    ]
  }
}
