{
  "version": 1,
  "name": "Pom Power",
  "description": "Hit rising notes and keep the rhythm.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "overlay",
      "pointer": "move",
      "toolbar": "top-right",
      "pads": [
        {
          "side": "left",
          "mode": "arrows",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ],
      "tapDuration": 65
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "icon": "icon.png",
  "preview": "preview.png"
}
