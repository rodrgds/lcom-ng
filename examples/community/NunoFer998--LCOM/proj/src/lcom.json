{
  "version": 1,
  "name": "Minesweeper: Classic Garden",
  "description": "Reveal numbered cells, flag mines and play the original menus.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER",
        "UP",
        "DOWN"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "move",
      "tapDuration": 80,
      "toolbar": "top-right",
      "pads": [],
      "actions": [
        {
          "label": "Reveal / Select",
          "mouseButton": "left",
          "position": "bottom-right"
        },
        {
          "label": "Flag",
          "mouseButton": "right",
          "position": "bottom-right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "archetype": "Minesweeper",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Choose Play with W/S or Up/Down and press Enter. Click the game to capture the pointer, then left click to reveal cells and right click to flag mines."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Navigate menu",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              }
            ]
          },
          {
            "action": "Select",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Back to menu",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Move pointer",
            "bindings": [
              {
                "label": "Move mouse"
              }
            ]
          },
          {
            "action": "Reveal cell",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          },
          {
            "action": "Flag mine",
            "bindings": [
              {
                "label": "Right click"
              }
            ]
          }
        ]
      }
    ]
  }
}
