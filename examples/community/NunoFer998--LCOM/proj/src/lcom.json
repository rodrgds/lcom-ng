{
  "version": 1,
  "name": "Minesweeper: Classic Garden",
  "description": "Reveal numbered cells, flag mines and play the original menus.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER",
        "UP",
        "DOWN"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "move",
      "tapDuration": 80,
      "toolbar": "top-right",
      "pads": [],
      "actions": [
        {
          "label": "Reveal / Select",
          "mouseButton": "left",
          "position": "bottom-right"
        },
        {
          "label": "Flag",
          "mouseButton": "right",
          "position": "bottom-right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "archetype": "Minesweeper",
  "icon": "icon.png",
  "preview": "preview.png"
}
