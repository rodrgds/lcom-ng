{
  "version": 1,
  "name": "Tetris: Block Workshop",
  "description": "Rotate and place blocks to complete rows.",
  "mobile": {
    "orientation": "auto",
    "fullscreen": false,
    "controls": {
      "layout": "panel",
      "pointer": "move",
      "keyboard": false,
      "mouseButtons": false,
      "joystick": false,
      "dpad": false,
      "quickKeys": [
        "ESC",
        "Q"
      ],
      "repeatReleaseKeys": [
        "A",
        "D",
        "S"
      ],
      "pads": [
        {
          "side": "left",
          "mode": "wasd",
          "style": "dpad",
          "axes": "horizontal"
        }
      ],
      "actions": [
        {
          "label": "Rotate",
          "key": "W",
          "side": "right"
        },
        {
          "label": "Drop",
          "key": "SPACE",
          "side": "right"
        },
        {
          "label": "Soft drop",
          "key": "S",
          "side": "right"
        },
        {
          "label": "Select",
          "mouseButton": "left",
          "side": "right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "archetype": "Tetris",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play to start a new round. Rotate and place falling blocks to complete rows."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Rotate",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              }
            ]
          },
          {
            "action": "Soft drop",
            "bindings": [
              {
                "keys": [
                  "S"
                ]
              }
            ]
          },
          {
            "action": "Hard drop",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ]
          },
          {
            "action": "End round",
            "bindings": [
              {
                "keys": [
                  "Q"
                ]
              }
            ],
            "note": "Opens the game over menu, where you can restart."
          },
          {
            "action": "Quit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Select menu option",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
