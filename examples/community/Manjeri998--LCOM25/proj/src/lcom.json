{
  "version": 1,
  "name": "Minesweeper: Green Field",
  "description": "Reveal connected cells and flag mines in the original green field.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "move",
      "tapDuration": 80,
      "toolbar": "top-right",
      "pads": [],
      "actions": [
        {
          "label": "Reveal / Select",
          "mouseButton": "left",
          "position": "bottom-right"
        },
        {
          "label": "Flag",
          "mouseButton": "right",
          "position": "bottom-right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "archetype": "Minesweeper",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click the game to capture the mouse. Clear every safe square without uncovering a mine, and mark suspected mines with the right button."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Quit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Move pointer",
            "bindings": [
              {
                "label": "Move mouse"
              }
            ]
          },
          {
            "action": "Reveal",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          },
          {
            "action": "Flag",
            "bindings": [
              {
                "label": "Right click"
              }
            ],
            "note": "Marks or unmarks a suspected mine."
          }
        ]
      }
    ]
  }
}
