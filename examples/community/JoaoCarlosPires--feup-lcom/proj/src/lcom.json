{
  "version": 1,
  "name": "Bullet Man",
  "description": "Aim the cannon and launch the circus performer at the target.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "E"
      ],
      "joystick": false,
      "layout": "overlay",
      "pointer": "off",
      "toolbar": "top-right",
      "actions": [
        {
          "label": "Aim up",
          "key": "W",
          "position": "bottom-right"
        },
        {
          "label": "Aim down",
          "key": "S",
          "position": "bottom-right"
        },
        {
          "label": "Launch",
          "key": "L",
          "position": "bottom-right"
        },
        {
          "label": "Play / Pause",
          "key": "P",
          "position": "top-right"
        }
      ],
      "pads": []
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": []
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Choose Play with P or click it. Move the cannon to match the target height, then press L to launch before the timer runs out."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Aim",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              }
            ],
            "note": "Moves the cannon through five heights."
          },
          {
            "action": "Launch",
            "bindings": [
              {
                "keys": [
                  "L"
                ]
              }
            ]
          },
          {
            "action": "Play, pause, or resume",
            "bindings": [
              {
                "keys": [
                  "P"
                ]
              }
            ]
          },
          {
            "action": "Exit",
            "bindings": [
              {
                "keys": [
                  "E"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Select menu item",
            "bindings": [
              {
                "label": "Left click"
              },
              {
                "label": "Play button"
              }
            ]
          }
        ]
      }
    ]
  }
}
