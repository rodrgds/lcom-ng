{
  "version": 1,
  "name": "Rush: Ambulance Run",
  "description": "Steer an ambulance through the original scrolling traffic.",
  "mobile": {
    "orientation": "auto",
    "fullscreen": true,
    "controls": {
      "layout": "panel",
      "keyboard": false,
      "pointer": "move",
      "touchClick": false,
      "mouseButtons": false,
      "joystick": false,
      "quickKeys": [
        "ESC"
      ],
      "pads": [
        {
          "mode": "mouse",
          "side": "left",
          "style": "stick",
          "axes": "horizontal"
        }
      ],
      "actions": [
        {
          "label": "Start / Boost",
          "key": "SPACE",
          "position": "top-right"
        },
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": "..",
    "assets": [
      "res"
    ],
    "pathAliases": {
      "/home/rush/res": "res",
      "home/rush/res": "res"
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play to start. Steer with the mouse and hold Space to boost through traffic."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Boost",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ],
            "note": "Hold to boost."
          },
          {
            "action": "Pause",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Press again to resume."
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Steer",
            "bindings": [
              {
                "label": "Move the mouse left or right"
              }
            ]
          },
          {
            "action": "Select menu option",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      },
      {
        "title": "Menus",
        "controls": [
          {
            "action": "Return to menu",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ],
            "note": "Press in the pause menu."
          }
        ]
      }
    ]
  }
}
