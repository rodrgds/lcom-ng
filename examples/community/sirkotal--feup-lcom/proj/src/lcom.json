{
  "version": 1,
  "name": "Arena: Three Hunters",
  "description": "Navigate the original maze and shoot its three targets.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER",
        "UP",
        "DOWN"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "move",
      "tapDuration": 80,
      "toolbar": "top-right",
      "pads": [
        {
          "side": "left",
          "mode": "arrows",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Select / Fire",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ],
      "repeatKeys": [
        "UP",
        "DOWN",
        "LEFT",
        "RIGHT"
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Choose Start with Up/Down and press Enter, then click the game to capture the mouse. Walk with the arrow keys, aim the crosshair with the mouse and left click to fire."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Walk up",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              }
            ]
          },
          {
            "action": "Walk down",
            "bindings": [
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Walk left",
            "bindings": [
              {
                "keys": [
                  "Left"
                ]
              }
            ]
          },
          {
            "action": "Walk right",
            "bindings": [
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "Back to menu",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Aim",
            "bindings": [
              {
                "label": "Move mouse"
              }
            ]
          },
          {
            "action": "Fire",
            "bindings": [
              {
                "label": "Left click"
              }
            ],
            "note": "Up to 10 shots can be in flight."
          }
        ]
      }
    ]
  }
}
