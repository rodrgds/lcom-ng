{
  "version": 1,
  "name": "Classic Chess",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER",
        "BACKSPACE"
      ],
      "joystick": false,
      "dpad": false,
      "layout": "overlay",
      "pointer": "direct",
      "touch": "hold-drag",
      "cursor": {
        "x": 0,
        "y": 0,
        "maxX": 1134,
        "maxY": 837,
        "bounds": "reject"
      },
      "toolbar": "top-right",
      "keyboardPosition": "bottom",
      "actions": [
        {
          "label": "Cancel",
          "position": "bottom-right",
          "mouseButton": "right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": []
  },
  "description": "Choose a piece, plan your next move and play a game of chess.",
  "preview": "../../../../../collections/arcade/previews/migueljcpedrosa-lcom-classic-chess-game-5dfb841c6c0f.png",
  "archetype": "Chess",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play and type your name, then press Enter. Click a piece, then click its destination to move."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Start / confirm",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ],
            "note": "Starts from the menu, confirms your name, or plays again after the game ends."
          },
          {
            "action": "Delete letter",
            "bindings": [
              {
                "keys": [
                  "Backspace"
                ]
              }
            ]
          },
          {
            "action": "Back / exit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Quits from the menu; elsewhere it returns to the menu."
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Select piece or menu option",
            "bindings": [
              {
                "label": "Left click"
              }
            ],
            "note": "Click a piece, then click a highlighted destination."
          },
          {
            "action": "Cancel selection",
            "bindings": [
              {
                "label": "Right click"
              }
            ]
          }
        ]
      }
    ]
  }
}
