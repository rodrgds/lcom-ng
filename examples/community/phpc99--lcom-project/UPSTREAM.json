        {
          "file": "proj/src/Controller/Game/MapController.c",
          "originalSha256": "f4edae81cb3b31b19597a87b8e0dae4c719cf6678438c68c5f01da28cb85a288",
          "patchedSha256": "3125b07e45c92ddeb7805b544802b09c4c9e9e8907b010111635765c5b0f79da",
          "reason": "Grow the element-pointer allocation to the new count, including the newly placed block.",
          "verification": "After collection repair, real placement fixture rejects original realloc size because it excludes the new element. Repaired source retains both live block pointers within the allocation."
        }
