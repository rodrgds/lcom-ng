{
  "version": 1,
  "name": "Terraria Lite",
  "description": "Mine blocks, gather materials and build a small world.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "1",
        "2",
        "3",
        "4",
        "5"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "overlay",
      "pointer": "move",
      "toolbar": "top-right",
      "pads": [
        {
          "side": "left",
          "mode": "wasd",
          "style": "dpad",
          "axes": "horizontal"
        }
      ],
      "actions": [
        {
          "label": "Use / Mine",
          "mouseButton": "left",
          "position": "bottom-right"
        },
        {
          "label": "Place",
          "mouseButton": "right",
          "position": "bottom-right"
        },
        {
          "label": "Jump",
          "key": "SPACE",
          "position": "bottom-right"
        }
      ],
      "tapDuration": 65
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": [
      "src/assets"
    ],
    "pathAliases": {
      "/home/lcom/labs/grupo_2leic05_6/proj/src/assets/Hotbar": "src/assets/HotBar",
      "/home/lcom/labs/grupo_2leic05_6/proj": "."
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play, then walk with A and D and jump with Space. Left click mines blocks and right click places the selected block."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              },
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "Jump",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              },
              {
                "keys": [
                  "Up"
                ]
              }
            ]
          },
          {
            "action": "Select hotbar slot",
            "bindings": [
              {
                "keys": [
                  "1"
                ]
              },
              {
                "keys": [
                  "2"
                ]
              },
              {
                "keys": [
                  "3"
                ]
              },
              {
                "keys": [
                  "4"
                ]
              },
              {
                "keys": [
                  "5"
                ]
              }
            ]
          },
          {
            "action": "Pause / back",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Pauses the game; from the pause menu it returns to the main menu."
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Mine / use",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          },
          {
            "action": "Place block",
            "bindings": [
              {
                "label": "Right click"
              }
            ]
          },
          {
            "action": "Choose menu item",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
