{
  "version": 1,
  "name": "Minix Vice",
  "description": "Choose a car and race through the original Minix Vice challenge.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "H"
      ],
      "joystick": false,
      "layout": "overlay",
      "pointer": "move",
      "toolbar": "top-right",
      "actions": [
        {
          "label": "Select / Fire",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ],
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad"
        }
      ],
      "repeatKeys": [
        "A",
        "D",
        "W",
        "S"
      ],
      "tapDuration": 100
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [
      "minix-vice/res"
    ],
    "pathAliases": {
      "/home/minix-vice": "minix-vice"
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play and choose a car. Dodge traffic and click cones on the road to shoot them for bonus points."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Steer left",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              }
            ]
          },
          {
            "action": "Steer right",
            "bindings": [
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Accelerate",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              }
            ]
          },
          {
            "action": "Brake",
            "bindings": [
              {
                "keys": [
                  "S"
                ]
              }
            ]
          },
          {
            "action": "Open help",
            "bindings": [
              {
                "keys": [
                  "H"
                ]
              }
            ],
            "note": "Available from the main menu."
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Select and shoot",
            "bindings": [
              {
                "label": "Left click"
              },
              {
                "label": "Select / Fire button"
              }
            ]
          }
        ]
      }
    ]
  }
}
