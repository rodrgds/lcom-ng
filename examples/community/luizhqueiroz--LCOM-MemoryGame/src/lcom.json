{
  "version": 1,
  "name": "Memory Quest",
  "icon": "../../../../collections/arcade/icons/memory-quest.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "dpad": false,
      "layout": "overlay",
      "pointer": "direct",
      "toolbar": "top-right",
      "keyboardPosition": "bottom",
      "look": false,
      "pads": [
        {
          "mode": "arrows",
          "side": "left",
          "style": "dpad",
          "axes": "both"
        }
      ],
      "actions": [
        {
          "label": "Start",
          "position": "top-left",
          "key": "1"
        },
        {
          "label": "Scores",
          "position": "top-left",
          "key": "2"
        },
        {
          "label": "Flip",
          "position": "bottom-right",
          "key": "ENTER"
        }
      ],
      "touch": "tap",
      "cursor": {
        "x": 10,
        "y": 10,
        "minX": 0,
        "minY": 0,
        "maxX": 800,
        "maxY": 600,
        "bounds": "clamp"
      }
    }
  },
  "build": {
    "assetRoot": "..",
    "assets": [
      "src/game/record/record.txt"
    ],
    "pathAliases": {
      "/home/lcom/labs/proj": "."
    }
  },
  "description": "Reveal the hidden pictures and find the matching cards.",
  "preview": "../../../../collections/arcade/previews/luizhqueiroz-lcom-memorygame-4540b5424a79.png",
  "archetype": "Memory",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Press 1 to start. Reveal two cards at a time and match every pair."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Start",
            "bindings": [
              {
                "keys": [
                  "1"
                ]
              }
            ]
          },
          {
            "action": "Scores",
            "bindings": [
              {
                "keys": [
                  "2"
                ]
              }
            ]
          },
          {
            "action": "Move selection",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              },
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "Flip card",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ],
            "note": "Also saves your name on the win screen."
          },
          {
            "action": "Back to menu",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          },
          {
            "action": "Delete name letter",
            "bindings": [
              {
                "keys": [
                  "Backspace"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Flip card",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          },
          {
            "action": "Choose a menu option",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
