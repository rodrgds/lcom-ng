{
  "version": 1,
  "name": "LCOM Ninja",
  "description": "Slice flying fruit with your katana and build a combo.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "layout": "overlay",
      "pointer": "direct",
      "toolbar": "top-right",
      "actions": [],
      "touch": "press",
      "cursor": {
        "x": 0,
        "y": 0,
        "maxX": 1024,
        "maxY": 768
      }
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [],
    "arguments": [
      "player"
    ]
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "archetype": "Fruit Ninja",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Swipe through the pineapple on the menu to start solo play. Slice the flying fruit and avoid the bombs."
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Choose menu item",
            "bindings": [
              {
                "label": "Swipe across a fruit"
              }
            ],
            "note": "Slice the pineapple for solo play."
          },
          {
            "action": "Slice",
            "bindings": [
              {
                "label": "Drag across fruit"
              }
            ],
            "note": "Hold and move to cut through the fruit."
          }
        ]
      }
    ]
  }
}
