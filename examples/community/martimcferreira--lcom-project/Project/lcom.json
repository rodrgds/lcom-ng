{
  "version": 1,
  "name": "FEUP Hero",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "quickKeys": [
        "A",
        "S",
        "D",
        "F",
        "G"
      ],
      "joystick": false,
      "layout": "panel",
      "pointer": "direct",
      "cursor": {
        "x": 400,
        "y": 500,
        "maxX": 788,
        "maxY": 585
      },
      "toolbar": "auto",
      "actions": [
        {
          "position": "top-right",
