{
  "version": 1,
  "name": "FEUP Hero",
  "icon": "../../../../collections/arcade/icons/feup-hero.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "quickKeys": [
        "A",
        "S",
        "D",
        "F",
        "G"
      ],
      "joystick": false,
      "layout": "panel",
      "pointer": "direct",
      "cursor": {
        "x": 400,
        "y": 500,
        "maxX": 788,
        "maxY": 585
      },
      "toolbar": "auto",
      "actions": [
        {
          "position": "top-right",
          "label": "Select",
          "key": "ENTER"
        },
        {
          "position": "top-right",
          "label": "Esc",
          "key": "ESC"
        }
      ]
    }
  },
  "build": {
    "assetRoot": "..",
    "assets": [
      "Project/beatmaps"
    ]
  },
  "description": "Hit the notes as they reach the fretboard and keep the rhythm going.",
  "preview": "../../../../collections/arcade/previews/martimcferreira-lcom-project-9a16857450a6.png",
  "instructions": {
    "sections": [
      {
        "title": "Get started",
        "text": "Choose Play, enter a name and pick a song. Press each lane key as its note reaches the line."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Hit note",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              },
              {
                "keys": [
                  "F"
                ]
              },
              {
                "keys": [
                  "G"
                ]
              }
            ],
            "note": "One key per lane, left to right."
          },
          {
            "action": "Choose menu item",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              }
            ],
            "note": "Main menu, song select and pause menus."
          },
          {
            "action": "Confirm",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Delete name letter",
            "bindings": [
              {
                "keys": [
                  "Backspace"
                ]
              }
            ]
          },
          {
            "action": "Pause or resume",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          },
          {
            "action": "Choose game-over option",
            "bindings": [
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ],
            "note": "Game-over and game-won screens."
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Select menu option",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
