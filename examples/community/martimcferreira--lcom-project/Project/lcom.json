          "key": "ENTER"
        },
        {
          "position": "top-right",
          "label": "Esc",
          "key": "ESC"
        }
      ]
    }
  },
  "build": {
    "assetRoot": "..",
    "assets": [
      "Project/beatmaps"
    ]
  },
  "description": "Hit the notes as they reach the fretboard and keep the rhythm going.",
