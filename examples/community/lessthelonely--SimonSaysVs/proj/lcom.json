{
  "version": 1,
  "name": "Simon Says Vs: Memory Duel",
  "description": "Remember the growing color sequence in a local two-player memory duel.",
  "archetype": "Simon Says",
  "mobile": {
    "orientation": "auto",
    "fullscreen": false,
    "controls": {
      "layout": "panel",
      "pointer": "move",
      "keyboard": true,
      "mouseButtons": false,
      "dpad": false,
      "joystick": false,
      "quickKeys": [
        "ESC",
        "ENTER",
        "1",
        "2",
        "BACKSPACE"
      ],
      "pads": [
        {
          "side": "left",
          "mode": "arrows",
          "style": "dpad",
          "axes": "vertical"
        }
      ],
      "repeatReleaseKeys": [
        "UP",
        "DOWN"
      ],
      "actions": [
        {
          "side": "right",
          "mouseButton": "left",
          "label": "Select"
        }
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": [
      "leaderboard.txt"
    ],
    "pathAliases": {
      "home/lcom/labs/g06/proj": "."
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Choose One PC, type a round count with the number keys, then press Enter. Watch the color sequence and click the same buttons in order."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move menu selection",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Confirm",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Delete round digit",
            "bindings": [
              {
                "keys": [
                  "Backspace"
                ]
              }
            ]
          },
          {
            "action": "Exit game",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Choose a color",
            "bindings": [
              {
                "label": "Left click"
              },
              {
                "label": "Tap"
              }
            ],
            "note": "Click the buttons in the order shown."
          },
          {
            "action": "Move pointer",
            "bindings": [
              {
                "label": "Move the mouse"
              },
              {
                "label": "Drag"
              }
            ]
          }
        ]
      }
    ]
  }
}
