{
  "version": 1,
  "name": "Chess: Animated Board",
  "description": "Move the original animated pieces across a local chess board.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "move",
      "tapDuration": 80,
      "toolbar": "top-right",
      "pads": [],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "archetype": "Chess",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play, choose a play mode, then click the game to capture the mouse. Click one of your pieces, then click a highlighted square to move it."
      },
      {
        "title": "Menus",
        "controls": [
          {
            "action": "Navigate",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Confirm",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Exit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Move pointer",
            "bindings": [
              {
                "label": "Move mouse"
              }
            ]
          },
          {
            "action": "Select piece or destination",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          },
          {
            "action": "Choose menu option",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
