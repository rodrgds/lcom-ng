{
  "version": 1,
  "name": "PettyCats",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "dpad": false,
      "layout": "overlay",
      "pointer": "drag",
      "toolbar": "top-right",
      "look": false,
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad",
          "axes": "both"
        }
      ],
      "actions": [
        {
          "label": "Interact",
          "position": "bottom-right",
          "key": "E"
        },
        {
          "label": "Pet",
          "position": "bottom-right",
          "mouseButton": "left"
        }
      ],
      "cursor": {
        "x": 0,
        "y": 0,
        "maxX": 1008,
        "maxY": 752,
        "desktopScale": 1
      }
    }
  },
  "build": {
    "assetRoot": "..",
    "assets": []
  },
  "description": "Explore the room and pet the cats with the original mouse gestures.",
  "preview": "../../../../collections/arcade/previews/teixdavide-feup-lcom-pettycats-768b12c9a51f.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Walk near a cat until it is selected, then press E to start petting. Hold the left mouse button and trace the shape shown for that cat."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Pet selected cat",
            "bindings": [
              {
                "keys": [
                  "E"
                ]
              }
            ]
          },
          {
            "action": "Back to menu",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Trace the petting shape",
            "bindings": [
              {
                "label": "Hold left click and move"
              }
            ],
            "note": "Release at the end of the shape."
          },
          {
            "action": "Cancel petting",
            "bindings": [
              {
                "label": "Right or middle click"
              }
            ]
          }
        ]
      }
    ]
  }
}
