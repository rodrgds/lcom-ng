  "sourcePatches": [
    {
      "path": "SOURCE_PATCH.diff",
      "files": [
        {
          "path": "src/main.c",
          "originalSha256": "fa9d29fd1d4038892b1f87964cbad58f5b92f2f2cad40599eed6e9eb01a046bf",
          "patchedSha256": "874074bc849f4de09340b0caa3913e842f239bdb71098d02a7db0057ac14b364",
          "reason": "Original callback definition has no parameters, conflicting with the required LCF int(argc,argv) callback signature. Compile failed at main.c:49; only signature corrected, behavior unchanged."
        },
        {
          "path": "src/models/Room.c",
          "originalSha256": "d9c08a4c96a8e7f77c0aaea4d0f76931a77003fb953a10a3d9c4997341097679",
          "patchedSha256": "02d5f0592f2e9ae819cc99d92f8890ea7616b8da20e0a9d8a870a84fa7a03c04",
          "reason": "Original startup SIGSEGV while no cat is within selection radius. getSelectedCat returns and dereferences an uninitialized closestCat when all candidates are distant. Initialize NULL and mark selection only when a cat was found. Original deleteRoom also frees uninitialized walls pointers; the real gameplay exit reproduces SIGSEGV under MallocScribble=1. Initialize the four unused wall slots to NULL."
        },
        {
          "path": "src/drivers/gpu.c",
          "originalSha256": "60f7c4ef56cb00b1be54f63c3ee8f06d1ce15eef72aa5e83b14b33cda299d88b",
          "patchedSha256": "ae07b2301abd08aa249f48c079000283569cb893592eed6dbbf51f7b5d5a1b4a",
          "reason": "Clip coordinates at the exclusive screen width and height. x==width corrupts the following row and y==height writes past the allocated framebuffer, causing extended native gameplay crashes. Issue #12."
        },
        {
          "path": "src/controller/controllerMouse.c",
          "originalSha256": "4866222ba67ff63d2986fd4a00871f1c69a3d798627b873c7cd28f61d17b4964",
          "patchedSha256": "41660303f25b7152079fb3a4b7c6dc825b0b60311b95cfaeadaabfa828981835",
          "reason": "Clamp the whole original16x16 mouse cursor inside the1024x768 framebuffer instead of allowing its origin at the offscreen resolution boundary. Preserve unit movement and buttons."
        }
      ],
      "reproduction": "Public moveMouse input at1007,751 with delta2,-2 must stop at1008,752. Original advances to1009,753 and eventually1024,768, hiding the cursor. Existing graphics clipping correction remains recorded."
    }
  ],
