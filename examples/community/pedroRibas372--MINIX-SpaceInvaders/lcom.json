{
  "version": 1,
  "name": "Space Invaders: Neon Fleet",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [],
      "joystick": false,
      "dpad": {
        "side": "left",
        "keys": "wasd",
        "axes": "horizontal"
      },
      "layout": "overlay",
      "pointer": "off",
      "toolbar": "top-left",
      "repeatKeys": [
        "A",
        "D",
        "SPACE"
      ],
      "actions": [
        {
          "position": "bottom-right",
          "label": "Fire",
          "key": "SPACE"
        },
        {
          "position": "top-right",
          "label": "Menu up",
          "key": "UP"
        },
        {
          "position": "top-right",
          "label": "Menu down",
          "key": "DOWN"
        },
        {
          "position": "top-right",
          "label": "Select",
          "key": "ENTER"
        },
        {
          "position": "top-right",
          "label": "Esc",
          "key": "ESC"
        }
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "description": "Pick your level, move into position and fire through the neon alien fleet.",
  "preview": "../../../collections/arcade/previews/pedroribas372-minix-spaceinvaders-e02a4844fc81.png",
  "archetype": "Space Invaders",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Press Enter on the menu to start, or choose Level first. Move with A and D and fire with Space."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Fire",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Menus",
        "controls": [
          {
            "action": "Navigate",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Select",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Back or exit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Esc leaves a match and returns to the menu."
          }
        ]
      }
    ]
  }
}
