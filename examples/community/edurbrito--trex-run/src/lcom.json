{
  "version": 1,
  "name": "T-Rex Run: Brito",
  "description": "Jump over cacti and duck beneath birds in the Chrome-inspired runner.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "layout": "overlay",
      "pointer": "off",
      "toolbar": "top-right",
      "pads": [],
      "actions": [
        {
          "label": "Play",
          "key": "P",
          "position": "bottom-left"
        },
        {
          "label": "Jump",
          "key": "SPACE",
          "position": "bottom-right"
        },
        {
          "label": "Duck",
          "key": "DOWN",
          "position": "bottom-right"
        },
        {
          "label": "Scores",
          "key": "S",
          "position": "bottom-left"
        }
      ],
      "joystick": false,
      "look": false,
      "dpad": false
    }
  },
