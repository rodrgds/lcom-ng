{
  "version": 1,
  "name": "BowCannon",
  "mobile": {
    "orientation": "auto",
    "fullscreen": false,
    "controls": {
      "layout": "panel",
      "pointer": "move",
      "keyboard": true,
      "mouseButtons": false,
      "joystick": false,
      "dpad": false,
      "quickKeys": [
        "ESC",
        "ENTER",
        "SPACE"
      ],
      "actions": [
        {
          "label": "Fire / Select",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ],
      "pads": [
        {
          "side": "left",
          "mode": "wasd",
          "style": "dpad",
          "axes": "horizontal"
        },
        {
          "side": "right",
          "mode": "arrows",
          "style": "dpad",
          "axes": "horizontal"
        }
      ]
    }
  },
  "build": {
    "assets": []
  },
  "description": "Move both original cannons, aim the mouse and take turns firing across the battlefield.",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Start, then type each player's name or press Enter to skip. Aim with the mouse and left-click to fire; turns alternate between the cannons."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move left cannon",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Move right cannon",
            "bindings": [
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "Accept name or start",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ],
            "note": "Press twice to skip both names."
          },
          {
            "action": "Pause",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Opens the pause menu during a match."
          },
          {
            "action": "Continue",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ],
            "note": "Continues after the match ends or leaves the instructions screen."
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Aim cannon",
            "bindings": [
              {
                "label": "Mouse movement"
              }
            ]
          },
          {
            "action": "Fire or select",
            "bindings": [
              {
                "label": "Left click"
              }
            ],
            "note": "Fires during your turn and chooses menu items, including pause options."
          }
        ]
      }
    ]
  }
}
