{
  "version": 1,
  "name": "Jetpack Joyride: LCOM Edition",
  "description": "Fly past the original obstacles and collect coins.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER",
        "UP",
        "DOWN",
        "P"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "move",
      "tapDuration": 80,
      "toolbar": "top-right",
      "pads": [],
      "actions": [
        {
          "label": "Thrust",
          "key": "SPACE",
          "position": "bottom-right"
        },
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": [
      "data"
    ],
    "pathAliases": {
      "/home/lcom/labs/project": "."
    }
  },
  "archetype": "Jetpack Joyride",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Enter a username and password, pressing Enter after each, then choose PLAY. Hold thrust to fly through the obstacles and collect coins."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Thrust",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "Space"
                ]
              }
            ],
            "note": "Hold to rise."
          },
          {
            "action": "Pause",
            "bindings": [
              {
                "keys": [
                  "P"
                ]
              }
            ],
            "note": "Solo runs only."
          },
          {
            "action": "Back to menu",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Quits from the main menu."
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Thrust",
            "bindings": [
              {
                "label": "Hold left click"
              }
            ]
          },
          {
            "action": "Select menu item",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      },
      {
        "title": "Menus",
        "controls": [
          {
            "action": "Choose menu item",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Confirm",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              },
              {
                "keys": [
                  "Space"
                ]
              }
            ],
            "note": "Enter also submits each username and password field."
          },
          {
            "action": "Delete a character",
            "bindings": [
              {
                "keys": [
                  "Backspace"
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
