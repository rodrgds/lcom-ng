{
  "version": 1,
  "name": "Tron: Lightcycle Arena",
  "archetype": "Tron",
  "description": "Steer two lightcycles, leave bright trails and outlast the other riders in the original arena.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "2",
        "3",
        "4"
      ],
      "joystick": false,
      "pointer": "move",
      "layout": "panel",
      "pads": [
        {
          "mode": "wasd",
          "style": "dpad",
          "side": "left",
          "axes": "horizontal"
        },
        {
          "mode": "arrows",
          "style": "dpad",
          "side": "right",
          "axes": "horizontal"
        }
      ],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "side": "left"
        },
        {
          "label": "Start / Pause",
          "key": "SPACE",
          "side": "right"
        }
      ]
    }
  },
  "build": {
    "assets": [
      "imgs"
    ],
    "pathAliases": {
      "home/lcom/lcom1617-t4g12/proj/src": "."
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Choose a player count by clicking a menu button or pressing 2, 3 or 4. Steer your lightcycles and avoid crashing into trails."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Turn player 1",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Turn player 2",
            "bindings": [
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "Turn player 3",
            "bindings": [
              {
                "keys": [
                  "B"
                ]
              },
              {
                "keys": [
                  "M"
                ]
              }
            ],
            "note": "Three or four player games only."
          },
          {
            "action": "Start, pause or resume",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ]
          },
          {
            "action": "Return to menu",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Quits from the menu."
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Choose a menu option",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          },
          {
            "action": "Turn player 4",
            "bindings": [
              {
                "label": "Left button"
              },
              {
                "label": "Right button"
              }
            ],
            "note": "Four-player games only."
          }
        ]
      },
      {
        "title": "Menus",
        "controls": [
          {
            "action": "Choose player count",
            "bindings": [
              {
                "keys": [
                  "2"
                ]
              },
              {
                "keys": [
                  "3"
                ]
              },
              {
                "keys": [
                  "4"
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
