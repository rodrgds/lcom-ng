{
  "version": 1,
  "name": "Fruit Memory",
  "description": "Match pairs of colorful fruit cards.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "overlay",
      "pointer": "off",
      "toolbar": "top-right",
      "pads": [
        {
          "side": "left",
          "mode": "arrows",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Select",
          "key": "ENTER",
          "position": "bottom-right"
        }
      ],
      "repeatKeys": [
        "UP",
        "DOWN",
        "LEFT",
        "RIGHT"
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "archetype": "Memory",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Use the arrow keys to move the cursor to Start and press Enter. Flip two cards per turn and match every fruit pair."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move cursor",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              },
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ],
            "note": "Moves the cursor in menus and across the cards."
          },
          {
            "action": "Select",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ],
            "note": "Confirms a menu button or flips the highlighted card."
          },
          {
            "action": "Back or quit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Returns from Instructions to the menu; quits from the main menu."
          }
        ]
      }
    ]
  }
}
