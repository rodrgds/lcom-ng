{
  "version": 1,
  "name": "PongX",
  "mobile": {
    "orientation": "auto",
    "fullscreen": true,
    "controls": {
      "layout": "panel",
      "keyboard": false,
      "pointer": "move",
      "touchClick": false,
      "mouseButtons": false,
      "joystick": false,
      "quickKeys": [
        "ESC"
      ],
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad",
          "axes": "vertical"
        },
        {
          "mode": "wasd",
          "side": "right",
          "style": "dpad",
          "axes": "vertical",
          "keys": {
            "up": "O",
            "left": "J",
            "down": "K",
            "right": "L"
          }
        }
      ],
      "actions": [
        {
          "mouseButton": "left",
          "label": "Select",
          "position": "top-left"
        }
      ]
    }
  },
  "archetype": "Pong",
  "description": "Move both paddles through a timed match with the original ball, scores and RTC-driven speed changes.",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play to start the match. Move both paddles to keep the ball in play until the timer runs out."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move left paddle",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              }
            ]
          },
          {
            "action": "Move right paddle",
            "bindings": [
              {
                "keys": [
                  "O"
                ]
              },
              {
                "keys": [
                  "K"
                ]
              }
            ]
          },
          {
            "action": "End match",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Returns to the menu."
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Select menu item",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
