{
  "version": 1,
  "name": "Knights of LCOM",
  "description": "Play chess across a richly illustrated board.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER",
        "1",
        "2",
        "3"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "move",
      "tapDuration": 80,
      "toolbar": "top-right",
      "pads": [],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "archetype": "Chess",
  "icon": "icon.png",
  "preview": "preview.png"
}
