{
  "version": 1,
  "name": "Robot Arena",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "dpad": false,
      "layout": "overlay",
      "pointer": "drag",
      "toolbar": "top-right",
      "look": false,
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad",
          "axes": "both"
        }
      ],
      "touch": "move",
      "actions": [
        {
          "label": "Fire",
          "position": "bottom-right",
          "mouseButton": "left"
        },
        {
          "label": "Start",
          "position": "top-left",
          "key": "1"
        },
        {
          "label": "Quit",
          "position": "top-left",
          "key": "0"
        }
      ]
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": []
  },
  "description": "Navigate the arena and fire at your opponents while avoiding incoming shots.",
  "preview": "../../../../../collections/arcade/previews/diogosilva11-lcom-ed97fdb962ec.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Press 1 to start. Move your robot, aim with the mouse and shoot the other robots before they hit you."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Start",
            "bindings": [
              {
                "keys": [
                  "1"
                ]
              }
            ],
            "note": "From the main menu."
          },
          {
            "action": "Quit",
            "bindings": [
              {
                "keys": [
                  "0"
                ]
              }
            ],
            "note": "From the main menu."
          },
          {
            "action": "Leave the arena",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Aim",
            "bindings": [
              {
                "label": "Move mouse"
              }
            ]
          },
          {
            "action": "Fire",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
