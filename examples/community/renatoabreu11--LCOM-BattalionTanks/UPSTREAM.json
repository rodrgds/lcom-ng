  "sourcePatches": [
    {
      "path": "SOURCE_PATCH.diff",
      "files": [
        {
          "file": "Tanks/src/font.c",
          "originalSha256": "e781d0961b862b883b4bfccccabc587af160184ca105877999c46a49caf464e1",
          "patchedSha256": "637b58182c623745dfe30470647a510ebb4ccf37167b7a0732ab27a120caef2c",
          "reason": "Return the allocated and initialized object from InitFont. Falling off the pointer-returning constructor produces an indeterminate object pointer and traps during actual single-player drawing.",
          "verification": "Actual original browser single-player traps in drawTerrain; original constructor-boundary regression fails returned-object identity. Fixed actual-source constructors return allocated initialized Font/Bullet objects; browser menu, arrow movement and firing run without errors. Evidence build/arcade-100/c/tanks-return-{red,green}.log and touch-tanks-fixed.log."
        },
        {
          "file": "Tanks/src/bullet.c",
          "originalSha256": "47c025e2a4e70f2408034c3364d0267bc6589be1ae840fe3a662bee2ac947fc3",
          "patchedSha256": "f4870dd54936a259f8916495ed0082c3cc7e44b2837f5d3c91dedefc4d90dfe0",
          "reason": "Return the allocated and initialized object from CreateBullet. Falling off the pointer-returning constructor produces an indeterminate object pointer and traps during actual single-player drawing.",
          "verification": "Actual original browser single-player traps in drawTerrain; original constructor-boundary regression fails returned-object identity. Fixed actual-source constructors return allocated initialized Font/Bullet objects; browser menu, arrow movement and firing run without errors. Evidence build/arcade-100/c/tanks-return-{red,green}.log and touch-tanks-fixed.log."
        },
        {
          "file": "Tanks/src/main.c",
          "originalSha256": "441e4c625252803a0789e488eec97638edb4a11fd4464b998f256eebdc5be29e",
          "patchedSha256": "bd90f4be3abd73a76da13a85eb2b883351339b8c55f95af587941d366b34f777",
          "reason": "Fall back to stderr when the authored diagnostic log file cannot be opened. Original initLog passed NULL to fprintf and crashed before graphics when the relative log directory was absent or unavailable.",
          "verification": "Original configured native startup SIGSEGV before any presented frame; original actual-source fopen-failure regression alsoSIGSEGV. Fixed logger survives failed open, still initializes/writes a successfully opened log. Evidence build/arcade-100/c/tanks-log-red.log,tanks-source-green.log."
        },
        {
          "file": "Tanks/src/video_gr.c",
          "originalSha256": "d43045b747ba325a519d72ae127af0476767c4c3f146dcd424484d433a331530",
          "patchedSha256": "9dcf3fb2454be1fd65f768c9e453f63eda7d6fb7d47b3e59d41c5e32aa08b08f",
          "reason": "Return NULL from both failed BIOS initialization branches in the pointer-returning vg_init, instead of a bare return rejected by modern Clang.",
          "verification": "Original actual-source -Werror=return-type fails on both bare returns; fixed injected BIOS-call failure and VBE-mode-info failure both returnNULL without mapping video memory. Evidence build/arcade-100/c/tanks-bios-{red,green}.log."
        }
      ]
