{
  "version": 1,
  "name": "Type Racer: Sentence Sprint",
  "description": "Race the car by typing sentences accurately.",
  "build": {
    "assets": [
      "highscores.txt"
    ],
    "pathAliases": {
      "/home/lcom/labs/proj/src": "."
    }
  },
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "MINUS"
      ],
      "joystick": false,
      "pointer": "move",
      "touch": "tap",
      "layout": "overlay",
      "pads": [],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "bottom-right"
        },
        {
          "label": "Apostrophe",
          "key": "MINUS",
          "position": "top-right"
        }
      ]
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "archetype": "Typing",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Classic or Timed, then type the displayed sentence exactly. Each correct character moves the car forward."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Type the sentence",
            "bindings": [
              {
                "label": "Letter keys"
              }
            ],
            "note": "Match each character; Shift switches between lowercase and uppercase."
          },
          {
            "action": "Insert a space",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ]
          },
          {
            "action": "Type comma or period",
            "bindings": [
              {
                "keys": [
                  ","
                ]
              },
              {
                "keys": [
                  "."
                ]
              }
            ],
            "note": "Shift gives the colon and semicolon forms."
          },
          {
            "action": "Type apostrophe",
            "bindings": [
              {
                "keys": [
                  "Minus"
                ]
              }
            ],
            "note": "The apostrophe is on the Minus key."
          },
          {
            "action": "Delete mistakes",
            "bindings": [
              {
                "keys": [
                  "Backspace"
                ]
              }
            ],
            "note": "Removes wrong characters and clears the error block."
          },
          {
            "action": "Return to menu",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Leaves a run; on the results screen it opens score entry."
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Choose a game mode",
            "bindings": [
              {
                "label": "Left click"
              }
            ],
            "note": "Classic or Timed."
          },
          {
            "action": "Move cursor",
            "bindings": [
              {
                "label": "Move mouse"
              }
            ]
          }
        ]
      }
    ]
  }
}
