{
  "version": 1,
  "name": "Snake: Fruit Trail",
  "mobile": {
    "orientation": "auto",
    "fullscreen": true,
    "controls": {
      "layout": "panel",
      "keyboard": false,
      "pointer": "move",
      "touchClick": false,
      "mouseButtons": false,
      "joystick": false,
      "quickKeys": [
        "ESC"
      ],
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Start",
          "key": "SPACE",
          "position": "top-right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": "..",
    "assets": [
      "res"
    ],
    "pathAliases": {
      "/home/lcom/lcom1718-t1g04/project/res": "res"
    }
  },
  "archetype": "Snake",
  "icon": "icon.png",
  "preview": "preview.png",
  "description": "Steer the original green snake, eat fruit and grow across its white board.",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Press Space on the menu to start, or click Play. Steer the snake to eat fruit and grow."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Start",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ]
          },
          {
            "action": "Turn left",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              }
            ]
          },
          {
            "action": "Turn right",
            "bindings": [
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Turn up",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              }
            ]
          },
          {
            "action": "Turn down",
            "bindings": [
              {
                "keys": [
                  "S"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Menus",
        "controls": [
          {
            "action": "Open exit screen",
            "bindings": [
              {
                "keys": [
                  "P"
                ]
              }
            ]
          },
          {
            "action": "Quit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Choose menu option",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
