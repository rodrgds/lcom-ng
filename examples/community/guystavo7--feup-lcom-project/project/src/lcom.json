{
  "version": 1,
  "name": "Fruit Defense",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER"
      ],
      "joystick": false,
      "dpad": false,
      "layout": "overlay",
      "pointer": "direct",
      "cursor": {
        "x": 400,
        "y": 300,
        "maxX": 799,
        "maxY": 599
      },
      "toolbar": "top-right",
      "look": false,
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad",
          "axes": "both"
        }
      ],
      "actions": [
        {
          "label": "Use",
          "position": "bottom-right",
          "mouseButton": "left"
        },
        {
          "label": "Build / cancel",
          "position": "bottom-right",
          "mouseButton": "right"
        }
      ],
      "touchClick": false
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [
      "grupo_2leic13_2/project/resources/maps"
    ]
  },
  "description": "Place your defenders around the path and stop the enemies from getting through.",
  "preview": "../../../../../collections/arcade/previews/guystavo7-feup-lcom-project-912ca0851017.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click New Game, then Play on the level select screen. Place defenders beside the path and stop every enemy from reaching the end."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Pause",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Resume from the pause menu."
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Place or select",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          },
          {
            "action": "Open build menu or cancel",
            "bindings": [
              {
                "label": "Right click"
              }
            ],
            "note": "Right click opens the tower menu and cancels placement."
          }
        ]
      }
    ]
  }
}
