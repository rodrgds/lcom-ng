{
  "version": 1,
  "name": "Minix Asteroids",
  "description": "Survive falling asteroids and fire the ship’s recharging shots.",
  "build": {
    "assetRoot": ".",
    "assets": [],
    "environment": {
      "LCOM_VBE_PHYSICAL_BASE": "0xD0000000",
      "LCOM_AC97_PCM_BASE": "0xC0000000"
    }
  },
  "mobile": {
    "orientation": "auto",
    "fullscreen": false,
    "controls": {
      "layout": "panel",
      "keyboard": false,
      "mouseButtons": false,
      "joystick": false,
      "dpad": false,
      "look": false,
      "pointer": "move",
      "quickKeys": [
        "ESC"
      ],
      "actions": [
        {
          "label": "Fire",
          "key": "SPACE",
          "side": "right"
        }
      ],
      "repeatReleaseKeys": [
        "SPACE"
      ]
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions": {
    "sections": [
      {
        "title": "Get started",
        "text": "Move the ship with the mouse and fire with Space. Asteroids fall faster over time, so keep moving."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Fire",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ],
            "note": "Fires on press; four shots recharge over time."
          },
          {
            "action": "Exit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Move ship",
            "bindings": [
              {
                "label": "Mouse movement"
              }
            ]
          }
        ]
      }
    ]
  }
}
