{
  "version": 1,
  "name": "Plant Hero",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [],
      "joystick": {
        "mode": "wasd",
        "side": "left"
      },
      "layout": "overlay",
      "pointer": "move",
      "toolbar": "top-left",
      "actions": [
        {
          "position": "top-right",
          "label": "Start",
          "key": "1"
        },
        {
          "position": "top-right",
          "label": "Esc",
          "key": "ESC"
        },
        {
          "position": "bottom-right",
          "label": "Fire",
          "mouseButton": "left"
        }
      ]
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": []
  },
  "description": "Move through an underwater world and shoot your way past its enemies.",
  "preview": "../../../../../collections/arcade/previews/dsv8-feup-lcom-97a7235a6dfe.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Press 1 or click Play to start. Move with WASD and shoot the zombies before they reach you."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Start",
            "bindings": [
              {
                "keys": [
                  "1"
                ]
              }
            ],
            "note": "From the main menu."
          },
          {
            "action": "Back to the menu",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Fire",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          },
          {
            "action": "Choose a menu option",
            "bindings": [
              {
                "label": "Left click"
              }
            ],
            "note": "Move the pointer over a button first."
          }
        ]
      }
    ]
  }
}
