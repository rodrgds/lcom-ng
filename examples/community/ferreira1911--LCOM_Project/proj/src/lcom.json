{
  "version": 1,
  "name": "Aim Lab",
  "description": "Hit the targets in three shooting challenges.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "1",
        "2",
        "3"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "overlay",
      "pointer": "move",
      "toolbar": "top-right",
      "pads": [],
      "actions": [
        {
          "label": "Shoot",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Choose a challenge from the menu, or press 1, 2 or 3. Move the crosshair onto targets and shoot before time runs out."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Start a challenge",
            "bindings": [
              {
                "keys": [
                  "1"
                ]
              },
              {
                "keys": [
                  "2"
                ]
              },
              {
                "keys": [
                  "3"
                ]
              }
            ],
            "note": "From the menu."
          },
          {
            "action": "Back to menu or exit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Aim",
            "bindings": [
              {
                "label": "Move mouse"
              }
            ]
          },
          {
            "action": "Shoot",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
