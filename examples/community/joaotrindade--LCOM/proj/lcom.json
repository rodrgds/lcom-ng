{
  "version": 1,
  "name": "Space Impact: Horizontal Patrol",
  "build": {
    "assets": [
      "highscores"
    ],
    "pathAliases": {
      "/usr/src/drivers/proj": "."
    },
    "environment": {
      "LCOM_VBE_PHYSICAL_BASE": "0xD0000000",
      "LCOM_AC97_PCM_BASE": "0xC0000000"
    }
  },
  "mobile": {
    "orientation": "auto",
    "controls": {
      "layout": "panel",
      "pointer": "off",
      "keyboard": true,
      "joystick": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER"
      ],
      "pads": [
        {
          "side": "left",
          "mode": "arrows",
          "style": "dpad",
          "axes": "vertical"
        }
      ],
      "actions": [
        {
          "key": "SPACE",
          "label": "Select / Fire",
          "position": "top-right"
        }
      ],
      "repeatKeys": [
        "UP",
        "DOWN"
      ]
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "description": "Steer a starship through horizontal enemy waves, fire missiles and save a high score.",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Choose New Game with Up and Down, then press Space. Fly through the enemy waves and fire to build a score."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move or choose menu option",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              }
            ],
            "note": "Up and Down also navigate the menu before a game starts."
          },
          {
            "action": "Fire or confirm",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ],
            "note": "Fires during play and confirms menu choices."
          },
          {
            "action": "End run",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Opens the high-score name entry."
          },
          {
            "action": "Type name",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              }
            ],
            "note": "Any letter key; Enter saves the name."
          }
        ]
      }
    ]
  }
}
