{
  "version": 1,
  "name": "Space Impact: Horizontal Patrol",
  "build": {
    "assets": [
      "highscores"
    ],
    "pathAliases": {
      "/usr/src/drivers/proj": "."
    },
    "environment": {
      "LCOM_VBE_PHYSICAL_BASE": "0xD0000000",
      "LCOM_AC97_PCM_BASE": "0xC0000000"
    }
  },
  "mobile": {
    "orientation": "auto",
    "controls": {
      "layout": "panel",
      "pointer": "off",
      "keyboard": true,
      "joystick": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER"
      ],
      "pads": [
        {
          "side": "left",
          "mode": "arrows",
          "style": "dpad",
          "axes": "vertical"
        }
      ],
      "actions": [
        {
          "key": "SPACE",
          "label": "Select / Fire",
          "position": "top-right"
        }
      ],
      "repeatKeys": [
        "UP",
        "DOWN"
      ]
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "description": "Steer a starship through horizontal enemy waves, fire missiles and save a high score."
}
