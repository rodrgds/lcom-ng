{
  "version": 1,
  "name": "Pullball",
  "description": "Pull back to aim a bouncing ball at descending blocks in the original mouse-driven board.",
  "mobile": {
    "orientation": "auto",
    "fullscreen": true,
    "controls": {
      "layout": "panel",
      "keyboard": false,
      "pointer": "move",
      "touchClick": false,
      "mouseButtons": false,
      "joystick": false,
      "quickKeys": [
        "ESC",
        "BACKSPACE"
      ],
      "pads": [
        {
          "mode": "mouse",
          "side": "right",
          "style": "stick"
        }
      ],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "top-left"
        },
        {
          "label": "Pull",
          "mouseButton": "right",
          "position": "bottom-left"
        },
        {
          "label": "Menu Up",
          "key": "UP",
          "position": "top-right"
        },
        {
          "label": "Menu Down",
          "key": "DOWN",
          "position": "bottom-right"
        },
        {
          "label": "Confirm",
          "key": "ENTER",
          "position": "top-left"
        }
      ]
    }
  },
  "build": {
    "assets": [],
    "pathAliases": {
      "/z.txt": "bestScores.txt"
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play to start. Hold the right mouse button and pull back to aim, then release to launch the ball at the blocks."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move menu selection",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Confirm",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Back from highscores",
            "bindings": [
              {
                "keys": [
                  "Backspace"
                ]
              }
            ]
          },
          {
            "action": "Menu / exit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Returns to the menu during a round; exits from the menu."
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Pull and launch",
            "bindings": [
              {
                "label": "Hold right click and drag back, then release"
              }
            ],
            "note": "Release to shoot in the opposite direction."
          },
          {
            "action": "Select menu option",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
