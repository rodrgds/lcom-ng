{
  "version": 1,
  "name": "Mouse Maze",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "P",
        "M"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "overlay",
      "pointer": "move",
      "toolbar": "top-right",
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad"
        },
        {
          "mode": "mouse",
          "side": "right",
          "style": "stick"
        }
      ],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "top-left"
        }
      ],
      "repeatKeys": [
        "W",
        "A",
        "S",
        "D"
      ]
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [
      "proj/rec/images/YOU_WIN_100s.bmp",
      "proj/rec/images/GAME_MODE.bmp",
      "proj/rec/images/YOU_LOSE_NORMAL_100S.bmp",
      "proj/rec/images/MAIN_TITLE.bmp",
      "proj/rec/images/YOU_LOSE_NORMAL_0S.bmp",
      "proj/rec/images/YOU_WIN_0S.bmp",
      "proj/rec/images/game-background.bmp",
      "proj/rec/images/Main/ExitButtonRed.bmp",
      "proj/rec/images/Main/PlayButtonRed.bmp",
      "proj/rec/images/Main/ExitButtonBlue.bmp",
      "proj/rec/images/Main/PlayButtonBlue.bmp",
      "proj/rec/images/Choose/BLUE_BUTTONS/NORMAL_WITH_KBD_BLUE.bmp",
      "proj/rec/images/Choose/BLUE_BUTTONS/NIGHT_WITH_MOUSE_BLUE.bmp",
      "proj/rec/images/Choose/BLUE_BUTTONS/NIGHT_WITH_KBD_BLUE.bmp",
      "proj/rec/images/Choose/BLUE_BUTTONS/NORMAL_WITH_MOUSE_BLUE.bmp",
      "proj/rec/images/Choose/RED_BUTTONS/NIGHT_WITH_MOUSE_RED.bmp",
      "proj/rec/images/Choose/RED_BUTTONS/NIGHT_WITH_KBD_RED.bmp",
      "proj/rec/images/Choose/RED_BUTTONS/NORMAL_WITH_KBD_RED.bmp",
      "proj/rec/images/Choose/RED_BUTTONS/NORMAL_WITH_MOUSE_RED.bmp"
    ],
    "pathAliases": {
      "/home/lcom/lcom1415-t3g07": "."
    }
  },
  "description": "Guide a blue square along a winding path before the time runs out.",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions": {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play, then choose mouse or keyboard control and a normal or night maze. Reach the finish before the timer runs out."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ],
            "note": "Keyboard control mode only."
          },
          {
            "action": "Switch control mode",
            "bindings": [
              {
                "keys": [
                  "M"
                ]
              }
            ]
          },
          {
            "action": "Toggle night",
            "bindings": [
              {
                "keys": [
                  "P"
                ]
              }
            ]
          },
          {
            "action": "Continue after win or loss",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Back to mode selection",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "During play it returns to the mode selection screen; Esc on the main menu quits."
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Choose a mode",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          },
          {
            "action": "Move the square",
            "bindings": [
              {
                "label": "Move mouse"
              }
            ],
            "note": "Mouse control mode only."
          }
        ]
      }
    ]
  }
}
