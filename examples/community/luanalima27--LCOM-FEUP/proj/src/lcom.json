{
  "version": 1,
  "name": "Star Defender",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER"
      ],
      "joystick": false,
      "dpad": false,
      "layout": "overlay",
      "pointer": "drag",
      "toolbar": "top-right",
      "look": false,
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad",
          "axes": "both"
        }
      ],
      "touch": "move",
      "actions": [
        {
          "label": "Fire",
          "position": "bottom-right",
          "mouseButton": "left"
        }
      ],
      "cursor": {
        "x": 0,
        "y": 0,
        "maxX": 784,
        "maxY": 584,
        "desktopScale": 1
      }
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [],
    "environment": {
      "LCOM_COMPAT_MOUSE_REPORTING": "1"
    }
  },
  "description": "Move your starfighter beneath the alien formation and return fire.",
  "preview": "../../../../../collections/arcade/previews/luanalima27-lcom-feup-eda1c5716f42.png",
  "archetype": "Space Invaders",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Choose Start, then pick a difficulty. Move your ship beneath the alien formation and shoot it down before it reaches you."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ],
            "note": "W and S also move the menu selection."
          },
          {
            "action": "Confirm",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Quit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Aim",
            "bindings": [
              {
                "label": "Move mouse"
              }
            ],
            "note": "Shots travel toward the cursor."
          },
          {
            "action": "Fire",
            "bindings": [
              {
                "label": "Left click"
              }
            ],
            "note": "Click above the ship to fire."
          }
        ]
      }
    ]
  }
}
