{
  "version": 1,
  "name": "2048",
  "description": "Slide and merge matching numbered tiles to reach 2048.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "overlay",
      "pointer": "off",
      "toolbar": "top-right",
      "pads": [
        {
          "mode": "arrows",
          "side": "left",
          "style": "dpad"
        }
      ],
      "actions": []
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [
      "proj/res"
    ],
    "pathAliases": {
      "/home/proj": "proj"
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Slide the tiles to merge matching numbers and reach 2048. Every move adds a new tile, so keep empty space open."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Slide tiles",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              },
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "End game",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Slide tiles",
            "bindings": [
              {
                "label": "Left-button drag"
              },
              {
                "label": "Direction pad"
              }
            ]
          }
        ]
      }
    ]
  }
}
