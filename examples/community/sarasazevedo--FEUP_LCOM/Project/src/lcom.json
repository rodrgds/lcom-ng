{
  "version": 1,
  "name": "Agalag",
  "description": "Pilot your ship and fight waves of aliens. Tap Stop to hold your position.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "BACKSPACE",
        "Q"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "overlay",
      "pointer": "move",
      "toolbar": "top-right",
      "pads": [
        {
          "side": "left",
          "mode": "wasd",
          "style": "dpad",
          "axes": "horizontal"
        }
      ],
      "actions": [
        {
          "label": "Fire",
          "key": "SPACE",
          "position": "bottom-right"
        },
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "top-right"
        },
        {
          "label": "Stop",
          "key": "S",
          "position": "bottom-right"
        }
      ],
      "tapDuration": 65,
      "repeatKeys": [
        "SPACE"
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "archetype": "Galaga",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play to launch a round. Destroy the alien waves before they reach the bottom."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move left",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              }
            ]
          },
          {
            "action": "Move right",
            "bindings": [
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Stop",
            "bindings": [
              {
                "keys": [
                  "S"
                ]
              }
            ]
          },
          {
            "action": "Fire",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ]
          },
          {
            "action": "Return to menu",
            "bindings": [
              {
                "keys": [
                  "Backspace"
                ]
              },
              {
                "keys": [
                  "Q"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Select menus and fire",
            "bindings": [
              {
                "label": "Left click"
              },
              {
                "label": "Select button"
              }
            ],
            "note": "During play, clicking fires."
          }
        ]
      }
    ]
  }
}
