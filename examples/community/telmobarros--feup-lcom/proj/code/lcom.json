{
  "version": 1,
  "name": "Battle Tetris",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "move",
      "toolbar": "top-right",
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad",
          "axes": "horizontal"
        },
        {
          "mode": "arrows",
          "side": "right",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "top-left"
        },
        {
          "label": "Jump",
          "key": "W",
          "position": "bottom-left"
        },
        {
          "label": "Swap",
          "key": "SPACE",
          "position": "bottom-right"
        }
      ],
      "repeatKeys": [
        "LEFT",
        "RIGHT",
        "DOWN"
      ]
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [
      "proj/code/img"
    ],
    "pathAliases": {}
  },
  "description": "Stack, rotate and swap falling pieces, or challenge a jumping character in Battle mode.",
  "archetype": "Tetris",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click a game mode in the menu to start. Clear complete lines; in Battle, also move and jump your character."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move piece",
            "bindings": [
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "Rotate piece",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              }
            ]
          },
          {
            "action": "Soft drop",
            "bindings": [
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Swap piece",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ],
            "note": "Once per piece."
          },
          {
            "action": "Back / exit round",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Battle mode",
        "controls": [
          {
            "action": "Move character",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Jump",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Choose menu option",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
