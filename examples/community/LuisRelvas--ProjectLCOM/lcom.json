{
  "name": "El Memory",
  "description": "Match every pair of cards in the original memory game.",
  "archetype": "Memory",
  "mobile": {
    "fullscreen": true,
    "orientation": "auto",
    "controls": {
      "pointer": "drag",
      "touch": "tap",
      "tapDuration": 60,
      "keyboard": false,
      "joystick": false,
      "mouseButtons": false,
      "layout": "panel",
      "quickKeys": [],
      "touchClick": false,
      "actions": [
        {
          "side": "right",
          "label": "Reveal",
          "mouseButton": "left"
        },
        {
          "side": "right",
          "label": "Menu",
          "key": "S"
        },
        {
          "side": "right",
          "label": "New game",
          "key": "R"
        },
        {
          "side": "right",
          "label": "Quit",
          "key": "Q"
        }
      ]
    }
  },
  "version": 1,
  "icon": "icon.png",
  "preview": "preview.png",
  "build": {
    "assets": []
  },
  "instructions": {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Start, choose a difficulty, then click cards to reveal them. Match every pair to win."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Menu",
            "bindings": [
              {
                "keys": [
                  "S"
                ]
              }
            ]
          },
          {
            "action": "New game",
            "bindings": [
              {
                "keys": [
                  "R"
                ]
              }
            ],
            "note": "During a game."
          },
          {
            "action": "Quit",
            "bindings": [
              {
                "keys": [
                  "Q"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Choose a menu option",
            "bindings": [
              {
                "label": "Left click"
              },
              {
                "label": "Tap"
              }
            ]
          },
          {
            "action": "Reveal a card",
            "bindings": [
              {
                "label": "Left click"
              },
              {
                "label": "Tap"
              }
            ]
          }
        ]
      }
    ]
  }
}
