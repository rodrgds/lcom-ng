{
  "name": "Legend of LCOM",
  "build": {
    "sources": [
      "LoLCOM.c",
      "vbe.c",
      "video_gr.c",
      "keyboard.c",
      "timer.c",
      "logic.c",
      "helper.c",
      "RTC.c",
      "mouse.c",
      "UART.c",
      "speaker.c"
    ],
    "assetRoot": "..",
    "assets": [
      "resources"
    ],
    "pathAliases": {
      "/tmp/resources": "resources"
    },
    "arguments": [
      "player1"
    ]
  },
  "mobile": {
    "fullscreen": false,
    "orientation": "auto",
    "controls": {
      "layout": "panel",
      "keyboard": false,
      "pointer": "off",
      "mouseButtons": false,
      "joystick": false,
      "dpad": false,
      "quickKeys": [
        "ESC",
        "ENTER",
        "J"
      ],
      "pads": [
        {
          "mode": "wasd",
          "style": "dpad",
          "side": "left"
        }
      ]
    }
  },
  "description": "Explore the original overworld, fight roaming enemies with your sword and protect Link’s hearts.",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions": {
    "sections": [
      {
        "title": "Get started",
        "text": "Choose a menu option with W and S, then press Enter to start. Explore with WASD and press J to swing your sword."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ],
            "note": "W and S also move the menu cursor."
          },
          {
            "action": "Sword",
            "bindings": [
              {
                "keys": [
                  "J"
                ]
              }
            ]
          },
          {
            "action": "Confirm or continue",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ],
            "note": "Starts the game; at game over, returns to the menu."
          },
          {
            "action": "Back",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Leaves play for the menu; exits from the menu."
          }
        ]
      }
    ]
  }
}
