{
  "version": 1,
  "name": "Racemania",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "layout": "overlay",
      "keyboard": false,
      "pointer": "direct",
      "touchClick": true,
      "mouseButtons": false,
      "joystick": false,
      "quickKeys": [
        "ESC"
      ],
      "pads": [],
      "actions": [
        {
          "label": "Accelerate",
          "key": "W",
          "icon": "accelerator",
          "position": "bottom-left"
        },
        {
          "label": "Reverse",
          "key": "S",
          "icon": "reverse",
          "position": "bottom-left"
        },
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "top-right"
        }
      ],
      "touch": "hold-drag",
      "tapDuration": 120,
      "cursor": {
        "x": 200,
        "y": 22,
        "minX": 0,
        "minY": 0,
        "maxX": 1151,
        "maxY": 863
      }
    }
  },
  "build": {
    "assets": [
      "assets/records.txt"
    ],
    "pathAliases": {
      "/home/lcom/labs/g6/proj/src": "."
    }
  },
  "icon": "icon.png",
  "description": "Choose either circuit, accelerate and steer a red car with the original drag stick.",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Single Player and choose a circuit. Hold W to accelerate, then drag the red stick to steer around the track."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Accelerate",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              }
            ],
            "note": "Hold to keep accelerating."
          },
          {
            "action": "Reverse",
            "bindings": [
              {
                "keys": [
                  "S"
                ]
              }
            ],
            "note": "Hold to slow down and reverse."
          },
          {
            "action": "Pause",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Steer",
            "bindings": [
              {
                "label": "Drag the red stick"
              }
            ],
            "note": "Hold the left button on the stick and drag."
          },
          {
            "action": "Select",
            "bindings": [
              {
                "label": "Left click"
              }
            ],
            "note": "Chooses menu and pause options."
          }
        ]
      }
    ]
  }
}
