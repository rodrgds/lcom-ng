{
  "version": 1,
  "name": "LCOMBAT",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "UP",
        "DOWN",
        "ENTER",
        "ESC"
      ],
      "joystick": false,
      "dpad": false,
      "layout": "overlay",
      "pointer": "direct",
      "cursor": {
        "x": 400,
        "y": 300,
        "maxX": 799,
        "maxY": 599
      },
      "toolbar": "top-right",
      "look": false,
      "pads": [
        {
          "mode": "arrows",
          "side": "left",
          "style": "dpad",
          "axes": "horizontal"
        }
      ],
      "actions": [
        {
          "label": "Jump / Fire",
          "position": "bottom-right",
          "key": "SPACE"
        },
        {
          "label": "Bazooka",
          "position": "bottom-right",
          "key": "1"
        },
        {
          "label": "Grenade",
          "position": "bottom-right",
          "key": "2"
        },
        {
          "label": "Unequip",
          "position": "bottom-right",
          "key": "Q"
        }
      ]
    }
  },
  "build": {
    "assetRoot": "..",
    "assets": []
  },
  "description": "Move across the terrain, line up a shot and battle the opposing team.",
  "preview": "../../../../collections/arcade/previews/worms-d4885e74d5cb.png",
  "archetype": "Worms",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Press Enter, then choose Play. Click a worm to take control; hold Space to charge and release to fire."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "Jump or aim",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              }
            ],
            "note": "Up jumps; with a weapon equipped, Up and Down change the aim angle."
          },
          {
            "action": "Charge and fire",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ],
            "note": "Hold to build power, release to fire."
          },
          {
            "action": "Equip bazooka or grenade",
            "bindings": [
              {
                "keys": [
                  "1"
                ]
              },
              {
                "keys": [
                  "2"
                ]
              }
            ]
          },
          {
            "action": "Pause",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          },
          {
            "action": "Quit",
            "bindings": [
              {
                "keys": [
                  "Q"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Select a worm or menu item",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
