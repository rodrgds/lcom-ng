{
  "version": 1,
  "name": "Asteroid Watch",
  "description": "Aim the rotating ship with the pointer, move with WASD and break apart incoming asteroids.",
  "mobile": {
    "orientation": "auto",
    "fullscreen": true,
    "controls": {
      "layout": "panel",
      "keyboard": true,
      "pointer": "move",
      "touchClick": false,
      "mouseButtons": false,
      "joystick": false,
      "quickKeys": [
        "ESC",
        "ENTER"
      ],
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Fire / Select",
          "mouseButton": "left",
          "position": "top-right"
        }
      ]
    }
  },
  "build": {
    "assets": [],
    "pathAliases": {
      "/home/lcom/labs/proj/src": "."
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "archetype": "Asteroids"
}
