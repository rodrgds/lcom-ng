{
  "version": 1,
  "name": "Asteroid Watch",
  "description": "Aim the rotating ship with the pointer, move with WASD and break apart incoming asteroids.",
  "mobile": {
    "orientation": "auto",
    "fullscreen": true,
    "controls": {
      "layout": "panel",
      "keyboard": true,
      "pointer": "move",
      "touchClick": false,
      "mouseButtons": false,
      "joystick": false,
      "quickKeys": [
        "ESC",
        "ENTER"
      ],
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Fire / Select",
          "mouseButton": "left",
          "position": "top-right"
        }
      ]
    }
  },
  "build": {
    "assets": [],
    "pathAliases": {
      "/home/lcom/labs/proj/src": "."
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "archetype": "Asteroids",
  "instructions": {
    "sections": [
      {
        "title": "Get started",
        "text": "Choose Play from the menu. Move with WASD and aim with the pointer, then fire to break apart the asteroids."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Move menu selection",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              }
            ],
            "note": "Menus use W and S."
          },
          {
            "action": "Confirm",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Back to menu",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Aim",
            "bindings": [
              {
                "label": "Move the mouse"
              },
              {
                "label": "Drag"
              }
            ]
          },
          {
            "action": "Fire / select",
            "bindings": [
              {
                "label": "Left click"
              },
              {
                "label": "Tap"
              }
            ],
            "note": "Hold to keep firing; clicks also confirm menu options."
          }
        ]
      }
    ]
  }
}
