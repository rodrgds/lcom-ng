{
  "version": 1,
  "name": "LCOMaze",
  "icon": "../../../../collections/arcade/icons/lcomaze.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "dpad": false,
      "layout": "overlay",
      "pointer": "drag",
      "repeatKeys": [
        "W",
        "A",
        "S",
        "D"
      ],
      "toolbar": "top-right",
      "look": false,
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad",
          "axes": "both"
        }
      ],
      "actions": [
        {
          "label": "Aim",
          "position": "bottom-right",
          "mouseButton": "left"
        }
      ],
      "cursor": {
        "x": 0,
        "y": 0,
        "maxX": 1133,
        "maxY": 834,
        "desktopScale": 0.5,
        "desktopFractional": true
      }
    }
  },
  "build": {
    "assetRoot": "..",
    "assets": [],
    "arguments": [
      "host"
    ]
  },
  "description": "Explore the maze one corridor at a time and find your way through.",
  "preview": "../../../../collections/arcade/previews/henriquesfernandes-lcomaze-e2d54c32196a.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click SinglePlayer or MultiPlayer on the menu, then find the far side of the maze. The view only lights the area around you."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ],
            "note": "Relative to where the player faces."
          },
          {
            "action": "Back to menu",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Aim",
            "bindings": [
              {
                "label": "Hold left click"
              }
            ],
            "note": "Turns the player toward the pointer."
          },
          {
            "action": "Choose menu item",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
