{
  "version": 1,
  "name": "Pixel Football",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "UP",
        "DOWN",
        "ENTER",
        "ESC"
      ],
      "joystick": false,
      "dpad": false,
      "layout": "overlay",
      "pointer": "drag",
      "toolbar": "top-right",
      "look": false,
      "pads": [
        {
          "mode": "arrows",
          "side": "left",
          "style": "dpad",
          "axes": "horizontal"
        }
      ],
      "actions": [
        {
          "label": "Jump",
          "position": "bottom-right",
          "key": "UP"
        },
        {
          "label": "Kick",
          "position": "bottom-right",
          "key": "DOWN"
        }
      ],
      "cursor": {
        "x": 400,
        "y": 300,
        "maxX": 799,
        "maxY": 599,
        "desktopScale": 1
      }
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": []
  },
  "description": "Jump, kick and chase the ball in a two-player pixel football match.",
  "preview": "../../../../../collections/arcade/previews/gsilva00-lcom-project-4c94e7405c90.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Choose Singleplayer or Multiplayer with Up and Down, then press Enter. Multiplayer connects two machines over the serial port."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "Jump or menu up",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              }
            ]
          },
          {
            "action": "Kick or menu down",
            "bindings": [
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Select",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Pause",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Singleplayer only."
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Choose a menu item",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
