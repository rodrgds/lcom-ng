{
  "version": 1,
  "name": "Dinosaur Memory",
  "description": "Find matching dinosaurs across three difficulty levels.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "E",
        "M",
        "H",
        "B",
        "Q"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "overlay",
      "pointer": "off",
      "toolbar": "top-right",
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Reveal",
          "key": "ENTER",
          "position": "bottom-right"
        }
      ],
      "repeatKeys": [
        "W",
        "A",
        "S",
        "D"
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "archetype": "Memory",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Press E, M or H on the title screen to start on Easy, Medium or Hard. Reveal two dinosaurs per turn and match every pair."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move selection",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Reveal card",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Return to menu",
            "bindings": [
              {
                "keys": [
                  "B"
                ]
              }
            ]
          },
          {
            "action": "Quit",
            "bindings": [
              {
                "keys": [
                  "Q"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Menus",
        "controls": [
          {
            "action": "Start Easy",
            "bindings": [
              {
                "keys": [
                  "E"
                ]
              }
            ]
          },
          {
            "action": "Start Medium",
            "bindings": [
              {
                "keys": [
                  "M"
                ]
              }
            ]
          },
          {
            "action": "Start Hard",
            "bindings": [
              {
                "keys": [
                  "H"
                ]
              }
            ]
          },
          {
            "action": "Results menu",
            "bindings": [
              {
                "keys": [
                  "M"
                ]
              }
            ],
            "note": "On the results screen only."
          },
          {
            "action": "Play again",
            "bindings": [
              {
                "keys": [
                  "P"
                ]
              }
            ],
            "note": "On the results screen only."
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Reveal card or choose difficulty",
            "bindings": [
              {
                "label": "Left click"
              }
            ],
            "note": "Clicks title-screen buttons and face-down cards."
          },
          {
            "action": "Return to menu",
            "bindings": [
              {
                "label": "Right click"
              },
              {
                "label": "Middle click"
              }
            ]
          }
        ]
      }
    ]
  }
}
