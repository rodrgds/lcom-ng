+static int mouse_command_ack(void) {
+    unsigned long status, reply;
+    do {
+        if (sys_inb(STAT_REG, &status) != OK) return 1;
+    } while ((status & OBF) == 0);
+    if (sys_inb(OUT_BUFF, &reply) != OK) return 1;
+    return reply == 0xFA ? 0 : 1;
+}
