{
  "version": 1,
  "name": "Pew Pew: Platform Duel",
  "description": "Two players swap shooter and runner roles in a timed platform arena.",
  "mobile": {
    "orientation": "landscape",
    "controls": {
      "layout": "panel",
      "keyboard": false,
      "quickKeys": [
        "ESC"
      ],
      "pointer": "move",
      "touchClick": false,
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "stick"
        },
        {
          "mode": "mouse",
          "side": "right",
          "style": "stick",
          "sensitivity": 1
        }
      ],
      "actions": [
        {
          "label": "Shoot / Select",
          "mouseButton": "left",
          "position": "top-right"
        },
        {
          "label": "P2 Left",
          "key": "J",
          "position": "bottom-left"
        },
        {
          "label": "P2 Right",
          "key": "L",
          "position": "bottom-right"
        },
        {
          "label": "P2 Jump",
          "key": "I",
          "position": "top-left"
        },
        {
          "label": "Jump",
          "key": "SPACE",
          "position": "top-right"
        }
      ],
      "mouseButtons": false,
      "joystick": false,
      "dpad": false,
      "look": false
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions": {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Start, then click the game to capture the mouse. Players swap shooter and runner roles each round; the shooter aims with the crosshair and fires with left click."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Shooter left",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              }
            ]
          },
          {
            "action": "Shooter right",
            "bindings": [
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Shooter jump",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "Space"
                ]
              }
            ],
            "note": "The shooter role swaps between players each round."
          },
          {
            "action": "Runner left",
            "bindings": [
              {
                "keys": [
                  "J"
                ]
              }
            ]
          },
          {
            "action": "Runner right",
            "bindings": [
              {
                "keys": [
                  "L"
                ]
              }
            ]
          },
          {
            "action": "Runner jump",
            "bindings": [
              {
                "keys": [
                  "I"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Aim",
            "bindings": [
              {
                "label": "Move mouse"
              }
            ]
          },
          {
            "action": "Shoot",
            "bindings": [
              {
                "label": "Left click"
              }
            ],
            "note": "Only the current shooter can fire."
          }
        ]
      }
    ]
  }
}
