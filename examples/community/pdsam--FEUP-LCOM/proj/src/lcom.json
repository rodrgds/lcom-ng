{
  "version": 1,
  "name": "LTron",
  "description": "Two players steer light cycles and avoid the glowing trails.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "layout": "overlay",
      "pointer": "move",
      "toolbar": "top-right",
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad"
        },
        {
          "mode": "arrows",
          "side": "right",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "top-right"
        },
        {
          "label": "Orange boost",
          "key": "SPACE",
          "position": "bottom-left"
        },
        {
          "label": "Cyan boost",
          "key": "ENTER",
          "position": "bottom-right"
        },
        {
          "label": "Insert coin",
          "mouseButton": "right",
          "position": "top-left"
        },
        {
          "label": "Start / Pause",
          "key": "ESC",
          "position": "top-left"
        }
      ]
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [],
    "environment": {
      "LCOM_COMPAT_MOUSE_REPORTING": "1"
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Insert a coin with a right click, then click Local Mode. Player one drives with WASD, player two with the arrow keys; avoid the light trails."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Orange cycle turn",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Cyan cycle turn",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              },
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "Orange boost",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ]
          },
          {
            "action": "Cyan boost",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Start or pause",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Insert coin",
            "bindings": [
              {
                "label": "Right click"
              }
            ]
          },
          {
            "action": "Choose Local Mode",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
