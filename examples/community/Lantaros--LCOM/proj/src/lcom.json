{
  "version": 1,
  "name": "Plunder",
  "description": "Sail the original blue ship, fire its cannons and survive the pursuing sea monsters.",
  "mobile": {
    "orientation": "auto",
    "fullscreen": true,
    "controls": {
      "layout": "panel",
      "keyboard": false,
      "pointer": "move",
      "touchClick": false,
      "mouseButtons": false,
      "joystick": false,
      "quickKeys": [
        "ESC"
      ],
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad"
        },
        {
          "mode": "mouse",
          "side": "right",
          "style": "stick"
        }
      ],
      "actions": [
        {
          "label": "Port / Select",
          "mouseButton": "left",
          "position": "top-right"
        },
        {
          "label": "Starboard",
          "mouseButton": "right",
          "position": "top-right"
        }
      ]
    }
  },
  "build": {
    "sources": [
      "proj.c",
      "game.c",
      "boat.c",
      "timer.c",
      "kbd.c",
      "mouse.c",
      "vbe.c",
      "video.c",
      "video_gr.c",
      "bitmap.c",
      "obstacle.c",
      "enemy.c",
      "cannonball.c"
    ],
    "assetRoot": "..",
    "assets": [
      "resources"
    ],
    "pathAliases": {
      "/tmp/resources": "resources"
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click the button on the title screen to set sail. Sink the pursuing sea monsters with your port and starboard cannons."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Speed up",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              }
            ]
          },
          {
            "action": "Slow down",
            "bindings": [
              {
                "keys": [
                  "S"
                ]
              }
            ]
          },
          {
            "action": "Turn port",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              }
            ]
          },
          {
            "action": "Turn starboard",
            "bindings": [
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Quit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Fire port cannons",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          },
          {
            "action": "Fire starboard cannons",
            "bindings": [
              {
                "label": "Right click"
              }
            ]
          }
        ]
      }
    ]
  }
}
