{
  "version": 1,
  "name": "VS Draw",
  "mobile": {
    "orientation": "auto",
    "fullscreen": false,
    "controls": {
      "layout": "panel",
      "pointer": "drag",
      "keyboard": false,
      "mouseButtons": false,
      "joystick": false,
      "dpad": false,
      "quickKeys": [
        "ESC",
        "H",
        "M",
        "L"
      ],
      "actions": [
        {
          "label": "Draw",
          "key": "G",
          "position": "top-left"
        },
        {
          "label": "Pencil",
          "key": "P",
          "position": "top-right"
        },
        {
          "label": "Fill",
          "key": "B",
          "position": "top-left"
        },
        {
          "label": "Rectangle",
          "key": "R",
          "position": "top-right"
        },
        {
          "label": "Undo",
          "key": "K",
          "position": "bottom-left"
        },
        {
          "label": "Brush +",
          "key": "UP",
          "position": "top-right"
        },
        {
          "label": "Brush -",
          "key": "DOWN",
          "position": "bottom-left"
        },
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ]
    }
  },
  "build": {
    "assets": []
  },
  "description": "Draw, fill, undo, invert and convert your own picture with the original brush tools.",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Press G or click Draw to open the canvas. Pick a color and tool, then drag on the canvas to draw."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Enter drawing",
            "bindings": [
              {
                "keys": [
                  "G"
                ]
              }
            ]
          },
          {
            "action": "Pencil",
            "bindings": [
              {
                "keys": [
                  "P"
                ]
              }
            ]
          },
          {
            "action": "Rectangle",
            "bindings": [
              {
                "keys": [
                  "R"
                ]
              }
            ]
          },
          {
            "action": "Fill",
            "bindings": [
              {
                "keys": [
                  "B"
                ]
              }
            ]
          },
          {
            "action": "Back or exit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          },
          {
            "action": "Help",
            "bindings": [
              {
                "keys": [
                  "H"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Editing",
        "controls": [
          {
            "action": "Undo",
            "bindings": [
              {
                "keys": [
                  "K"
                ]
              }
            ]
          },
          {
            "action": "Invert colors",
            "bindings": [
              {
                "keys": [
                  "M"
                ]
              }
            ]
          },
          {
            "action": "Grayscale",
            "bindings": [
              {
                "keys": [
                  "L"
                ]
              }
            ]
          },
          {
            "action": "Increase brush size",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              }
            ]
          },
          {
            "action": "Decrease brush size",
            "bindings": [
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Choose color 1-8",
            "bindings": [
              {
                "keys": [
                  "1"
                ]
              },
              {
                "keys": [
                  "2"
                ]
              },
              {
                "keys": [
                  "3"
                ]
              },
              {
                "keys": [
                  "4"
                ]
              },
              {
                "keys": [
                  "5"
                ]
              },
              {
                "keys": [
                  "6"
                ]
              },
              {
                "keys": [
                  "7"
                ]
              },
              {
                "keys": [
                  "8"
                ]
              }
            ]
          },
          {
            "action": "Choose color 9",
            "bindings": [
              {
                "keys": [
                  "9"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Choose tool or color",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          },
          {
            "action": "Draw",
            "bindings": [
              {
                "label": "Left drag"
              }
            ]
          }
        ]
      }
    ]
  }
}
