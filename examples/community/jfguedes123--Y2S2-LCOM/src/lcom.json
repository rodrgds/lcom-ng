{
  "version": 1,
  "name": "Pong: Spin Rally",
  "description": "Return the ball and score in a local two-player rally.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "move",
      "tapDuration": 80,
      "toolbar": "top-right",
      "pads": [
        {
          "side": "left",
          "mode": "arrows",
          "style": "dpad",
          "axes": "vertical"
        }
      ],
      "actions": [
        {
          "label": "Player2 Up",
          "mouseButton": "left",
          "position": "bottom-right"
        },
        {
          "label": "Player2 Down",
          "mouseButton": "right",
          "position": "bottom-right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "archetype": "Pong",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Choose Play on the menu. Player 1 defends the left paddle and Player 2 the right in a local two-player rally."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move Player 1",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Move Player 2 up",
            "bindings": [
              {
                "label": "Hold left button"
              }
            ]
          },
          {
            "action": "Move Player 2 down",
            "bindings": [
              {
                "label": "Hold right button"
              }
            ]
          }
        ]
      },
      {
        "title": "Menus",
        "controls": [
          {
            "action": "Choose option",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Confirm",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Back or exit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
