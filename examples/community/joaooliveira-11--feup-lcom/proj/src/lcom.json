{
  "name": "FireBoy & WaterGirl: Elemental Labyrinth",
  "description": "Guide FireBoy and WaterGirl through the original maze, avoid elemental pools and open timed barriers with nearby levers.",
  "mobile": {
    "fullscreen": false,
    "orientation": "auto",
    "controls": {
      "layout": "panel",
      "pointer": "move",
      "keyboard": false,
      "mouseButtons": false,
      "joystick": false,
      "dpad": false,
      "quickKeys": [
        "Q"
      ],
      "repeatKeys": [
        "W",
        "A",
        "S",
        "D",
        "UP",
        "LEFT",
        "DOWN",
        "RIGHT"
      ],
      "pads": [
        {
          "side": "left",
          "mode": "wasd",
          "style": "dpad"
        },
        {
          "side": "right",
          "mode": "arrows",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Select / Lever",
          "mouseButton": "left",
          "side": "right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": [
      "game/draw/map.txt"
    ],
    "pathAliases": {
      "/home/lcom/labs/g1/proj/src": "."
    }
  },
  "archetype": "Fireboy and Watergirl",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play to begin. Guide WaterGirl and FireBoy to the exit while avoiding the pools that hurt each of them."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move WaterGirl",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Move FireBoy",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "Quit",
            "bindings": [
              {
                "keys": [
                  "Q"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Select or pull lever",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
