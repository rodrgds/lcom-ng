        },
        {
          "file": "proj/code/sprite.c",
          "reason": "Disabled collidingDoll body fell through non-void and moveDoll used its indeterminate result, preventing movement after optimization. Return no local collision; original active updateDaedalusCollision remains unchanged.",
          "originalSha256": "630b9d10f3b2594870f3569c7e001bbc99d706dd33b381379a638c688187ba88",
          "patchedSha256": "6a39dc37b2f0fb84d4f0d7270e6f32073608d3345a3a8e454c68fecdbeab94d2"
        },
        {
          "file": "proj/code/Daedalus.c",
          "reason": "Initialize the held direction flags when creating a game. Original malloc leaves all five flags indeterminate, so the first D/W event can also inherit random other held directions on native Android.",
          "originalSha256": "2238383abf2009eba8644e49e1807aa8a818887936b4185711ceeda5b3cc19bf",
          "patchedSha256": "a6c094f513e240708b1ab1ac97b126e03489fb61a91fe0b6c85414b969a8de91"
        },
        {
          "file": "proj/code/mouse.c",
          "reason": "Allocate the complete Crosshair object, rather than sizeof a pointer, before storing packet and Sprite fields. Release its owned Sprite/Bitmap as well as packet on destruction. Original allocation corrupts the following heap chunk on both 32-bit and 64-bit targets.",
          "originalSha256": "4bd349bb87df2fffef39297845e1368a87696193393bdf6d57e467845580ebe2",
          "patchedSha256": "4bd9f21fa8eabfb7c3a6a46509d770e79cb196475c3ebe2a372608578cd4fcfe"
        }
      ]
    }
  ],
