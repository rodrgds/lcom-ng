{
  "version": 1,
  "name": "Euler's Way",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [],
      "joystick": false,
      "dpad": {
        "side": "left",
        "keys": "arrows",
        "axes": "horizontal"
      },
      "look": false,
      "layout": "overlay",
      "pointer": "off",
      "toolbar": "top-left",
      "actions": [
        {
          "label": "Select / Fly",
          "key": "ENTER",
          "position": "bottom-right"
        },
        {
          "label": "Retry",
          "key": "R",
          "position": "top-right"
        },
        {
          "label": "Menu",
          "key": "M",
          "position": "top-right"
        },
        {
          "label": "Back",
          "key": "ESC",
          "position": "top-right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": []
  },
  "description": "Trace every route once across a galaxy of puzzle missions.",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Choose Play on the menu, then fly along every route exactly once. Left and Right choose the next planet and Enter flies there."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Choose planet",
            "bindings": [
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "Fly",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ],
            "note": "Also continues after a mission is complete."
          },
          {
            "action": "Retry mission",
            "bindings": [
              {
                "keys": [
                  "R"
                ]
              }
            ]
          },
          {
            "action": "Menu",
            "bindings": [
              {
                "keys": [
                  "M"
                ]
              }
            ]
          },
          {
            "action": "Back",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Menus",
        "controls": [
          {
            "action": "Highlight option",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Confirm",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Choose menu item",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
