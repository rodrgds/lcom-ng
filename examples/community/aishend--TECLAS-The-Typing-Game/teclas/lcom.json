{
  "version": 1,
  "name": "Teclas",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "quickKeys": [
        "SPACE",
        "ENTER",
        "BACKSPACE"
      ],
      "joystick": false,
      "pointer": "direct",
      "layout": "overlay",
      "cursor": {
        "x": 512,
        "y": 384,
        "maxX": 1023,
        "maxY": 767
      },
      "toolbar": "top-left",
      "actions": [
        {
          "position": "top-right",
          "label": "Esc",
          "key": "ESC"
        }
      ]
    }
  },
  "build": {
    "assetRoot": "..",
    "assets": [
      "teclas/results"
    ]
  },
  "description": "Type the words on screen and keep up with the next challenge.",
  "preview": "../../../../collections/arcade/previews/teclas-9e9acdbd5fab.png",
  "archetype": "Typing",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Press Space on the title screen, then choose a mode and start it from its settings screen. Type each word as it appears before time runs out."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Start or advance",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ],
            "note": "Starts from the title screen and moves to the next word."
          },
          {
            "action": "Type the words",
            "bindings": [
              {
                "label": "Letter keys"
              }
            ]
          },
          {
            "action": "Delete a letter",
            "bindings": [
              {
                "keys": [
                  "Backspace"
                ]
              }
            ]
          },
          {
            "action": "Back or exit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Choose a mode or setting",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
