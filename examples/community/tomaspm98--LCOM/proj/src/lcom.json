{
  "version": 1,
  "name": "Pong: Power Court",
  "description": "Play the original two-player Pong court and power-ups.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER",
        "SPACE"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "move",
      "tapDuration": 80,
      "toolbar": "top-right",
      "pads": [
        {
          "side": "left",
          "mode": "wasd",
          "style": "dpad",
          "axes": "vertical"
        },
        {
          "side": "right",
          "mode": "arrows",
          "style": "dpad",
          "axes": "vertical"
        }
      ],
      "actions": [
        {
          "label": "Select / Fire",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ],
      "repeatKeys": [
        "W",
        "S",
        "UP",
        "DOWN"
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "archetype": "Pong",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "The match starts immediately. Play until one side reaches three goals."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Player 1 up",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              }
            ],
            "note": "Hold to keep moving."
          },
          {
            "action": "Player 1 down",
            "bindings": [
              {
                "keys": [
                  "S"
                ]
              }
            ],
            "note": "Hold to keep moving."
          },
          {
            "action": "Player 2 up",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              }
            ],
            "note": "Hold to keep moving."
          },
          {
            "action": "Player 2 down",
            "bindings": [
              {
                "keys": [
                  "Down"
                ]
              }
            ],
            "note": "Hold to keep moving."
          },
          {
            "action": "Quit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
