        "controls": [
          {
            "action": "Build unit",
            "bindings": [
              {
                "keys": [
                  "J"
                ]
              },
              {
                "keys": [
                  "K"
                ]
              },
              {
                "keys": [
                  "L"
                ]
              }
            ]
          },
          {
            "action": "Build defense",
            "bindings": [
              {
                "keys": [
                  "U"
                ]
              },
              {
                "keys": [
                  "I"
                ]
              },
              {
                "keys": [
                  "O"
                ]
              }
            ]
          },
          {
            "action": "Evolve",
            "bindings": [
              {
                "keys": [
                  "M"
                ]
              }
            ]
          },
          {
            "action": "Use special",
            "bindings": [
              {
                "keys": [
                  "N"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Defenses and match",
        "controls": [
          {
            "action": "Sell a defense",
            "bindings": [
              {
                "keys": [
                  "R"
                ]
              },
              {
                "keys": [
                  "P"
                ]
              }
            ],
            "note": "R for player 1, P for player 2."
          },
          {
            "action": "Expand tower",
            "bindings": [
              {
                "keys": [
                  "T"
                ]
              },
              {
                "keys": [
                  "+"
                ]
              }
            ],
            "note": "T for player 1, + for player 2."
          },
          {
            "action": "Pause",
            "bindings": [
