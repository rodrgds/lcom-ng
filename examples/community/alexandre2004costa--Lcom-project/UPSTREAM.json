          "reason": "Release each removed bomb/bullet Sprite and its xpm_load pixel buffer."
        },
        {
          "path": "classes/Plane.c",
          "originalSha256": "fe4d3ea88b6e5f45affe2fcfc4dca97ff1a4dec7d80cf13505d4d745dbbeadd5",
          "patchedSha256": "2d23831780aa62cf645fbc2a951552da9bab1d8e7f20ae63c707a153c5b357c2",
          "reason": "freePlanes now releases each active plane object's sprite map, sprite struct and object, matching removePlane."
        },
        {
          "path": "classes/Sprite.c",
          "originalSha256": "38327c9cb98e02611ef8aed8de47f7ec72d8a171432352bb77c06586ef803d93",
          "patchedSha256": "9ced7396a850b71234967efbdd813b6aff4fad3e729a2280a05b57f57e5fa9f4",
