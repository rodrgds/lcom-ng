          "reason": "Enable mouse reporting through the existing acknowledged command before entering the event loop."
        },
        {
          "path": "model.c",
          "originalSha256": "89c30122dccef89dedf8cfd409cf947b029cc382f8c4a43c95080406e7487c98",
          "patchedSha256": "576c3f9a0a97c1a3bf11b964d712b1dda806d1ca3b2ce3028877814443e31457",
          "reason": "Move and click only after a complete three-byte packet so the previous Y or repeated previous X/Y cannot affect menu input. prepareGame frees every live bomb and bullet object, including its sprite map and sprite struct, before freeing the container arrays."
        },
        {
          "path": "classes/Bomb.c",
          "originalSha256": "86ed556b022eda1c66888669b2dedfd72df08877f4b33075d126ea9471c9135a",
