{
  "version": 1,
  "name": "Aerial Ambush",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "dpad": false,
      "layout": "overlay",
      "pointer": "drag",
      "touch": "move",
      "actions": [
        {
          "label": "Jump",
          "position": "bottom-right",
          "key": "SPACE"
        },
        {
          "label": "Fire",
          "position": "bottom-right",
          "mouseButton": "left"
        }
      ],
      "toolbar": "top-right",
      "look": false,
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad",
          "axes": "horizontal"
        }
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": [
      "home/lcom/labs/proj/game_results.txt"
    ],
    "environment": {
      "LCOM_COMPAT_MOUSE_REPORTING": "1"
    }
  },
  "description": "Jump, run and fire your way through a colorful side-scrolling battle.",
  "preview": "../../../collections/arcade/previews/alexandre2004costa-lcom-project-e3c159e09375.png"
}
