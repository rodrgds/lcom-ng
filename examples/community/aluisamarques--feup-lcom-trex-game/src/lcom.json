{
  "version": 1,
  "name": "T-Rex Run",
  "description": "Jump over cacti and duck under birds in the dinosaur runner.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "layout": "overlay",
      "pointer": "off",
      "toolbar": "top-right",
      "actions": [
        {
          "label": "Start / Restart",
          "key": "SPACE",
          "position": "bottom-right"
        },
        {
          "label": "Jump",
          "key": "UP",
          "position": "bottom-right"
        },
        {
          "label": "Duck",
          "key": "DOWN",
          "position": "bottom-left"
        }
      ],
      "pads": []
    }
  },
  "build": {
    "assetRoot": "..",
    "assets": [
      "src/high_score.txt"
    ]
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "archetype": "T-Rex Runner",
  "instructions": {
    "sections": [
      {
        "title": "Before your first run",
        "text": "Type a five-letter nickname, such as RODRI, then press Space. The game waits for all five letters before it can start."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Start / restart",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ]
          },
          {
            "action": "Jump",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              }
            ]
          },
          {
            "action": "Duck",
            "bindings": [
              {
                "keys": [
                  "Down"
                ]
              }
            ],
            "note": "Hold to stay low."
          }
        ]
      }
    ]
  }
}
