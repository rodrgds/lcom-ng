{
  "version": 1,
  "name": "Chess: Clock Duel",
  "description": "Play the original chess board with both clocks.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER",
        "UP",
        "DOWN"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "move",
      "tapDuration": 80,
      "toolbar": "top-right",
      "pads": [],
      "actions": [
        {
          "label": "Select / Fire",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "archetype": "Chess",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions": {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Single Machine, or press Enter on the menu. Click a piece and its destination, or type a rank and file."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Navigate menu",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Confirm",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Undo move",
            "bindings": [
              {
                "keys": [
                  "Z"
                ]
              }
            ]
          },
          {
            "action": "Deselect piece",
            "bindings": [
              {
                "keys": [
                  "Backspace"
                ]
              }
            ]
          },
          {
            "action": "Back to menu",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Quits from the main menu."
          },
          {
            "action": "Choose rank",
            "bindings": [
              {
                "keys": [
                  "1"
                ]
              },
              {
                "keys": [
                  "2"
                ]
              },
              {
                "keys": [
                  "3"
                ]
              },
              {
                "keys": [
                  "4"
                ]
              },
              {
                "keys": [
                  "5"
                ]
              },
              {
                "keys": [
                  "6"
                ]
              },
              {
                "keys": [
                  "7"
                ]
              },
              {
                "keys": [
                  "8"
                ]
              }
            ]
          },
          {
            "action": "Choose file",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "B"
                ]
              },
              {
                "keys": [
                  "C"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              },
              {
                "keys": [
                  "E"
                ]
              },
              {
                "keys": [
                  "F"
                ]
              },
              {
                "keys": [
                  "G"
                ]
              },
              {
                "keys": [
                  "H"
                ]
              }
            ],
            "note": "Rank 1-8 and file A-H select or move a piece."
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Select or move",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          },
          {
            "action": "Deselect piece",
            "bindings": [
              {
                "label": "Right click"
              }
            ]
          },
          {
            "action": "Menu buttons",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
