{
  "version": 1,
  "name": "Last Survivor: Outpost",
  "description": "Aim, fire and keep moving while enemy waves enter the original outpost.",
  "mobile": {
    "orientation": "auto",
    "fullscreen": false,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "move",
      "toolbar": "auto",
      "pads": [
        {
          "side": "left",
          "mode": "wasd",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Fire",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ],
      "tapDuration": 65
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play to enter the outpost. Move with WASD, aim with the mouse, and hold the left button to fire."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Leave match",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Aim",
            "bindings": [
              {
                "label": "Move mouse or drag"
              }
            ]
          },
          {
            "action": "Fire",
            "bindings": [
              {
                "label": "Hold left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
