      "path": "SOURCE_PATCH.diff",
      "files": [
        {
          "file": "proj/src/libs/graph/src/videocard.c",
          "reason": "32-bit Minix pointer portability on64-bit hosts: preserve actual byte offset without truncating framebuffer address through unsigned int. Original and repaired WASM32 renderers both pass.",
          "originalSha256": "c3af36a91ac284cb73334b1d0fabadcb2cb7dd5d238b75394279ab0a45dfde30",
          "patchedSha256": "451c0999282a70cf2dabdc2055536bd433b8370b5ad82e54b4b8ba66da5e29c1"
        },
        {
          "file": "proj/src/libs/graph/src/font.c",
          "reason": "Original font loader writes glyph98 beyond its98-slot allocation. Keep all supported glyphs in a zero-initialized99-slot table, use half-open iteration, and destroy only populated glyphs.",
          "originalSha256": "3433189fc36fe5a2beb3fd37e2609016843971837a87aad0aaf3c8483803c8e4",
          "patchedSha256": "6cf95e43aa692af7274be56cea0a1781cbdd82aa6868ab2419090d275e5176a1"
        },
        {
          "file": "proj/src/libs/graph/include/font_macros.h",
          "reason": "Count slots through authored bomb glyph index98, which requires99 entries.",
          "originalSha256": "95e8d6a2714f6be7015a9bd4b4f2ac5e73976e6e0ce6b1871575be37b016e413",
          "patchedSha256": "58639c4d2adaced595d928e947e8eb88669edca28fa330f6a82958a6eed44461"
        },
        {
          "file": "proj/src/project/src/game.c",
          "reason": "Original main menu allocates2button pointers then writes3buttons, corrupting heap before leaderboard construction. Allocate all3existing visible menu entries.",
          "originalSha256": "16b6fc5c28a0edbddd268187970f5b963056f632c4e8ebf1165055d16f4e5aa6",
          "patchedSha256": "76aa592d9c2b735d31d33d889edff0f57bad64f5e830ed074426fefda6465832"
        },
        {
          "file": "proj/src/project/src/leaderboard.c",
          "reason": "Original score save writes into a string literal, overflows/frees caller stack name, and score read frees a local array. Format unchanged fixed-width records in owned local buffers, preserve caller storage, bound reads, handle missing read file, and release every allocated sorted entry.",
          "originalSha256": "d6209bfba5a5001ddf7de3c896fdcfed42e27e0546548521155a0c1b612f9f9c",
          "patchedSha256": "409884537ebf6fe3302264e5c67abd704e777ca07ebde32eced5aa0c82b0b854"
        },
        {
          "path": "proj/src/libs/rtc/src/rtc.c",
          "originalSha256": "55087d6f8fceb3519eac9a62c36dbfcb34810085f2010f52a0b949ad0d95b89b",
          "patchedSha256": "c5869d6a3a04c2b5360e7c814c4de9cdacf00245c7672b892a5e52291090a92a",
          "reason": "the RTC weekday register is 1-based (7 for Saturday), but the switch handled 0..6 only, leaving the pointer uninitialized for strcpy in the menu; initialize it to a safe fallback"
        }
      ]
    }
  ],
