{
  "name": "Bomberman: Remote Arena",
  "description": "Move through the original arena, place bombs and click them to clear walls and enemies.",
  "mobile": {
    "orientation": "auto",
    "fullscreen": false,
    "controls": {
      "layout": "panel",
      "keyboard": true,
      "pointer": "move",
      "mouseButtons": false,
      "joystick": false,
      "dpad": false,
      "look": false,
      "quickKeys": [
        "ESC",
        "SPACE"
      ],
      "pads": [
        {
          "mode": "arrows",
          "style": "dpad",
          "side": "left",
          "keys": {
            "up": "W",
            "down": "S",
            "left": "A",
            "right": "D"
          }
        }
      ],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": [
      "leaderboard.txt"
    ],
    "pathAliases": {
      "home/lcom/labs/proj/src": "."
    }
  },
  "archetype": "Bomberman",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play the Game to start. Move through the maze, press Space to place a bomb, then click the bomb to detonate it."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              },
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              },
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "Place bomb",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ]
          },
          {
            "action": "Back",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Returns to the main menu."
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Aim",
            "bindings": [
              {
                "label": "Move the mouse or drag"
              }
            ]
          },
          {
            "action": "Select or detonate",
            "bindings": [
              {
                "label": "Left click or tap"
              }
            ],
            "note": "Click a placed bomb to explode it; also chooses menu items."
          }
        ]
      },
      {
        "title": "Menus",
        "controls": [
          {
            "action": "Save score",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ],
            "note": "Type your name after a win, then press Enter."
          },
          {
            "action": "Delete letter",
            "bindings": [
              {
                "keys": [
                  "Backspace"
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
