{
  "name": "Batalha Naval: Fleet Duel",
  "description": "Arrange two fleets on a shared screen, then trade shots in the original local battleship game.",
  "archetype": "Battleship",
  "mobile": {
    "fullscreen": false,
    "orientation": "auto",
    "controls": {
      "layout": "panel",
      "pointer": "off",
      "keyboard": false,
      "mouseButtons": false,
      "joystick": false,
      "dpad": false,
      "pads": [
        {
          "mode": "arrows",
          "style": "dpad",
          "side": "left"
        }
      ],
      "repeatReleaseKeys": [
        "UP",
        "DOWN",
        "LEFT",
        "RIGHT"
      ],
      "quickKeys": [
        "ESC",
        "ENTER"
      ],
      "actions": [
        {
          "key": "E",
          "label": "Next tile",
          "side": "right"
        },
        {
          "key": "R",
          "label": "Rotate",
          "side": "right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Choose Start, then each player places eight ships and confirms the handoff. Take turns moving the target and pressing Enter to fire."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move selection, ship, or target",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              },
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "Place ship, confirm, or fire",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Rotate ship",
            "bindings": [
              {
                "keys": [
                  "R"
                ]
              }
            ]
          },
          {
            "action": "Next free tile",
            "bindings": [
              {
                "keys": [
                  "E"
                ]
              }
            ]
          },
          {
            "action": "Return to menu",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
