{
  "version": 1,
  "name": "Thin Ice",
  "description": "Find a path across the melting ice and collect the key.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "Q",
        "H",
        "G"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "move",
      "tapDuration": 80,
      "toolbar": "top-right",
      "pads": [
        {
          "side": "left",
          "mode": "wasd",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ],
      "repeatKeys": [
        "W",
        "A",
        "S",
        "D"
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "archetype": "Thin Ice",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Start to begin. Guide the ball to collect the key and reach the exit before the ice melts."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ],
            "note": "Moves one tile per press."
          },
          {
            "action": "Restart from level 1",
            "bindings": [
              {
                "keys": [
                  "G"
                ]
              }
            ]
          },
          {
            "action": "Return to menu",
            "bindings": [
              {
                "keys": [
                  "H"
                ]
              }
            ]
          },
          {
            "action": "Quit",
            "bindings": [
              {
                "keys": [
                  "Q"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Choose menu button",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
