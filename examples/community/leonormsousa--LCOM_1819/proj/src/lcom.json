{
  "version": 1,
  "name": "Whack-a-Trump",
  "mobile": {
    "orientation": "auto",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "joystick": false,
      "quickKeys": [],
      "layout": "overlay",
      "pointer": "drag",
      "tapDuration": 80,
      "actions": [
        {
          "label": "Menu up",
          "key": "UP",
          "position": "top-left"
        },
        {
          "label": "Menu down",
          "key": "DOWN",
          "position": "top-left"
        },
        {
          "label": "Confirm",
          "key": "ENTER",
          "position": "top-right"
        },
        {
          "label": "Pause",
          "key": "P",
          "position": "top-right"
        },
        {
          "label": "Back",
          "key": "ESC",
          "position": "top-left"
        }
      ]
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [],
    "arguments": [
      "1"
    ]
  },
  "archetype": "Whack-a-Mole",
  "description": "Use Menu down and Confirm to choose Start Game, Singleplayer and Classic. Drag to aim and swat the rising figures.",
  "preview": "../../../../../collections/arcade/previews/leonormsousa-lcom-1819-7c210c5b0789.png",
  "icon": "icon.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Choose Start Game, Singleplayer, then Classic with Up and Down, pressing Enter on each choice. Drag the hammer over a rising figure and click to swat it."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Choose menu option",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Confirm",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          },
          {
            "action": "Move hammer",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Swat",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ]
          },
          {
            "action": "Pause",
            "bindings": [
              {
                "keys": [
                  "P"
                ]
              }
            ]
          },
          {
            "action": "Back",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Move hammer",
            "bindings": [
              {
                "label": "Move mouse or drag"
              }
            ]
          },
          {
            "action": "Swat",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
