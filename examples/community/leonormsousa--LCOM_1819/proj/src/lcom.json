{
  "version": 1,
  "name": "Whack-a-Trump",
  "mobile": {
    "orientation": "auto",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "joystick": false,
      "quickKeys": [],
      "layout": "overlay",
      "pointer": "drag",
      "tapDuration": 80,
      "actions": [
        {
          "label": "Menu up",
          "key": "UP",
          "position": "top-left"
        },
        {
          "label": "Menu down",
          "key": "DOWN",
          "position": "top-left"
        },
        {
          "label": "Confirm",
          "key": "ENTER",
