{
  "version": 1,
  "name": "Demon Slayer",
  "description": "Run through the castle, leap over monsters, fire magic and strike with your sword.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "pointer": "move",
      "layout": "overlay",
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Select / Fire",
          "mouseButton": "left",
          "position": "top-right"
        },
        {
          "label": "Sword",
          "mouseButton": "right",
          "position": "bottom-right"
        },
        {
          "label": "Jump",
          "key": "SPACE",
          "position": "bottom-right"
        },
        {
          "label": "Rage",
          "key": "R",
          "position": "top-left"
        }
      ],
      "repeatKeys": [
        "W",
        "A",
        "S",
        "D"
      ]
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [
      "proj/res"
    ],
    "pathAliases": {
      "home/lcom/labs/proj": "proj",
      "/home/lcom/labs/proj": "proj"
    },
    "environment": {
      "LCOM_COMPAT_MOUSE_REPORTING": "1"
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play on the title menu to enter the castle. Run with WASD, jump with Space, and use the mouse to attack."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Jump",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ]
          },
          {
            "action": "Rage",
            "bindings": [
              {
                "keys": [
                  "R"
                ]
              }
            ],
            "note": "Only when the rage bar is full."
          },
          {
            "action": "Pause",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Select or fire magic",
            "bindings": [
              {
                "label": "Left click or tap"
              }
            ],
            "note": "Left click selects menus and fires magic in the game."
          },
          {
            "action": "Sword",
            "bindings": [
              {
                "label": "Right click"
              }
            ],
            "note": "Only while standing on the ground."
          }
        ]
      }
    ]
  }
}
