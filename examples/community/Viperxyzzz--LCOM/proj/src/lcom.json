{
  "name": "Breakout: Brick Chase",
  "build": {
    "sources": [
      "animate_sprite.c",
      "background.c",
      "ball.c",
      "bricks.c",
      "game.c",
      "keyboard.c",
      "mouse.c",
      "proj.c",
      "rtc.c",
      "sprite.c",
      "timer.c",
      "utils.c",
      "videocard.c"
    ],
    "include": [],
    "assets": []
  },
  "mobile": {
    "fullscreen": false,
    "controls": {
      "layout": "panel",
      "keyboard": false,
      "pointer": "move",
      "quickKeys": [
        "ESC",
        "A",
        "D"
      ],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ],
      "mouseButtons": false,
      "joystick": false,
      "dpad": false,
      "look": false,
      "toolbar": "top-right"
    },
    "orientation": "auto"
  },
  "description": "Return the ball and clear the original brick wall.",
  "archetype": "Breakout",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play, then move the paddle to keep the ball in play and clear every brick."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move paddle",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ],
            "note": "Hold a key to keep moving."
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Move pointer",
            "bindings": [
              {
                "label": "Move mouse"
              },
              {
                "label": "Drag"
              }
            ]
          },
          {
            "action": "Choose Play or Exit",
            "bindings": [
              {
                "label": "Left click"
              },
              {
                "label": "Tap"
              }
            ]
          }
        ]
      }
    ]
  }
}
