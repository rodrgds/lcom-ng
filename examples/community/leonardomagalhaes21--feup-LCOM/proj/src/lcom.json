{
  "version": 1,
  "name": "Not Cuphead",
  "icon": "icon.png",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "dpad": false,
      "layout": "overlay",
      "pointer": "drag",
      "touch": "move",
      "actions": [
        {
          "label": "Jump",
          "position": "bottom-right",
          "key": "W"
        },
        {
          "label": "Fire",
          "position": "bottom-right",
          "mouseButton": "left"
        }
      ],
      "toolbar": "top-right",
      "keyboardPosition": "bottom",
      "look": false,
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad",
          "axes": "horizontal"
        }
      ]
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [
      "proj/src/scoreboard.txt"
    ]
  },
  "description": "Run, jump and shoot through a hand-drawn platform adventure.",
  "preview": "../../../../../collections/arcade/previews/leonardomagalhaes21-feup-lcom-9e3925b94730.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play on the menu. Run, jump and shoot through the hand-drawn level, aiming with the mouse."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Jump",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              }
            ]
          },
          {
            "action": "Exit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Menus",
        "controls": [
          {
            "action": "Save name",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ],
            "note": "Type a name on the score screen first."
          },
          {
            "action": "Delete name letter",
            "bindings": [
              {
                "keys": [
                  "Backspace"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Aim",
            "bindings": [
              {
                "label": "Move mouse"
              }
            ]
          },
          {
            "action": "Fire",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          },
          {
            "action": "Choose a menu item",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
