{
  "version": 1,
  "name": "Pong: Neon Court",
  "description": "Move both paddles through the original Pong court.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "off",
      "tapDuration": 80,
      "toolbar": "top-right",
      "pads": [
        {
          "side": "left",
          "mode": "wasd",
          "style": "dpad",
          "axes": "vertical"
        },
        {
          "side": "right",
          "mode": "arrows",
          "style": "dpad",
          "axes": "vertical"
        }
      ],
      "actions": [],
      "repeatKeys": [
        "W",
        "S",
        "UP",
        "DOWN"
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "archetype": "Pong",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "The match starts right away. Move the left paddle with W and S and the right paddle with Up and Down; the first player to send the ball past the other paddle scores."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move left paddle",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              }
            ],
            "note": "Hold a key to keep moving."
          },
          {
            "action": "Move right paddle",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              }
            ],
            "note": "Hold a key to keep moving."
          },
          {
            "action": "Quit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
