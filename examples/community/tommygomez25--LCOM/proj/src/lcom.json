{
  "version": 1,
  "name": "Snake: Grass Garden",
  "description": "Collect apples through the original grass garden.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "move",
      "tapDuration": 80,
      "toolbar": "top-right",
      "pads": [
        {
          "side": "left",
          "mode": "wasd",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": [
      "highscores.txt"
    ],
    "pathAliases": {
      "/home/lcom/labs/proj/src": "."
    }
  },
  "archetype": "Snake",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play, then steer the snake with WASD to collect apples. Avoid the walls and your own tail."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move up",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              }
            ]
          },
          {
            "action": "Move down",
            "bindings": [
              {
                "keys": [
                  "S"
                ]
              }
            ]
          },
          {
            "action": "Move left",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              }
            ]
          },
          {
            "action": "Move right",
            "bindings": [
              {
                "keys": [
                  "D"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Select menu item",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      },
      {
        "title": "Menus",
        "controls": [
          {
            "action": "Open name entry",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Press after losing to type your name."
          },
          {
            "action": "Save name",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ],
            "note": "Saves the score and returns to the menu."
          }
        ]
      }
    ]
  }
}
