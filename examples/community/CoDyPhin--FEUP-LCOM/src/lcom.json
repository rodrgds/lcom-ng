{
  "name": "Minix is Lava",
  "mobile": {
    "fullscreen": false,
    "orientation": "auto",
    "controls": {
      "layout": "panel",
      "keyboard": false,
      "pointer": "move",
      "mouseButtons": false,
      "joystick": false,
      "dpad": false,
      "look": false,
      "quickKeys": [
        "ESC",
        "ENTER",
        "D",
        "UP",
        "DOWN"
      ],
      "actions": [
        {
          "label": "Buy (Y)",
          "key": "Y",
          "position": "bottom-right"
        },
        {
          "label": "Skip (N)",
          "key": "N",
          "position": "bottom-right"
        }
      ]
    }
  },
  "description": "Roll the dice, move around the lava board and buy squares.",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Choose Start with Up and Down, then press Enter. Press D to roll, then buy the square with Y or skip it with N."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Roll dice",
            "bindings": [
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Buy square",
            "bindings": [
              {
                "keys": [
                  "Y"
                ]
              }
            ]
          },
          {
            "action": "Skip purchase",
            "bindings": [
              {
                "keys": [
                  "N"
                ]
              }
            ]
          },
          {
            "action": "Pause",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Choose Resume or Menu in the pause menu and press Enter."
          }
        ]
      },
      {
        "title": "Menus",
        "controls": [
          {
            "action": "Choose option",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Confirm",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
