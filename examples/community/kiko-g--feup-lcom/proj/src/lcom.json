{
  "version": 1,
  "name": "Space Lander",
  "description": "Pilot your spacecraft through asteroids and land safely on the platform.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "layout": "overlay",
      "pointer": "direct",
      "toolbar": "top-right",
      "actions": [
        {
          "label": "Thrust",
          "key": "SPACE",
          "position": "bottom-right"
        }
      ],
      "pads": [
        {
          "mode": "arrows",
          "side": "left",
          "style": "dpad",
          "axes": "horizontal"
        }
      ],
      "touch": "tap",
      "cursor": {
        "x": 512,
        "y": 200,
        "maxX": 1004,
        "maxY": 747
      }
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [
      "proj/src/hs.txt"
    ],
    "pathAliases": {
      "/home/lcom/labs/proj": "proj/src"
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play, then choose a level. Rotate and thrust to land gently on the platform."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Rotate",
            "bindings": [
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "Thrust",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ],
            "note": "Hold Space to keep boosting."
          },
          {
            "action": "End run",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Esc again on the results screen returns to the menu."
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Aim",
            "bindings": [
              {
                "label": "Move the mouse"
              }
            ]
          },
          {
            "action": "Select or fire",
            "bindings": [
              {
                "label": "Left click or tap"
              }
            ],
            "note": "In a run, fires a rocket toward the crosshair."
          }
        ]
      }
    ]
  }
}
