{
  "build": {
    "sources": [
      "main.c",
      "Modules/vg.c",
      "Modules/timer.c",
      "Modules/utils.c",
      "Modules/keyboard.c",
      "Modules/mouse.c",
      "Modules/states.c",
      "view/draw_functions.c",
      "controller/menu_controller.c",
      "controller/game_controller.c",
      "view/draw_game.c"
    ]
  },
  "name": "TypeRacer: Sentence Sprint",
  "mobile": {
    "fullscreen": false,
    "orientation": "auto",
    "controls": {
      "layout": "panel",
      "keyboard": true,
      "pointer": "move",
      "mouseButtons": false,
      "joystick": false,
      "dpad": false,
      "look": false,
      "quickKeys": [
        "ESC",
        "ENTER",
        "BACKSPACE",
        "UP",
        "DOWN"
      ],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ]
    }
  },
  "description": "Type the original displayed sentence and review your accuracy and score.",
  "icon": "icon.png",
  "preview": "preview.png",
  "archetype": "Typing",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Choose Easy or Hard with Up and Down, then press Enter. Type each displayed word and press Space to check it."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Type the word",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              }
            ],
            "note": "Any letter key; hold Shift for capitals and punctuation."
          },
          {
            "action": "Check word",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ]
          },
          {
            "action": "Delete last letter",
            "bindings": [
              {
                "keys": [
                  "Backspace"
                ]
              }
            ]
          },
          {
            "action": "End round or exit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Esc also exits from the menu."
          }
        ]
      },
      {
        "title": "Menus",
        "controls": [
          {
            "action": "Choose mode",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Confirm",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
