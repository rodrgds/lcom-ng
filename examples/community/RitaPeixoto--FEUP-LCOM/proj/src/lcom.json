{
  "version": 1,
  "name": "Get Lost",
  "description": "Guide the red ball through mazes, collect every star and reach the green exit.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "pointer": "move",
      "layout": "overlay",
      "pads": [
        {
          "mode": "arrows",
          "side": "left",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "top-right"
        }
      ],
      "repeatKeys": [
        "UP",
        "DOWN",
        "LEFT",
        "RIGHT"
      ]
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": []
  },
  "icon": "icon.png",
  "preview": "preview.png"
}
