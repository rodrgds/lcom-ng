{
  "version": 1,
  "name": "Walls: Split the Field",
  "description": "Build opposing walls around two bouncing balls and reduce each remaining region toward the original10percent goal.",
  "mobile": {
    "orientation": "auto",
    "fullscreen": true,
    "controls": {
      "layout": "panel",
      "keyboard": false,
      "pointer": "move",
      "touchClick": false,
      "mouseButtons": false,
      "joystick": false,
      "quickKeys": [
        "ESC"
      ],
      "pads": [
        {
          "mode": "mouse",
          "side": "right",
          "style": "stick"
        }
      ],
      "actions": [
        {
          "key": "1",
          "label": "Start",
          "position": "top-left"
        },
        {
          "mouseButton": "left",
          "label": "Draw",
          "position": "bottom-left"
        }
      ]
    }
  },
  "build": {
    "assets": []
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Press 1 to start. Hold the left button and drag to build two walls in opposite directions, then release to finish."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Start or resume",
            "bindings": [
              {
                "keys": [
                  "1"
                ]
              }
            ]
          },
          {
            "action": "Open menu",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Press 1 again to resume."
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Draw walls",
            "bindings": [
              {
                "label": "Hold left click and drag"
              }
            ],
            "note": "Release to stop drawing."
          }
        ]
      }
    ]
  }
}
