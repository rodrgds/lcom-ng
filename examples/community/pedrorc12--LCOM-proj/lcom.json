{
  "version": 1,
  "name": "Doodle Jump: Platform Climb",
  "description": "Bounce between platforms and climb as high as you can.",
  "mobile": {
    "fullscreen": false,
    "orientation": "auto",
    "controls": {
      "layout": "panel",
      "pointer": "off",
      "keyboard": false,
      "mouseButtons": false,
      "joystick": false,
      "dpad": false,
      "quickKeys": [
        "ESC",
        "ENTER"
      ],
      "pads": [
        {
          "mode": "arrows",
          "style": "dpad",
          "side": "left"
        }
      ],
      "repeatKeys": [
        "LEFT",
        "RIGHT"
      ],
      "actions": [
        {
          "key": "UP",
          "label": "Boost",
          "side": "right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": [],
    "arguments": [
      "115"
    ]
  },
  "icon": "icon.png",
  "archetype": "Doodle Jump",
  "preview": "preview.png",
  "instructions": {
    "sections": [
      {
        "title": "Get started",
        "text": "Choose Play and press Enter to start. Steer left and right, and boost upward to keep climbing the platforms."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Steer",
            "bindings": [
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ],
            "note": "Hold to keep moving."
          },
          {
            "action": "Boost",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              }
            ]
          },
          {
            "action": "Descend",
            "bindings": [
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Pause",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Menus",
        "controls": [
          {
            "action": "Move selection",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              }
            ]
          },
          {
            "action": "Confirm",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ],
            "note": "Starts the game and restarts after game over."
          },
          {
            "action": "Choose yes or no",
            "bindings": [
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ],
            "note": "On the exit confirmation dialog."
          }
        ]
      }
    ]
  }
}
