{
  "version": 1,
  "name": "One Shot",
  "description": "Explore the dungeon, pull its levers and open a path through the original puzzle rooms.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "pointer": "move",
      "layout": "overlay",
      "pads": [
        {
          "mode": "arrows",
          "side": "left",
          "style": "dpad"
        }
      ],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "top-right"
        },
        {
          "label": "Fire",
          "key": "SPACE",
          "position": "bottom-right"
        },
        {
          "label": "Use",
          "key": "E",
          "position": "bottom-right"
        }
      ],
      "touch": "hold-drag"
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": []
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Singleplayer in the menu, then explore the dungeon. Move with the arrow keys or WASD, press E at a lever, and use Space to fire when armed."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move",
            "bindings": [
              {
                "keys": [
                  "Up"
                ]
              },
              {
                "keys": [
                  "Down"
                ]
              },
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              },
              {
                "keys": [
                  "W"
                ]
              },
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "S"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Fire",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ],
            "note": "Requires ammo."
          },
          {
            "action": "Use lever",
            "bindings": [
              {
                "keys": [
                  "E"
                ]
              }
            ],
            "note": "When standing next to a lever."
          },
          {
            "action": "Pause",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Move pointer",
            "bindings": [
              {
                "label": "Move the mouse or drag"
              }
            ]
          },
          {
            "action": "Select menu item",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          },
          {
            "action": "Pull lever",
            "bindings": [
              {
                "label": "Hold left click and drag right"
              }
            ],
            "note": "Start on the lever and drag until it opens."
          }
        ]
      }
    ]
  }
}
