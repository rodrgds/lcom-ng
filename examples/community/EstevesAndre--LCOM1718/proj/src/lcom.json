{
  "version": 1,
  "name": "Avoid It",
  "description": "Guide a green runner along the diagonal track and dodge approaching obstacles.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "layout": "overlay",
      "pointer": "move",
      "toolbar": "top-right",
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad",
          "axes": "horizontal"
        }
      ],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ],
      "joystick": false,
      "repeatKeys": [
        "A",
        "D"
      ]
    }
  },
  "build": {
    "assetRoot": "../..",
    "assets": [
      "proj/src/high_score.txt"
    ],
    "pathAliases": {
      "/home/lcom/proj": "proj"
    }
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Start Game to begin. Guide the green runner along the diagonal track and dodge the obstacles."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move along the track",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ],
            "note": "Hold a key to keep moving."
          },
          {
            "action": "End run",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Choose menu item",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          },
          {
            "action": "Open name entry",
            "bindings": [
              {
                "label": "Left click"
              }
            ],
            "note": "Click the name box on the game-over screen."
          }
        ]
      },
      {
        "title": "Menus",
        "controls": [
          {
            "action": "Finish name",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ],
            "note": "Type letters and spaces first."
          },
          {
            "action": "Delete last character",
            "bindings": [
              {
                "keys": [
                  "Backspace"
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
