{
  "version": 1,
  "name": "Gold Miner",
  "description": "Reveal hidden gold, steer the cart and lower the claw to bring treasure back to the rail.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "layout": "overlay",
      "pointer": "move",
      "toolbar": "top-right",
      "actions": [
        {
          "label": "Select / Reveal",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ],
      "pads": [
        {
          "mode": "wasd",
          "side": "left",
          "style": "dpad"
        }
      ]
    }
  },
  "build": {
    "assetRoot": "..",
    "assets": []
  },
  "archetype": "Gold Miner",
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Singleplayer to start. Steer the cart with A and D, lower the claw with S, and reveal buried stones with a click."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Steer cart",
            "bindings": [
              {
                "keys": [
                  "A"
                ]
              },
              {
                "keys": [
                  "D"
                ]
              }
            ]
          },
          {
            "action": "Lower claw",
            "bindings": [
              {
                "keys": [
                  "S"
                ]
              }
            ]
          },
          {
            "action": "Raise claw",
            "bindings": [
              {
                "keys": [
                  "W"
                ]
              }
            ]
          },
          {
            "action": "End round",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Move pointer",
            "bindings": [
              {
                "label": "Move mouse or drag"
              }
            ]
          },
          {
            "action": "Reveal stone or select",
            "bindings": [
              {
                "label": "Left click or tap"
              }
            ]
          }
        ]
      }
    ]
  }
}
