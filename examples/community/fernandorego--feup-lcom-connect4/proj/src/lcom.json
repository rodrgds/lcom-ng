{
  "version": 1,
  "name": "Connect 4",
  "description": "Drop colored pieces and connect four before your opponent.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": false,
      "mouseButtons": false,
      "quickKeys": [
        "ESC"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "overlay",
      "pointer": "move",
      "toolbar": "top-right",
      "pads": [
        {
          "mode": "arrows",
          "side": "left",
          "style": "dpad",
          "axes": "horizontal"
        }
      ],
      "actions": [
        {
          "label": "Drop P1",
          "key": "SPACE",
          "position": "bottom-right"
        },
        {
          "label": "Drop P2 / Select",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ],
      "repeatKeys": [
        "LEFT",
        "RIGHT"
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "archetype": "Connect Four",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click Play to start. Player 1 drops with the arrow keys and Space; Player 2 aims with the mouse and left-clicks."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Move column",
            "bindings": [
              {
                "keys": [
                  "Left"
                ]
              },
              {
                "keys": [
                  "Right"
                ]
              }
            ]
          },
          {
            "action": "Drop piece",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ]
          },
          {
            "action": "Pause or resume",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "From the main menu, Esc quits."
          }
        ]
      },
      {
        "title": "Mouse & touch",
        "controls": [
          {
            "action": "Aim and drop piece",
            "bindings": [
              {
                "label": "Move mouse + left click"
              },
              {
                "label": "Drag and tap"
              }
            ],
            "note": "Used on Player 2's turn."
          },
          {
            "action": "Choose menu option",
            "bindings": [
              {
                "label": "Left click"
              },
              {
                "label": "Tap"
              }
            ],
            "note": "Clicks Play, rules, back or continue."
          }
        ]
      }
    ]
  }
}
