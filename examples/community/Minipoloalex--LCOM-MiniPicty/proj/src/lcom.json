{
  "version": 1,
  "name": "MiniPicty",
  "description": "Draw on the original MiniPicty canvas in standalone mode.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "overlay",
      "pointer": "drag",
      "toolbar": "top-right",
      "pads": [],
      "actions": [
        {
          "label": "Select / Draw",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ]
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": [],
    "arguments": [
      "host"
    ],
    "emulateFunctionPointerCasts": true
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "archetype": "Draw & Guess",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Click PLAY to start a round. One player draws the secret word with the mouse while the other types guesses."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Submit guess",
            "bindings": [
              {
                "keys": [
                  "Enter"
                ]
              }
            ],
            "note": "Type letters and numbers to build a guess. Only the guesser can type."
          },
          {
            "action": "Delete last character",
            "bindings": [
              {
                "keys": [
                  "Backspace"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Draw",
            "bindings": [
              {
                "label": "Hold left click + drag"
              }
            ],
            "note": "Keep holding while moving to draw a stroke."
          },
          {
            "action": "Choose a tool or color",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
