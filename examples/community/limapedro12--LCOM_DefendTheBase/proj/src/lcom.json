{
  "version": 1,
  "name": "Defend the Base",
  "description": "Build defenses against the original enemy waves.",
  "mobile": {
    "orientation": "landscape",
    "fullscreen": true,
    "controls": {
      "keyboard": true,
      "mouseButtons": false,
      "quickKeys": [
        "ESC",
        "ENTER",
        "SPACE",
        "P",
        "U"
      ],
      "joystick": false,
      "dpad": false,
      "look": false,
      "layout": "panel",
      "pointer": "drag",
      "toolbar": "top-right",
      "pads": [],
      "actions": [
        {
          "label": "Select",
          "mouseButton": "left",
          "position": "bottom-right"
        }
      ],
      "tapDuration": 65
    }
  },
  "build": {
    "assetRoot": ".",
    "assets": []
  },
  "icon": "icon.png",
  "preview": "preview.png",
  "instructions":   {
    "sections": [
      {
        "title": "Get started",
        "text": "Press Enter or click Start. Place towers near the road and press Space to begin each enemy wave."
      },
      {
        "title": "Keyboard",
        "controls": [
          {
            "action": "Start wave",
            "bindings": [
              {
                "keys": [
                  "Space"
                ]
              }
            ]
          },
          {
            "action": "Place tower",
            "bindings": [
              {
                "keys": [
                  "P"
                ]
              }
            ],
            "note": "Point at a free tile near the road."
          },
          {
            "action": "Upgrade tower",
            "bindings": [
              {
                "keys": [
                  "U"
                ]
              }
            ],
            "note": "Point at a placed tower."
          },
          {
            "action": "Back or quit",
            "bindings": [
              {
                "keys": [
                  "Esc"
                ]
              }
            ],
            "note": "Returns to the menu during play; quits from the menu."
          }
        ]
      },
      {
        "title": "Mouse",
        "controls": [
          {
            "action": "Drag tower",
            "bindings": [
              {
                "label": "Hold left click and move"
              }
            ],
            "note": "Repositions a placed tower."
          },
          {
            "action": "Choose menu item",
            "bindings": [
              {
                "label": "Left click"
              }
            ]
          }
        ]
      }
    ]
  }
}
