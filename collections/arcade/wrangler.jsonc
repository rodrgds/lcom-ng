{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lcom-arcade",
  "main": "worker.js",
  "account_id": "1e84f0262ece6e76da6df50801960036",
  "compatibility_date": "2026-10-15",
  "workers_dev": false,
  "routes": [{ "pattern": "arcade.rgo.pt", "custom_domain": true }],
  "assets": {
    "directory": "../../build/arcade-publish",
    "binding": "ASSETS",
    "run_worker_first": ["/games/*/game.wasm"],
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true, "traces": { "enabled": true } }
}
