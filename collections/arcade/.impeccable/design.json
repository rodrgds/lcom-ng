  "components": [
    {
      "name": "Identity tile",
      "kind": "nav",
      "refersTo": "identity-tile",
      "description": "The collection mark and actual h1 occupy one ordinary square tile.",
      "html": "<a class=\"ds-identity\" href=\"#\" aria-label=\"LCOM Arcade home\"><svg aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><rect x=\"2\" y=\"2\" width=\"60\" height=\"60\" rx=\"18\" fill=\"#c5ff62\"/><path d=\"M17 18v28h15v-8h-7V18z\" fill=\"#17182c\"/><path d=\"m36 18 16 14-16 14v-9l6-5-6-5z\" fill=\"#17182c\"/><circle cx=\"18\" cy=\"13\" r=\"3\" fill=\"#17182c\"/></svg><h1>LCOM Arcade</h1></a>",
      "css": ".ds-identity{font-family:Bricolage,system-ui,sans-serif;display:flex;flex-direction:column;justify-content:space-between;align-items:flex-start;width:168px;height:168px;padding:16px;border-radius:16px;background:var(--accent,#c5ff62);color:#17182c;text-decoration:none;container-type:inline-size}.ds-identity svg{width:36px;height:36px;transition:transform .4s cubic-bezier(.16,1,.3,1)}.ds-identity h1{font-size:clamp(25px,26cqw,48px);font-weight:800;letter-spacing:-.035em;line-height:.94;margin:0;text-wrap:balance}.ds-identity:hover svg{transform:rotate(-12deg) translateX(3px)}.ds-identity:focus-visible{outline:3px solid var(--accent,#c5ff62);outline-offset:4px}"
    },
    {
      "name": "Search tile",
      "kind": "button",
      "refersTo": "search-tile",
      "description": "A utility inside the mosaic; the live Search control opens a native dialog.",
      "html": "<button class=\"ds-search-tile\" type=\"button\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"/><path d=\"m15.5 15.5 5 5\"/></svg><span>Search</span></button>",
      "css": ".ds-search-tile{font-family:Bricolage,system-ui,sans-serif;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;width:78px;height:78px;border:0;border-radius:16px;background:#7359af;color:#fff;font-size:12px;font-weight:650;cursor:pointer;transition:background .2s,transform .25s cubic-bezier(.16,1,.3,1)}.ds-search-tile svg{width:26px;height:26px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;transition:transform .3s cubic-bezier(.16,1,.3,1)}.ds-search-tile:hover{background:#8066ba}.ds-search-tile:hover svg{transform:scale(1.14)}.ds-search-tile:focus-visible{outline:3px solid var(--accent,#c5ff62);outline-offset:4px}"
    },
    {
      "name": "Full screen tile",
      "kind": "button",
      "refersTo": "utility-tile",
      "description": "A utility inside the mosaic.",
      "html": "<button class=\"ds-utility-tile\" type=\"button\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5\"/></svg><span>Full screen</span></button>",
      "css": ".ds-utility-tile{font-family:Bricolage,system-ui,sans-serif;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;width:78px;height:78px;border:0;border-radius:16px;background:#30294a;color:#fff8ed;font-size:12px;font-weight:650;cursor:pointer;transition:background .2s,transform .25s cubic-bezier(.16,1,.3,1)}.ds-utility-tile svg{width:26px;height:26px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;transition:transform .3s cubic-bezier(.16,1,.3,1)}.ds-utility-tile:hover{background:#463b68}.ds-utility-tile:hover svg{transform:scale(1.14)}.ds-utility-tile:focus-visible{outline:3px solid var(--accent,#c5ff62);outline-offset:4px}"
    },
    {
      "name": "Shuffle tile",
      "kind": "button",
      "refersTo": "shuffle-tile",
      "description": "A utility inside the mosaic.",
      "html": "<button class=\"ds-shuffle-tile\" type=\"button\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 6h3c5 0 7 12 12 12h3m-4-4 4 4-4 4M3 18h3c2 0 3.5-2 5-5m2-3c1.5-2.5 3-4 5-4h3m-4-4 4 4-4 4\"/></svg><span>Shuffle</span></button>",
      "css": ".ds-shuffle-tile{font-family:Bricolage,system-ui,sans-serif;display:flex;flex-direction:row;align-items:center;justify-content:center;gap:8px;width:168px;height:78px;border:0;border-radius:16px;background:#27243b;color:#fff8ed;font-size:14px;font-weight:650;cursor:pointer;transition:background .2s,transform .25s cubic-bezier(.16,1,.3,1)}.ds-shuffle-tile svg{width:26px;height:26px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;transition:transform .3s cubic-bezier(.16,1,.3,1)}.ds-shuffle-tile:hover{background:#39324f}.ds-shuffle-tile:hover svg{transform:scale(1.14)}.ds-shuffle-tile:focus-visible{outline:3px solid var(--accent,#c5ff62);outline-offset:4px}.ds-shuffle-tile:active svg{transform:rotate(180deg)}"
    },
    {
      "name": "Search field",
      "kind": "input",
      "refersTo": "search-field",
      "description": "The modal search field uses an inset surface and a focus-within outline.",
      "html": "<label class=\"ds-search\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"/><path d=\"m15.5 15.5 5 5\"/></svg><input type=\"search\" aria-label=\"Find a game\" placeholder=\"Search games…\"></label>",
      "css": ".ds-search{font-family:Bricolage,system-ui,sans-serif;display:flex;align-items:center;gap:12px;background:#111022;border-radius:12px;padding:0 14px;color:#bcb9d5;width:min(100%,420px)}.ds-search svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.8}.ds-search input{font-family:Bricolage,system-ui,sans-serif;width:100%;min-width:0;height:54px;background:none;color:#fff8ed;border:0;font-size:17px;caret-color:var(--accent,#c5ff62)}.ds-search input::placeholder{color:#bcb9d5}.ds-search input:focus-visible{outline:0}.ds-search:focus-within{outline:2px solid var(--accent,#c5ff62);outline-offset:2px}"
    },
    {
      "name": "Game icon fallback",
      "kind": "card",
      "refersTo": "game-card",
      "description": "Artwork-unavailable fallback. Production tiles use original game icons, then real gameplay frames on hover or focus.",
      "html": "<a class=\"ds-game\" href=\"#\" aria-label=\"Play game\"><svg aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\"><rect x=\"2\" y=\"2\" width=\"60\" height=\"60\" rx=\"18\" fill=\"#c5ff62\"/><path d=\"M17 18v28h15v-8h-7V18z\" fill=\"#17182c\"/><path d=\"m36 18 16 14-16 14v-9l6-5-6-5z\" fill=\"#17182c\"/><circle cx=\"18\" cy=\"13\" r=\"3\" fill=\"#17182c\"/></svg></a>",
      "css": ".ds-game{display:block;width:168px;height:168px;overflow:hidden;border-radius:16px;background:#242437;transition:box-shadow .32s cubic-bezier(.16,1,.3,1)}.ds-game svg{display:block;width:100%;height:100%}.ds-game:hover{box-shadow:0 18px 38px -10px #000b}.ds-game:focus-visible{outline:3px solid var(--accent,#c5ff62);outline-offset:4px}@media(max-width:600px){.ds-game{border-radius:13px}}"
    },
    {
      "name": "Retry action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Failure action shown in place of transfer progress.",
      "html": "<button class=\"ds-button-primary\" type=\"button\">Try again</button>",
      "css": ".ds-button-primary{font-family:Bricolage,system-ui,sans-serif;min-height:44px;padding:10px 16px;border:0;border-radius:10px;font-weight:700;background:var(--accent,#c5ff62);color:#101021;cursor:pointer}.ds-button-primary:focus-visible{outline:3px solid var(--accent,#c5ff62);outline-offset:4px}"
    },
    {
      "name": "Return action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Failure action shown in place of transfer progress.",
      "html": "<button class=\"ds-button-secondary\" type=\"button\">Back to games</button>",
      "css": ".ds-button-secondary{font-family:Bricolage,system-ui,sans-serif;min-height:44px;padding:10px 16px;border:0;border-radius:10px;font-weight:700;background:#302b48;color:#fff8ed;cursor:pointer}.ds-button-secondary:focus-visible{outline:3px solid var(--accent,#c5ff62);outline-offset:4px}"
    }
  ],
  "narrative": {
    "northStar": "The game art is the arcade",
    "overview": "Original square icons supply the color and identity of a dense, screen-filling\nmosaic. Ink-violet, warm Bricolage lettering and the acid-lime identity tile frame\nthe games. Hover or keyboard focus opens a wider window into real gameplay.\nThe user's CrazyGames and Poki references establish this direction.\n\nThis system covers the web library and startup screen in\nsdk/collection/web-template/. Native Android keeps its independent black, white\nand mint palette, adaptive compact launcher and platform controls. Original games\nretain their own art, type and control themes.",
    "keyCharacteristics": [
      "Original square game icons at rest.",
      "Identity and compact tools belong to the mosaic.",
      "Captured gameplay and metadata appear on hover or keyboard focus.",
      "Neutral preview depth, with no colorful library glow.",
      "Real transfer progress followed by the first presented frame."
    ],
    "rules": [
      {
        "name": "Artwork",
